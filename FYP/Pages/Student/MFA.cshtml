@page
@model FYP.Pages.Student.MFAModel
@{
    ViewData["Title"] = "Security Verification";
    Layout = "_StudentAuthLayout";
}

<div class="mb-8 text-center">
    <div class="mx-auto w-16 h-16 bg-blue-900/30 border border-blue-500/30 rounded-full flex items-center justify-center mb-4 text-blue-400 animate-pulse">
        <i class="fa-solid fa-shield-halved text-3xl"></i>
    </div>
    <h2 class="text-3xl font-extrabold text-white tracking-tight">Security Check</h2>
    <p class="mt-2 text-sm text-slate-400">
        We sent a 6-digit code to
        <span class="font-mono text-blue-300 font-medium">@Model.MaskedEmail</span>.<br>
        Enter it below to verify your identity.
    </p>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="mb-6 rounded-lg bg-red-900/30 p-4 border-l-4 border-red-500 flex items-center">
        <i class="fa-solid fa-circle-xmark text-red-500 mr-3 text-lg"></i>
        <span class="text-sm font-medium text-red-200">@Model.ErrorMessage</span>
    </div>
}

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="mb-6 rounded-lg bg-green-900/30 p-4 border-l-4 border-green-500 flex items-center animate-fade-in-up">
        <i class="fa-solid fa-circle-check text-green-500 mr-3 text-lg"></i>
        <span class="text-sm font-medium text-green-200">@Model.SuccessMessage</span>
    </div>
}

<form method="post" asp-page-handler="" class="space-y-6">
    <input type="hidden" asp-for="Uid" />

    <div>
        <label asp-for="OtpCode" class="sr-only">Verification Code</label>
        <div class="relative">
            <input asp-for="OtpCode" type="text" maxlength="6" required autocomplete="off"
                   class="block w-full text-center text-4xl font-mono font-bold tracking-[0.5em] py-4 bg-slate-800 border-2 border-slate-700 rounded-xl text-white placeholder-slate-600 focus:border-blue-500 focus:ring-0 focus:outline-none transition-all"
                   placeholder="000000" />
        </div>
        <p class="mt-3 text-center text-xs text-slate-500">
            Make sure to check your Spam/Junk folder.
        </p>
    </div>

    <button type="submit" asp-page-handler=""
            class="w-full flex justify-center py-3.5 px-4 border border-transparent rounded-xl shadow-lg shadow-blue-900/50 text-sm font-bold text-white bg-blue-600 hover:bg-blue-500 hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-slate-900 focus:ring-blue-500 transition-all duration-200">
        Verify Identity
        <i class="fa-solid fa-check ml-2 mt-0.5"></i>
    </button>
</form>

<div class="mt-8 text-center">
    <div class="text-sm text-slate-500 flex justify-center items-center gap-1">
        Didn't receive the code?
        <form method="post" asp-page-handler="Resend" class="inline">
            <input type="hidden" asp-for="Uid" />
            <button id="resendBtn" type="submit" class="font-medium text-blue-400 hover:text-blue-300 hover:underline transition-colors bg-transparent border-none cursor-pointer p-0 disabled:opacity-50 disabled:cursor-not-allowed">
                <span id="resendText">Resend Email</span>
            </button>
        </form>
    </div>

    <div class="mt-6">
        <a asp-page="/Student/Login" class="text-xs font-medium text-slate-400 hover:text-white flex items-center justify-center transition-colors">
            <i class="fa-solid fa-arrow-left mr-1.5"></i> Back to Login
        </a>
    </div>
</div>

@section Scripts {
    <script>
        function startResendTimer(duration) {
            var btn = document.getElementById("resendBtn");
            var text = document.getElementById("resendText");
            var timer = duration;

            btn.disabled = true;
            text.innerText = "Resend in " + timer + "s";

            var interval = setInterval(function () {
                timer--;
                text.innerText = "Resend in " + timer + "s";

                if (timer <= 0) {
                    clearInterval(interval);
                    btn.disabled = false;
                    text.innerText = "Resend Email";
                }
            }, 1000);
        }

        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
                <text>
                document.addEventListener("DOMContentLoaded", function() {
                    startResendTimer(60);
                });
                </text>
        }
    </script>
}