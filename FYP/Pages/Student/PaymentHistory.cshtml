@page
@model FYP.Pages.Student.PaymentHistoryModel
@{
    Layout = "_StudentLayout";
    ViewData["Title"] = "Payment History";
}

<div class="space-y-6 animate-fade-in-up">

    <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-4 border-b border-purple-500/20 pb-6">
        <div>
            <h1 class="text-3xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-white to-fuchsia-300 tracking-tight">Payment History</h1>
            <p class="text-sm text-purple-300/70 mt-2">View your past transactions and download official receipts.</p>
        </div>
        <div class="bg-purple-900/30 border border-emerald-500/30 px-4 py-2 rounded-xl backdrop-blur-md flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-emerald-500/20 flex items-center justify-center text-emerald-400">
                <i class="fa-solid fa-check-double"></i>
            </div>
            <div>
                <span class="text-xs text-purple-200 block uppercase tracking-wider">Total Paid</span>
                <span class="text-lg font-bold text-emerald-400">RM @Model.TotalAmountPaid.ToString("0.00")</span>
            </div>
        </div>
    </div>

    <div class="bg-purple-950/40 backdrop-blur-xl border border-purple-500/20 rounded-2xl shadow-[0_4px_20px_-5px_rgba(88,28,135,0.3)] overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left">
                <thead class="bg-black/40 text-purple-300/70 border-b border-purple-500/20">
                    <tr>
                        <th class="px-6 py-4 font-bold uppercase tracking-wider text-xs">Receipt No</th>
                        <th class="px-6 py-4 font-bold uppercase tracking-wider text-xs">Payment Date</th>
                        <th class="px-6 py-4 font-bold uppercase tracking-wider text-xs">Bill Details</th>
                        <th class="px-6 py-4 font-bold uppercase tracking-wider text-xs">Method</th>
                        <th class="px-6 py-4 font-bold uppercase tracking-wider text-xs">Amount Paid</th>
                        <th class="px-6 py-4 font-bold uppercase tracking-wider text-xs text-center">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-purple-500/10">

                    @if (Model.Transactions.Any())
                    {
                        foreach (var txn in Model.Transactions)
                        {
                            <tr class="hover:bg-white/5 transition-colors group">
                                <td class="px-6 py-4">
                                    <div class="font-bold text-fuchsia-300 font-mono">@txn.PaymentNumber</div>
                                </td>

                                <td class="px-6 py-4 text-purple-200">
                                    @txn.PaymentDate.ToString("dd MMM yyyy")
                                    <div class="text-xs text-purple-400/70 mt-0.5">@txn.PaymentDate.ToString("hh:mm tt")</div>
                                </td>

                                <td class="px-6 py-4">
                                    <div class="font-bold text-white">@txn.Bill.Title</div>
                                    <div class="text-xs text-purple-400 font-mono mt-0.5">Ref: @txn.Bill.ReferenceNo</div>
                                </td>

                                <td class="px-6 py-4 text-purple-300 text-xs">
                                    <span class="px-2 py-1 bg-purple-900/50 rounded-md border border-purple-500/30 inline-flex items-center gap-1.5">
                                        <i class="fa-regular fa-credit-card"></i> @txn.Method
                                    </span>
                                </td>

                                <td class="px-6 py-4 font-bold text-emerald-400">
                                    RM @txn.Amount.ToString("0.00")
                                </td>

                                <td class="px-6 py-4 text-center">
                                    <div class="flex items-center justify-center gap-2">
                                        <button onclick="openDetailModal('@txn.PaymentNumber', '@txn.PaymentDate.ToString("dd MMM yyyy, hh:mm tt")', '@txn.Bill.Title.Replace("'", "\\'")', '@txn.Bill.ReferenceNo', '@txn.Method', '@txn.Amount.ToString("0.00")')"
                                                class="w-8 h-8 rounded-lg bg-purple-900/40 text-purple-300 hover:bg-fuchsia-600 hover:text-white border border-purple-500/30 hover:border-fuchsia-500 transition-all flex items-center justify-center"
                                                title="View Quick Details">
                                            <i class="fa-solid fa-eye text-xs"></i>
                                        </button>

                                        <a href="/Student/PaymentSuccess?txnId=@txn.Id"
                                           class="w-8 h-8 rounded-lg bg-purple-900/40 text-purple-300 hover:bg-emerald-600 hover:text-white border border-purple-500/30 hover:border-emerald-500 transition-all flex items-center justify-center"
                                           title="Print Official Receipt">
                                            <i class="fa-solid fa-print text-xs"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="px-6 py-16 text-center">
                                <div class="w-16 h-16 rounded-full bg-purple-900/20 border border-purple-500/20 flex items-center justify-center text-purple-500 mx-auto mb-4">
                                    <i class="fa-solid fa-folder-open text-2xl"></i>
                                </div>
                                <h3 class="text-lg font-bold text-purple-200">No Payment History</h3>
                                <p class="text-sm text-purple-400/70 mt-1">You haven't made any payments yet.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div id="detailModal" class="hidden fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 transition-opacity">
    <div class="bg-purple-950/90 border border-fuchsia-500/30 rounded-2xl shadow-[0_0_50px_rgba(217,70,239,0.2)] max-w-md w-full overflow-hidden transform transition-all">

        <div class="px-6 py-4 border-b border-purple-500/20 flex justify-between items-center bg-black/20">
            <h3 class="text-lg font-bold text-fuchsia-300 flex items-center gap-2">
                <i class="fa-solid fa-receipt"></i> Transaction Details
            </h3>
            <button onclick="closeDetailModal()" class="text-purple-400 hover:text-white transition-colors">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>
        </div>

        <div class="p-6 space-y-4">
            <div class="flex justify-between items-center border-b border-purple-500/20 pb-3">
                <span class="text-xs text-purple-400/70 uppercase tracking-wider font-bold">Receipt No</span>
                <span id="modalReceiptNo" class="font-mono font-bold text-fuchsia-300"></span>
            </div>

            <div class="flex justify-between items-center border-b border-purple-500/20 pb-3">
                <span class="text-xs text-purple-400/70 uppercase tracking-wider font-bold">Date & Time</span>
                <span id="modalDate" class="text-sm text-purple-200"></span>
            </div>

            <div class="flex flex-col gap-1 border-b border-purple-500/20 pb-3">
                <span class="text-xs text-purple-400/70 uppercase tracking-wider font-bold">Bill Title</span>
                <span id="modalBillTitle" class="text-sm font-bold text-white"></span>
                <span id="modalBillRef" class="text-xs font-mono text-purple-400"></span>
            </div>

            <div class="flex justify-between items-center border-b border-purple-500/20 pb-3">
                <span class="text-xs text-purple-400/70 uppercase tracking-wider font-bold">Method</span>
                <span id="modalMethod" class="text-sm text-purple-200"></span>
            </div>

            <div class="flex justify-between items-center bg-black/30 p-4 rounded-xl border border-emerald-500/20 mt-2">
                <span class="text-sm text-emerald-400/80 uppercase tracking-wider font-bold">Total Paid</span>
                <span class="text-2xl font-bold text-emerald-400">RM <span id="modalAmount"></span></span>
            </div>
        </div>

        <div class="px-6 py-4 border-t border-purple-500/20 bg-black/20 flex justify-end">
            <button onclick="closeDetailModal()" class="py-2.5 px-6 bg-purple-900/40 hover:bg-purple-800/60 text-purple-200 font-semibold rounded-xl border border-purple-500/30 transition-colors">
                Close
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openDetailModal(receiptNo, date, billTitle, billRef, method, amount) {
            document.getElementById('modalReceiptNo').textContent = receiptNo;
            document.getElementById('modalDate').textContent = date;
            document.getElementById('modalBillTitle').textContent = billTitle;
            document.getElementById('modalBillRef').textContent = 'Ref: ' + billRef;
            document.getElementById('modalMethod').textContent = method;
            document.getElementById('modalAmount').textContent = amount;

            document.getElementById('detailModal').classList.remove('hidden');
        }

        function closeDetailModal() {
            document.getElementById('detailModal').classList.add('hidden');
        }
    </script>
}