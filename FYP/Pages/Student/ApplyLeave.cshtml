@page
@model FYP.Pages.Student.ApplyLeaveModel
@{
    Layout = "_StudentLayout";
    ViewData["Title"] = "Apply Leave";

    // Date restrictions setup
    string minDate = DateTime.Now.AddDays(-7).ToString("yyyy-MM-dd");
    string maxDate = DateTime.Now.AddYears(1).ToString("yyyy-MM-dd");
}

<div class="max-w-4xl mx-auto py-8">

    <div class="mb-8 p-8 bg-gradient-to-r from-purple-900/40 to-fuchsia-900/20 border border-purple-500/30 rounded-3xl shadow-[0_0_30px_rgba(168,85,247,0.15)] backdrop-blur-md">
        <h2 class="text-3xl font-extrabold tracking-tight text-white mb-2">Request Leave</h2>
        <p class="text-purple-300">Submit your leave applications and supporting documents.</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mb-6 p-4 bg-green-500/10 border border-green-500/50 text-green-400 rounded-xl flex items-center gap-3 shadow-[0_0_15px_rgba(34,197,94,0.2)]">
            <i class="fa-solid fa-circle-check"></i>
            <span class="font-semibold">@TempData["SuccessMessage"]</span>
        </div>
    }

    <div class="bg-black/30 rounded-2xl border border-purple-500/20 p-6 mb-8 flex flex-col md:flex-row justify-between items-center gap-4">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-purple-900/50 border border-purple-500/30 rounded-full flex items-center justify-center text-fuchsia-400">
                <i class="fa-solid fa-user-graduate text-xl"></i>
            </div>
            <div>
                <p class="text-xs font-bold text-purple-400 uppercase tracking-widest">Applicant Profile</p>
                <h3 class="text-lg font-bold text-white">@(Model.CurrentStudent?.FullName ?? "Unknown User")</h3>
                <p class="text-sm text-purple-300">ID: @(Model.CurrentStudent?.UserId?.ToString() ?? "N/A")</p>
            </div>
        </div>

        <div class="text-center md:text-right">
            <p class="text-xs font-bold text-purple-400 uppercase tracking-widest mb-1">Annual Quota Remaining</p>
            <div class="flex items-end justify-center md:justify-end gap-1">
                <span class="text-3xl font-extrabold @(Model.IsQuotaExceeded ? "text-red-400" : "text-fuchsia-400")">
                    @(12 - Model.LeavesTakenThisYear)
                </span>
                <span class="text-purple-300 mb-1">/ 12 Uses</span>
            </div>
        </div>
    </div>

    <div class="bg-purple-950/40 rounded-3xl border border-purple-500/20 overflow-hidden shadow-[0_0_30px_rgba(88,28,135,0.3)] backdrop-blur-xl">

        @if (Model.IsQuotaExceeded)
        {
            <div class="p-12 text-center">
                <i class="fa-solid fa-ban text-6xl text-red-500/50 mb-4"></i>
                <h3 class="text-2xl font-bold text-red-400 mb-2">Leave Quota Exceeded</h3>
                <p class="text-purple-300 max-w-lg mx-auto">You have used all 12 of your approved leave requests for this account year. Please contact the administration if you have an emergency requiring additional absence.</p>
            </div>
        }
        else
        {
            <form method="post" enctype="multipart/form-data" class="p-8 space-y-6">
                <div asp-validation-summary="ModelOnly" class="p-4 bg-red-500/10 border border-red-500/50 text-red-400 rounded-xl text-sm"></div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label asp-for="NewLeave.StartDate" class="block text-sm font-bold text-purple-300 mb-2">Start Date</label>
                        <input type="date" asp-for="NewLeave.StartDate" min="@minDate" max="@maxDate" class="w-full px-4 py-3 bg-black/40 border border-purple-500/30 text-white rounded-xl focus:outline-none focus:border-fuchsia-500 focus:ring-1 focus:ring-fuchsia-500 transition-all custom-date-picker" required />
                        <span asp-validation-for="NewLeave.StartDate" class="text-red-400 text-xs mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="NewLeave.EndDate" class="block text-sm font-bold text-purple-300 mb-2">End Date</label>
                        <input type="date" asp-for="NewLeave.EndDate" min="@minDate" max="@maxDate" class="w-full px-4 py-3 bg-black/40 border border-purple-500/30 text-white rounded-xl focus:outline-none focus:border-fuchsia-500 focus:ring-1 focus:ring-fuchsia-500 transition-all custom-date-picker" required />
                        <span asp-validation-for="NewLeave.EndDate" class="text-red-400 text-xs mt-1 block"></span>
                    </div>
                </div>

                <div>
                    <label asp-for="NewLeave.LeaveType" class="block text-sm font-bold text-purple-300 mb-2">Leave Category</label>
                    <select asp-for="NewLeave.LeaveType" class="w-full px-4 py-3 bg-black/40 border border-purple-500/30 text-white rounded-xl focus:outline-none focus:border-fuchsia-500 focus:ring-1 focus:ring-fuchsia-500 transition-all" required>
                        <option value="">-- Select Category --</option>
                        <option value="Medical">Medical / Sick Leave</option>
                        <option value="Personal">Personal Emergency</option>
                        <option value="Event">University Event / Competition</option>
                        <option value="Other">Other</option>
                    </select>
                </div>

                <div>
                    <label asp-for="NewLeave.Reason" class="block text-sm font-bold text-purple-300 mb-2">Reason</label>
                    <textarea asp-for="NewLeave.Reason" rows="3" class="w-full px-4 py-3 bg-black/40 border border-purple-500/30 text-white rounded-xl focus:outline-none focus:border-fuchsia-500 focus:ring-1 focus:ring-fuchsia-500 transition-all" placeholder="Provide a brief explanation..."></textarea>
                    <span asp-validation-for="NewLeave.Reason" class="text-red-400 text-xs mt-1 block"></span>
                </div>

                <div class="p-5 border border-dashed border-purple-500/40 rounded-xl bg-purple-900/10 hover:bg-purple-900/20 transition-colors">
                    <label class="block text-sm font-bold text-purple-300 mb-2">Supporting Document (Optional)</label>
                    <input type="file" asp-for="UploadedDocument" accept=".pdf, .png, .jpg, .jpeg" class="block w-full text-sm text-purple-400 file:mr-4 file:py-2.5 file:px-5 file:rounded-xl file:border-0 file:text-sm file:font-bold file:bg-purple-900/40 file:text-fuchsia-300 hover:file:bg-purple-900/60 transition-all cursor-pointer" />
                    <p class="text-xs text-purple-500/70 mt-2">Accepted formats: PDF, PNG, JPG.</p>
                    <span asp-validation-for="UploadedDocument" class="text-red-400 text-xs mt-1 block"></span>
                </div>

                <div class="pt-6 border-t border-purple-500/20 flex justify-end">
                    <button type="submit" class="px-8 py-3 bg-gradient-to-r from-fuchsia-600 to-purple-600 hover:from-fuchsia-500 hover:to-purple-500 text-white font-bold rounded-xl shadow-[0_0_15px_rgba(217,70,239,0.4)] hover:shadow-[0_0_25px_rgba(217,70,239,0.6)] transition-all flex items-center gap-2">
                        <i class="fa-solid fa-paper-plane"></i> Submit Application
                    </button>
                </div>
            </form>
        }
    </div>
</div>

<style>
    /* Inverts calendar icon for dark mode */
    .custom-date-picker::-webkit-calendar-picker-indicator {
        filter: invert(1) sepia(100%) saturate(1000%) hue-rotate(240deg);
        cursor: pointer;
    }
</style>