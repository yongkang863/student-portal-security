@page
@model FYP.Pages.Student.ForceChangePasswordModel
@{
    ViewData["Title"] = "Required: Change Password";
    Layout = "_StudentAuthLayout";
}

<div class="mb-8 text-center">
    <div class="mx-auto w-16 h-16 bg-blue-900/30 border border-blue-500/30 rounded-full flex items-center justify-center mb-4 text-blue-400">
        <i class="fa-solid fa-key text-3xl"></i>
    </div>
    <h2 class="text-3xl font-extrabold text-white tracking-tight">Action Required</h2>
    <p class="mt-2 text-sm text-slate-400">
        Since this is your first time logging in, you must change your default password to continue.
    </p>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="mb-6 rounded-lg bg-red-900/30 p-4 border-l-4 border-red-500 flex items-center">
        <i class="fa-solid fa-circle-xmark text-red-500 mr-3 text-lg"></i>
        <span class="text-sm font-medium text-red-200">@Model.ErrorMessage</span>
    </div>
}

<form method="post" class="space-y-6">
    <input type="hidden" asp-for="Uid" />

    <div>
        <label asp-for="CurrentPassword" class="block text-sm font-medium text-slate-300 mb-1.5">Current Password</label>
        <div class="relative group">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <i class="fa-solid fa-unlock-keyhole text-slate-500 group-focus-within:text-blue-400 transition-colors"></i>
            </div>
            <input asp-for="CurrentPassword" type="password" required
                   class="block w-full pl-10 pr-3 py-3 bg-slate-900 border border-slate-800 rounded-xl text-white placeholder-slate-600 focus:outline-none focus:ring-2 focus:ring-blue-500/50 focus:border-blue-500 transition-all sm:text-sm"
                   placeholder="Enter your current password" />
        </div>
    </div>

    <div>
        <label asp-for="NewPassword" class="block text-sm font-medium text-slate-300 mb-1.5">New Password</label>
        <div class="relative group">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <i class="fa-solid fa-lock text-slate-500 group-focus-within:text-blue-400 transition-colors"></i>
            </div>
            <input asp-for="NewPassword" type="password" required
                   class="block w-full pl-10 pr-3 py-3 bg-slate-900 border border-slate-800 rounded-xl text-white placeholder-slate-600 focus:outline-none focus:ring-2 focus:ring-blue-500/50 focus:border-blue-500 transition-all sm:text-sm"
                   placeholder="Enter new password" />
        </div>

        <div class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-slate-400 bg-slate-800/50 p-3 rounded-lg border border-slate-700">
            <div class="flex items-center"><i class="fa-solid fa-circle text-[6px] text-blue-500 mr-2"></i> 8+ characters</div>
            <div class="flex items-center"><i class="fa-solid fa-circle text-[6px] text-blue-500 mr-2"></i> Upper & Lowercase</div>
            <div class="flex items-center"><i class="fa-solid fa-circle text-[6px] text-blue-500 mr-2"></i> One Number (0-9)</div>
            <div class="flex items-center"><i class="fa-solid fa-circle text-[6px] text-blue-500 mr-2"></i> One Symbol ($#@@!)</div>
        </div>
    </div>

    <div>
        <label asp-for="ConfirmNewPassword" class="block text-sm font-medium text-slate-300 mb-1.5">Confirm New Password</label>
        <div class="relative group">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <i class="fa-solid fa-check-double text-slate-500 group-focus-within:text-blue-400 transition-colors"></i>
            </div>
            <input asp-for="ConfirmNewPassword" type="password" required
                   class="block w-full pl-10 pr-3 py-3 bg-slate-900 border border-slate-800 rounded-xl text-white placeholder-slate-600 focus:outline-none focus:ring-2 focus:ring-blue-500/50 focus:border-blue-500 transition-all sm:text-sm"
                   placeholder="Confirm new password" />
        </div>
    </div>

    <button type="submit"
            class="w-full flex justify-center py-3.5 px-4 border border-transparent rounded-xl shadow-lg shadow-blue-900/50 text-sm font-bold text-white bg-blue-600 hover:bg-blue-500 hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-slate-900 focus:ring-blue-500 transition-all duration-200">
        Update Password & Continue
        <i class="fa-solid fa-arrow-right ml-2 mt-0.5"></i>
    </button>
</form>

<div class="mt-6 text-center">
    <a asp-page="/Student/Login" class="text-xs font-medium text-slate-400 hover:text-white flex items-center justify-center transition-colors">
        <i class="fa-solid fa-arrow-left mr-1.5"></i> Cancel & Back to Login
    </a>
</div>