@page
@model FYP.Pages.Student.PaymentSuccessModel
@{
    Layout = "_StudentLayout";
    ViewData["Title"] = "Payment Information";
}

<div class="max-w-3xl mx-auto mt-10 animate-fade-in-up">

    <div class="flex justify-center sm:justify-end gap-4 mb-6">
        <a href="/Student/Homepage" class="px-5 py-2.5 bg-purple-900/40 hover:bg-purple-800/60 text-purple-200 font-semibold rounded-xl border border-purple-500/30 transition-colors flex items-center gap-2">
            <i class="fa-solid fa-house"></i> Return Home
        </a>
        <button onclick="downloadPDF()" class="px-5 py-2.5 bg-fuchsia-600 hover:bg-fuchsia-500 text-white font-bold rounded-xl shadow-[0_0_15px_rgba(217,70,239,0.4)] transition-colors flex items-center gap-2">
            <i class="fa-solid fa-file-pdf"></i> Print Receipt
        </button>
    </div>

    <div id="receipt-content" class="bg-white p-10 rounded-2xl shadow-2xl relative overflow-hidden">

        <div class="absolute top-0 left-0 w-full h-4 bg-gradient-to-r from-blue-600 to-indigo-800"></div>

        <div class="text-center mb-8 mt-4">
            <div class="w-20 h-20 mx-auto bg-green-100 rounded-full flex items-center justify-center mb-4 border-4 border-white shadow-lg">
                <i class="fa-solid fa-check text-4xl text-green-500"></i>
            </div>
            <h1 class="text-3xl font-bold text-slate-800 font-serif">Payment Successful</h1>
            <p class="text-slate-500 mt-1">Thank you! Your transaction has been approved.</p>
        </div>

        <div class="border-t border-b border-slate-200 py-6 mb-6">
            <div class="grid grid-cols-2 gap-y-4 text-sm">
                <div>
                    <p class="text-slate-500 uppercase tracking-wider text-xs font-bold mb-1">Receipt Number</p>
                    <p class="font-bold text-slate-800 font-mono">@Model.Transaction.PaymentNumber</p>
                </div>
                <div class="text-right">
                    <p class="text-slate-500 uppercase tracking-wider text-xs font-bold mb-1">Date Paid</p>
                    <p class="font-medium text-slate-800">@Model.Transaction.PaymentDate.ToString("dd MMM yyyy, hh:mm tt")</p>
                </div>
                <div>
                    <p class="text-slate-500 uppercase tracking-wider text-xs font-bold mb-1">Payment Method</p>
                    <p class="font-medium text-slate-800">@Model.Transaction.Method</p>
                </div>
                <div class="text-right">
                    <p class="text-slate-500 uppercase tracking-wider text-xs font-bold mb-1">Bill ID / Reference</p>
                    <p class="font-medium text-slate-800 font-mono">@Model.Transaction.Bill.ReferenceNo</p>
                </div>

                <div class="col-span-2 pt-3 mt-1 border-t border-slate-100">
                    <p class="text-slate-500 uppercase tracking-wider text-xs font-bold mb-1">Stripe Payment</p>
                    <p class="font-medium text-slate-800 font-mono text-xs break-all">@Model.ExtractedStripeIntentId</p>
                </div>
            </div>
        </div>

        <div class="bg-slate-50 rounded-xl p-6 border border-slate-100">
            <h3 class="text-lg font-bold text-slate-800 mb-4 border-b border-slate-200 pb-2">Payment Details</h3>

            <div class="flex justify-between items-center mb-2">
                <span class="text-slate-600 font-medium">@Model.Transaction.Bill.Title</span>
                <span class="text-slate-800 font-bold">RM @Model.Transaction.Amount.ToString("0.00")</span>
            </div>
            <div class="flex justify-between items-center text-sm">
                <span class="text-slate-500">Description: @(Model.Transaction.Bill.Description ?? "University Fees")</span>
            </div>

            <div class="flex justify-between items-center mt-6 pt-4 border-t border-slate-200">
                <span class="text-slate-800 font-bold uppercase tracking-wider">Total Paid</span>
                <span class="text-2xl font-bold text-indigo-700">RM @Model.Transaction.Amount.ToString("0.00")</span>
            </div>
        </div>

        <div class="text-center mt-10 text-xs text-slate-400">
            <p>This is a computer-generated receipt and requires no signature.</p>
            <p class="mt-1 font-serif">Ronnie University Financial Services</p>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

    <script>
        function downloadPDF() {
            const element = document.getElementById('receipt-content');
            const opt = {
                margin:       0,
                filename:     'Receipt_@Model.Transaction.PaymentNumber' + '.pdf',
                image:        { type: 'jpeg', quality: 0.98 },
                html2canvas:  { scale: 2 },
                jsPDF:        { unit: 'in', format: 'a4', orientation: 'portrait' }
            };
            html2pdf().set(opt).from(element).save();
        }
    </script>
}