@page
@model FYP.Pages.Student.UpdateBankModel
@{
    ViewData["Title"] = "Update Bank Details";
    Layout = "_StudentLayout";
}

<div class="max-w-2xl mx-auto animate-fade-in-up">
    <div class="bg-black/40 backdrop-blur-xl rounded-2xl border border-purple-500/20 p-8 shadow-[0_8px_32px_0_rgba(88,28,135,0.3)]">

        <div class="flex items-center gap-4 mb-8 border-b border-purple-500/20 pb-4">
            <div class="w-12 h-12 rounded-full bg-gradient-to-br from-violet-600 to-purple-600 flex items-center justify-center text-white shadow-lg">
                <i class="fa-solid fa-building-columns text-xl"></i>
            </div>
            <div>
                <h2 class="text-2xl font-bold text-white">Bank Details</h2>
                <p class="text-purple-300/60 text-sm">Securely update your banking information.</p>
            </div>
        </div>

        <div class="mb-6 bg-yellow-500/10 border border-yellow-500/20 p-4 rounded-xl flex items-start gap-3">
            <i class="fa-solid fa-triangle-exclamation text-yellow-500 mt-1"></i>
            <div class="text-sm text-yellow-100/80">
                <strong class="text-yellow-500 block mb-1">Security Notice</strong>
                Your bank account number will be <strong>encrypted (hashed)</strong> before storage. You will not be able to see the raw number again after saving, only the encrypted string.
            </div>
        </div>

        <form method="post" class="space-y-6">
            <div asp-validation-summary="ModelOnly" class="text-red-400 text-sm bg-red-900/20 p-3 rounded-lg border border-red-500/20"></div>

            <div class="space-y-2">
                <label asp-for="Input.BankId" class="block text-xs uppercase tracking-wider text-purple-400/70 font-semibold pl-1"></label>
                <div class="relative group">
                    <span class="absolute left-4 top-3.5 text-purple-400 group-focus-within:text-fuchsia-400 transition-colors">
                        <i class="fa-solid fa-money-check-dollar"></i>
                    </span>
                    <select asp-for="Input.BankId" asp-items="Model.BankOptions" class="w-full bg-black/20 border border-purple-500/20 rounded-xl py-3 pl-12 pr-4 text-purple-100 focus:outline-none focus:border-fuchsia-500/50 focus:ring-1 focus:ring-fuchsia-500/50 transition-all appearance-none cursor-pointer">
                        <option value="">-- Select Your Bank --</option>
                    </select>
                    <span class="absolute right-4 top-3.5 text-purple-500 pointer-events-none">
                        <i class="fa-solid fa-chevron-down text-xs"></i>
                    </span>
                </div>
                <span asp-validation-for="Input.BankId" class="text-red-400 text-xs pl-1"></span>
            </div>

            <div class="space-y-2">
                <label asp-for="Input.BankAccNo" class="block text-xs uppercase tracking-wider text-purple-400/70 font-semibold pl-1"></label>
                <div class="relative group">
                    <span class="absolute left-4 top-3.5 text-purple-400 group-focus-within:text-fuchsia-400 transition-colors">
                        <i class="fa-solid fa-hashtag"></i>
                    </span>
                    <input asp-for="Input.BankAccNo" oninput="this.value = this.value.replace(/[^0-9]/g, '');" maxlength="10" class="w-full bg-black/20 border border-purple-500/20 rounded-xl py-3 pl-12 pr-4 text-purple-100 placeholder-purple-500/30 focus:outline-none focus:border-fuchsia-500/50 focus:ring-1 focus:ring-fuchsia-500/50 transition-all font-mono" placeholder="Enter 10-digit Account Number" />
                </div>
                <div class="flex justify-between px-1">
                    <span asp-validation-for="Input.BankAccNo" class="text-red-400 text-xs"></span>
                    <span class="text-xs text-purple-500/50">10 digits</span>
                </div>
            </div>

            <div class="pt-4 flex gap-4">
                <a asp-page="/Student/Profile" class="flex-1 py-3 bg-purple-900/20 border border-purple-500/20 text-purple-300 rounded-xl text-center font-semibold hover:bg-purple-900/40 transition-all">Cancel</a>
                <button type="submit" class="flex-1 py-3 bg-gradient-to-r from-violet-600 to-purple-600 text-white rounded-xl font-semibold shadow-[0_0_15px_rgba(124,58,237,0.4)] hover:shadow-[0_0_25px_rgba(124,58,237,0.6)] hover:scale-[1.02] transition-all">
                    Update securely
                </button>
            </div>
        </form>
    </div>
</div>