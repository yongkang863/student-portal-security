@page
@model FYP.Pages.Student.ResetPasswordModel
@{
    ViewData["Title"] = "Create New Password";
    Layout = "_StudentAuthLayout";
}

@if (!Model.IsTokenValid)
{
    <div class="text-center">
        <div class="mx-auto w-16 h-16 bg-red-900/30 rounded-full flex items-center justify-center mb-4 text-red-500">
            <i class="fa-solid fa-link-slash text-2xl"></i>
        </div>
        <h2 class="text-2xl font-bold text-white">Link Expired</h2>
        <p class="mt-2 text-slate-400 text-sm">@Model.ErrorMessage</p>

        <div class="mt-8">
            <a asp-page="/Student/ForgotPassword" class="inline-flex items-center justify-center px-6 py-3 border border-transparent text-sm font-medium rounded-xl text-white bg-blue-600 hover:bg-blue-500 transition-colors shadow-lg shadow-blue-900/50">
                Request New Link
            </a>
        </div>
    </div>
}
else
{
    <div class="mb-8">
        <h2 class="text-3xl font-extrabold text-white">Set New Password</h2>
        <p class="mt-2 text-sm text-slate-400">
            Your new password must be different from previously used passwords.
        </p>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="mb-6 rounded-lg bg-red-900/30 p-4 border-l-4 border-red-500">
            <div class="text-sm font-medium text-red-200">@Model.ErrorMessage</div>
        </div>
    }

    <form method="post" class="space-y-5">
        <input type="hidden" asp-for="Token" />

        <div>
            <label class="block text-sm font-medium text-slate-300 mb-1">New Password</label>
            <div class="relative group">
                <input asp-for="NewPassword" type="password" id="newPass" required
                       class="block w-full px-4 py-3 bg-slate-800 border border-slate-700 rounded-lg text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all sm:text-sm"
                       placeholder="••••••••" />
            </div>

            <div class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-slate-400 bg-slate-800/50 p-3 rounded-lg border border-slate-700/50">
                <div class="flex items-center"><i class="fa-solid fa-circle text-[6px] text-blue-400 mr-2"></i> 8+ characters</div>
                <div class="flex items-center"><i class="fa-solid fa-circle text-[6px] text-blue-400 mr-2"></i> Upper & Lowercase</div>
                <div class="flex items-center"><i class="fa-solid fa-circle text-[6px] text-blue-400 mr-2"></i> One Number (0-9)</div>
                <div class="flex items-center"><i class="fa-solid fa-circle text-[6px] text-blue-400 mr-2"></i> One Symbol ($#@@!)</div>
            </div>
        </div>

        <div>
            <label class="block text-sm font-medium text-slate-300 mb-1">Confirm Password</label>
            <div class="relative group">
                <input asp-for="ConfirmPassword" type="password" id="confirmPass" required
                       class="block w-full px-4 py-3 bg-slate-800 border border-slate-700 rounded-lg text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all sm:text-sm"
                       placeholder="••••••••" />
            </div>
        </div>

        <div class="flex items-center">
            <input type="checkbox" id="showResetPassToggle" onclick="toggleResetPasswords()"
                   class="h-4 w-4 text-blue-600 focus:ring-blue-500 border-slate-600 bg-slate-700 rounded cursor-pointer">
            <label for="showResetPassToggle" class="ml-2 block text-sm text-slate-400 cursor-pointer select-none">
                Show Passwords
            </label>
        </div>

        <button type="submit"
                class="w-full flex justify-center py-3 px-4 border border-transparent rounded-xl shadow-lg shadow-blue-900/50 text-sm font-bold text-white bg-blue-600 hover:bg-blue-500 hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-slate-900 focus:ring-blue-500 transition-all duration-200">
            Reset Password
        </button>
    </form>
}

@section Scripts {
    <script>
        function toggleResetPasswords() {
            var p1 = document.getElementById("newPass");
            var p2 = document.getElementById("confirmPass");
            if (p1.type === "password") {
                p1.type = "text";
                p2.type = "text";
            } else {
                p1.type = "password";
                p2.type = "password";
            }
        }
    </script>
}