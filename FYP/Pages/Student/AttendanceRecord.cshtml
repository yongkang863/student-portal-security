@page
@model FYP.Pages.Student.AttendanceRecordModel
@{
    ViewData["Title"] = "Attendance Record";
    Layout = "_StudentLayout";
}

<div class="animate-fade-in-up bg-black/40 backdrop-blur-xl rounded-2xl border border-purple-500/20 p-6 mb-8 shadow-[0_8px_32px_0_rgba(88,28,135,0.3)]">

    <div class="flex items-center gap-3 mb-6">
        <i class="fa-solid fa-clipboard-user text-2xl text-fuchsia-400"></i>
        <h2 class="text-2xl font-bold text-white tracking-tight">Attendance Dashboard</h2>
    </div>

    @* --- Overall Summary Cards (Calculated by Hours) --- *@
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
        <div class="bg-purple-950/30 rounded-xl border border-purple-500/20 p-5 flex items-center justify-between shadow-[0_4px_20px_0_rgba(0,0,0,0.2)]">
            <div>
                <p class="text-sm font-medium text-purple-300/70 uppercase tracking-wide">Overall Rate</p>
                <div class="text-3xl font-extrabold text-white mt-1">
                    <span class="@(Model.OverallPercentage >= 80 ? "text-emerald-400" : Model.OverallPercentage >= 60 ? "text-amber-400" : "text-rose-400")">
                        @Model.OverallPercentage%
                    </span>
                </div>
            </div>
            <div class="w-12 h-12 rounded-full bg-fuchsia-500/20 text-fuchsia-400 flex items-center justify-center text-xl border border-fuchsia-500/30">
                <i class="fa-solid fa-percent"></i>
            </div>
        </div>
        <div class="bg-purple-950/30 rounded-xl border border-purple-500/20 p-5 flex items-center justify-between shadow-[0_4px_20px_0_rgba(0,0,0,0.2)]">
            <div>
                <p class="text-sm font-medium text-purple-300/70 uppercase tracking-wide">Attended Hours</p>
                <div class="text-3xl font-extrabold text-white mt-1">@Model.OverallAttendedHours.ToString("0.#") <span class="text-lg text-purple-400/50 font-medium">hrs</span></div>
            </div>
            <div class="w-12 h-12 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-xl border border-emerald-500/30">
                <i class="fa-solid fa-clock-rotate-left"></i>
            </div>
        </div>
        <div class="bg-purple-950/30 rounded-xl border border-purple-500/20 p-5 flex items-center justify-between shadow-[0_4px_20px_0_rgba(0,0,0,0.2)]">
            <div>
                <p class="text-sm font-medium text-purple-300/70 uppercase tracking-wide">Total Class Hours</p>
                <div class="text-3xl font-extrabold text-white mt-1">@Model.OverallTotalHours.ToString("0.#") <span class="text-lg text-purple-400/50 font-medium">hrs</span></div>
            </div>
            <div class="w-12 h-12 rounded-full bg-purple-500/20 text-purple-400 flex items-center justify-center text-xl border border-purple-500/30">
                <i class="fa-regular fa-clock"></i>
            </div>
        </div>
    </div>

    @* --- Subject Breakdown --- *@
    <div class="mb-10">
        <h3 class="text-lg font-bold text-white mb-4 flex items-center">
            <i class="fa-solid fa-layer-group text-violet-400 mr-2"></i> Subject Breakdown
        </h3>

        @if (!Model.CourseSummaries.Any())
        {
            <div class="bg-purple-950/20 border border-dashed border-purple-500/30 rounded-xl p-6 text-center text-purple-300/60">
                <p>No active courses found.</p>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-4">
                @foreach (var course in Model.CourseSummaries)
                {
                    string progressColor = course.Percentage >= 80 ? "bg-emerald-500" : course.Percentage >= 60 ? "bg-amber-500" : "bg-rose-500";

                    <div class="p-4 rounded-xl border border-purple-500/20 bg-purple-950/30 hover:bg-purple-900/40 transition-colors">
                        <div class="flex justify-between items-start mb-2">
                            <div>
                                <h4 class="font-bold text-white">@course.CourseCode</h4>
                                <p class="text-xs text-purple-300/80 truncate max-w-[200px]" title="@course.CourseTitle">@course.CourseTitle</p>
                            </div>
                            <div class="text-right">
                                <span class="text-lg font-bold text-white">@course.Percentage%</span>
                            </div>
                        </div>

                        <div class="w-full bg-black/50 rounded-full h-2.5 mb-2 border border-purple-500/20 overflow-hidden">
                            <div class="@progressColor h-2.5 rounded-full shadow-[0_0_10px_currentColor]" style="width: @course.Percentage%"></div>
                        </div>

                        <div class="flex justify-between text-[11px] text-purple-300/60 font-medium">
                            <span>@course.AttendedHours.ToString("0.#") hrs attended</span>
                            <span>@course.TotalHours.ToString("0.#") hrs total</span>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    @* --- Detailed Record Table --- *@
    <div>
        <h3 class="text-lg font-bold text-white mb-4 flex items-center">
            <i class="fa-solid fa-clock-rotate-left text-fuchsia-400 mr-2"></i> Past Class History
        </h3>

        @if (!Model.PastClasses.Any())
        {
            <div class="bg-purple-950/20 border border-dashed border-purple-500/30 rounded-xl p-8 text-center text-purple-300/60">
                <i class="fa-solid fa-folder-open text-3xl mb-3"></i>
                <p class="text-lg">No past attendance records found.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto rounded-xl border border-purple-500/20">
                <table class="w-full text-left border-collapse">
                    <thead class="bg-purple-900/30 border-b border-purple-500/30 text-purple-300 text-sm font-semibold uppercase tracking-wider">
                        <tr>
                            <th class="p-4">Date & Time</th>
                            <th class="p-4">Course</th>
                            <th class="p-4">Type</th>
                            <th class="p-4">Duration</th>
                            <th class="p-4 text-center">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-purple-500/10 bg-black/20">
                        @foreach (var record in Model.PastClasses)
                        {
                            bool isPresent = record.Status.Equals("Present", StringComparison.OrdinalIgnoreCase);

                            <tr class="transition-colors hover:bg-purple-900/20">
                                <td class="p-4 whitespace-nowrap text-purple-100 font-medium">
                                    @record.Slot.Date.ToString("dd MMM yyyy")
                                    <div class="text-xs text-purple-400/70 mt-0.5">
                                        @record.Slot.StartTime.ToString("hh:mm tt") - @record.Slot.EndTime.ToString("hh:mm tt")
                                    </div>
                                </td>
                                <td class="p-4">
                                    <div class="font-bold text-white">@(record.Slot.Course?.Code)</div>
                                    <div class="text-xs text-purple-300/70 mt-0.5">@(record.Slot.Course?.Title)</div>
                                </td>
                                <td class="p-4 text-purple-200">
                                    <span class="px-2 py-1 rounded-md text-xs font-medium border border-purple-500/30 bg-purple-900/30">
                                        @record.Slot.ClassType
                                    </span>
                                </td>
                                <td class="p-4 text-purple-200 text-sm font-medium">
                                    @record.Hours.ToString("0.#") <span class="text-xs text-purple-400/60">hrs</span>
                                </td>
                                <td class="p-4 text-center">
                                    @if (isPresent)
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/50 shadow-[0_0_10px_rgba(16,185,129,0.2)]">
                                            <i class="fa-solid fa-check"></i> Present
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-rose-500/20 text-rose-300 border border-rose-500/50 shadow-[0_0_10px_rgba(244,63,94,0.2)]">
                                            <i class="fa-solid fa-xmark"></i> Absent
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>