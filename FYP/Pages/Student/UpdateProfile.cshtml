@page
@model FYP.Pages.Student.UpdateProfileModel
@{
    ViewData["Title"] = "Update Profile";
    Layout = "_StudentLayout";
}

<div class="max-w-2xl mx-auto animate-fade-in-up">
    <div class="bg-black/40 backdrop-blur-xl rounded-2xl border border-purple-500/20 p-8 shadow-[0_8px_32px_0_rgba(88,28,135,0.3)]">

        <div class="flex items-center gap-4 mb-8 border-b border-purple-500/20 pb-4">
            <div class="w-12 h-12 rounded-full bg-gradient-to-br from-purple-600 to-fuchsia-600 flex items-center justify-center text-white shadow-lg">
                <i class="fa-solid fa-user-pen text-xl"></i>
            </div>
            <div>
                <h2 class="text-2xl font-bold text-white">Update Profile</h2>
                <p class="text-purple-300/60 text-sm">Modify your contact and address details.</p>
            </div>
        </div>

        <form method="post" class="space-y-6">
            <div asp-validation-summary="ModelOnly" class="text-red-400 text-sm bg-red-900/20 p-3 rounded-lg border border-red-500/20"></div>

            <div class="space-y-2">
                <label asp-for="Input.ContactNo" class="block text-xs uppercase tracking-wider text-purple-400/70 font-semibold pl-1"></label>
                <div class="relative group">
                    <span class="absolute left-4 top-3.5 text-purple-400 group-focus-within:text-fuchsia-400 transition-colors">
                        <i class="fa-solid fa-phone"></i>
                    </span>
                    <input asp-for="Input.ContactNo" class="w-full bg-black/20 border border-purple-500/20 rounded-xl py-3 pl-12 pr-4 text-purple-100 placeholder-purple-500/30 focus:outline-none focus:border-fuchsia-500/50 focus:ring-1 focus:ring-fuchsia-500/50 transition-all" placeholder="0123456789" />
                </div>
                <span asp-validation-for="Input.ContactNo" class="text-red-400 text-xs pl-1"></span>
            </div>

            <div class="space-y-2">
                <label asp-for="Input.EmergencyContact" class="block text-xs uppercase tracking-wider text-purple-400/70 font-semibold pl-1"></label>
                <div class="relative group">
                    <span class="absolute left-4 top-3.5 text-purple-400 group-focus-within:text-fuchsia-400 transition-colors">
                        <i class="fa-solid fa-truck-medical"></i>
                    </span>
                    <input asp-for="Input.EmergencyContact" class="w-full bg-black/20 border border-purple-500/20 rounded-xl py-3 pl-12 pr-4 text-purple-100 placeholder-purple-500/30 focus:outline-none focus:border-fuchsia-500/50 focus:ring-1 focus:ring-fuchsia-500/50 transition-all" placeholder="0123456789" />
                </div>
                <span asp-validation-for="Input.EmergencyContact" class="text-red-400 text-xs pl-1"></span>
            </div>

            <div class="space-y-2">
                <label asp-for="Input.Address" class="block text-xs uppercase tracking-wider text-purple-400/70 font-semibold pl-1"></label>
                <div class="relative group">
                    <span class="absolute left-4 top-3.5 text-purple-400 group-focus-within:text-fuchsia-400 transition-colors">
                        <i class="fa-solid fa-map-location-dot"></i>
                    </span>
                    <textarea asp-for="Input.Address" rows="3" class="w-full bg-black/20 border border-purple-500/20 rounded-xl py-3 pl-12 pr-4 text-purple-100 placeholder-purple-500/30 focus:outline-none focus:border-fuchsia-500/50 focus:ring-1 focus:ring-fuchsia-500/50 transition-all" placeholder="Enter your permanent address (Max 100 chars)"></textarea>
                </div>
                <div class="flex justify-between px-1">
                    <span asp-validation-for="Input.Address" class="text-red-400 text-xs"></span>
                    <span class="text-xs text-purple-500/50">Max 100 chars</span>
                </div>
            </div>

            <div class="pt-4 flex gap-4">
                <a asp-page="/Student/Profile" class="flex-1 py-3 bg-purple-900/20 border border-purple-500/20 text-purple-300 rounded-xl text-center font-semibold hover:bg-purple-900/40 transition-all">Cancel</a>
                <button type="submit" class="flex-1 py-3 bg-gradient-to-r from-purple-600 to-fuchsia-600 text-white rounded-xl font-semibold shadow-[0_0_15px_rgba(217,70,239,0.4)] hover:shadow-[0_0_25px_rgba(217,70,239,0.6)] hover:scale-[1.02] transition-all">
                    Save Changes
                </button>
            </div>
        </form>
    </div>
</div>