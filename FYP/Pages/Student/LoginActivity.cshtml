@page
@model FYP.Pages.Student.LoginActivityModel
@{
    ViewData["Title"] = "Login Activity";
    Layout = "_StudentLayout";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="space-y-6 animate-fade-in-up">

    @* --- HEADER --- *@
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h2 class="text-3xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-white to-purple-200">
                Login Activity
            </h2>
            <p class="text-purple-400 mt-1">Monitor recent access to your account.</p>
        </div>

        <div class="flex items-center gap-3">
            <label for="statusFilter" class="text-sm font-medium text-purple-300">Filter:</label>
            <select id="statusFilter" onchange="filterLogs()" class="bg-purple-900/50 border border-purple-500/50 text-purple-100 text-sm rounded-lg focus:ring-purple-400 focus:border-purple-400 block p-2 outline-none transition-all">
                <option value="all">All Statuses</option>
                <option value="success">Success</option>
                <option value="failed">Failed</option>
            </select>
        </div>
    </div>

    @* --- ACTIVITY TABLE --- *@
    <div class="bg-purple-950/20 backdrop-blur-xl rounded-2xl border border-purple-500/20 overflow-hidden shadow-[0_8px_32px_0_rgba(88,28,135,0.2)]">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-purple-900/30 text-purple-200 text-sm uppercase tracking-wider border-b border-purple-500/30">
                        <th class="p-6 font-semibold">Device</th>
                        <th class="p-6 font-semibold">Location</th>
                        <th class="p-6 font-semibold">IP Address</th>
                        <th class="p-6 font-semibold">Date & Time</th>
                        <th class="p-6 font-semibold text-center">Status</th>
                    </tr>
                </thead>
                <tbody class="text-sm text-purple-100 divide-y divide-purple-500/20">
                    @if (Model.LoginLogs.Any())
                    {
                        @foreach (var log in Model.LoginLogs)
                        {
                            // Status Logic
                            bool isSuccess = log.Status.Contains("Success", StringComparison.OrdinalIgnoreCase);

                            // NEW: Define category for the data attribute
                            string statusCategory = isSuccess ? "success" : "failed";

                            string statusColor = isSuccess ? "bg-green-500/20 text-green-300 border-green-500/30" : "bg-red-500/20 text-red-300 border-red-500/30";
                            string icon = isSuccess ? "fa-check" : "fa-xmark";

                            <tr class="hover:bg-purple-800/10 transition-colors group log-row" data-status="@statusCategory">
                                <td class="p-6">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 rounded-lg bg-black/20 flex items-center justify-center text-purple-400">
                                            <i class="fa-solid fa-desktop"></i>
                                        </div>
                                        <span class="font-medium">@(log.Device ?? "Unknown Device")</span>
                                    </div>
                                </td>
                                <td class="p-6">
                                    <div class="flex items-center gap-2">
                                        <span>@(log.Location ?? "Unknown")</span>
                                        @if (!string.IsNullOrEmpty(log.Location) && log.Location != "Local Development")
                                        {
                                            <button onclick="showMap('@log.Location')" class="w-7 h-7 rounded-full bg-blue-600/20 text-blue-400 hover:bg-blue-600 hover:text-white flex items-center justify-center transition-all border border-blue-500/30" title="View on Map">
                                                <i class="fa-solid fa-map-location-dot text-xs"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                                <td class="p-6 font-mono text-purple-300/80">@(log.IpAddress ?? "-")</td>
                                <td class="p-6">
                                    <div class="flex flex-col">
                                        <span class="font-medium text-white">@log.LoginTime.ToString("dd MMM yyyy")</span>
                                        <span class="text-xs text-purple-400">@log.LoginTime.ToString("hh:mm tt")</span>
                                    </div>
                                </td>
                                <td class="p-6 text-center">
                                    <span class="px-3 py-1 rounded-full border text-xs font-bold uppercase tracking-wider inline-flex items-center gap-2 @statusColor">
                                        <i class="fa-solid @icon"></i> @log.Status
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="p-12 text-center text-purple-400">
                                <i class="fa-solid fa-clock-rotate-left text-4xl mb-4 opacity-50"></i>
                                <p>No login history found.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div id="mapModal" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-black/80 backdrop-blur-sm transition-opacity" onclick="closeMap()"></div>

    <div class="absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 w-full max-w-2xl p-4">
        <div class="bg-gray-900 border border-purple-500/30 rounded-2xl shadow-[0_0_50px_rgba(168,85,247,0.3)] overflow-hidden">

            <div class="p-4 bg-purple-950/50 border-b border-purple-500/20 flex justify-between items-center">
                <h3 class="text-white font-bold flex items-center gap-2">
                    <i class="fa-solid fa-earth-asia text-fuchsia-400"></i>
                    <span id="mapTitle">Location View</span>
                </h3>
                <button onclick="closeMap()" class="text-purple-400 hover:text-white transition-colors">
                    <i class="fa-solid fa-xmark text-xl"></i>
                </button>
            </div>

            <div id="map" class="h-[400px] w-full bg-gray-800 relative z-10"></div>

            <div class="p-3 bg-black/40 text-xs text-center text-gray-500">
                Map data &copy; <a href="https://www.openstreetmap.org/copyright" class="underline hover:text-gray-300">OpenStreetMap</a> contributors
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        let map = null;
        let marker = null;

        function showMap(locationName) {
            const modal = document.getElementById('mapModal');
            const title = document.getElementById('mapTitle');

            // 1. Show Modal
            modal.classList.remove('hidden');
            title.innerText = locationName;

            // 2. Initialize Map (if first time)
            if (!map) {
                map = L.map('map').setView([0, 0], 2); // Default View
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    maxZoom: 19,
                    attribution: '© OpenStreetMap'
                }).addTo(map);
            }

            // 3. Geocode the Location Name (Convert "City" to Lat/Long)
            // Using OpenStreetMap Nominatim API (Free)
            fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(locationName)}`)
                .then(response => response.json())
                .then(data => {
                    if (data && data.length > 0) {
                        const lat = data[0].lat;
                        const lon = data[0].lon;

                        // Update Map View
                        map.setView([lat, lon], 13);

                        // Add/Move Marker
                        if (marker) map.removeLayer(marker);
                        marker = L.marker([lat, lon]).addTo(map)
                            .bindPopup(`<b style="color:black">${locationName}</b>`)
                            .openPopup();

                        // Force map resize check (fixes gray map issue in modals)
                        setTimeout(() => { map.invalidateSize(); }, 200);
                    } else {
                        alert("Location coordinates could not be found.");
                    }
                })
                .catch(err => {
                    console.error(err);
                    alert("Error loading map data.");
                });
        }

        function closeMap() {
            document.getElementById('mapModal').classList.add('hidden');
        }
        function filterLogs() {
            const filterValue = document.getElementById('statusFilter').value;
            const rows = document.querySelectorAll('.log-row');

            rows.forEach(row => {
                const rowStatus = row.getAttribute('data-status');

                // Show row if filter is 'all' OR if it matches the row's status
                if (filterValue === 'all' || rowStatus === filterValue) {
                    row.style.display = ''; // Reset display to default (shows row)
                } else {
                    row.style.display = 'none'; // Hide row
                }
            });
            }
    </script>
}