@page
@model FYP.Pages.Student.ForgotPasswordModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = "_StudentAuthLayout";
}

<div class="mb-8">
    <h2 class="text-3xl font-extrabold text-white">Forgot Password?</h2>
    <p class="mt-2 text-sm text-slate-400">
        No worries! Enter your student email and we'll send you reset instructions.
    </p>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="mb-6 rounded-lg bg-red-900/30 p-4 border-l-4 border-red-500">
        <div class="flex">
            <i class="fa-solid fa-circle-exclamation text-red-500 mt-0.5"></i>
            <div class="ml-3 text-sm font-medium text-red-200">@Model.ErrorMessage</div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="mb-6 rounded-lg bg-green-900/30 p-4 border border-green-800 flex items-start animate-fade-in-up">
        <i class="fa-solid fa-circle-check text-green-500 mt-0.5 text-lg"></i>
        <div class="ml-3">
            <h3 class="text-sm font-bold text-green-300">Check your email</h3>
            <p class="mt-1 text-sm text-green-400">@Model.Message</p>
        </div>
    </div>

    <a asp-page="/Student/Login" class="w-full flex justify-center py-3 px-4 border border-slate-600 rounded-xl shadow-sm text-sm font-bold text-slate-300 bg-slate-800 hover:bg-slate-700 transition-all mt-4">
        Return to Login
    </a>
}
else
{
    <form method="post" class="space-y-6">
        <div>
            <label asp-for="Email" class="block text-sm font-medium text-slate-300">Student Email</label>
            <div class="mt-1 relative rounded-md shadow-sm group">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <i class="fa-solid fa-envelope text-slate-500 group-focus-within:text-blue-400 transition-colors"></i>
                </div>
                <input asp-for="Email" type="email" required
                       class="block w-full pl-10 pr-3 py-3 bg-slate-800 border border-slate-700 rounded-lg text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all sm:text-sm"
                       placeholder="student@university.edu" />
            </div>
        </div>

        <button type="submit"
                class="w-full flex justify-center py-3 px-4 border border-transparent rounded-xl shadow-lg shadow-blue-900/50 text-sm font-bold text-white bg-blue-600 hover:bg-blue-500 hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-slate-900 focus:ring-blue-500 transition-all duration-200">
            Send Reset Link
        </button>
    </form>

    <div class="mt-6 text-center">
        <a asp-page="/Student/Login" class="inline-flex items-center text-sm font-medium text-slate-400 hover:text-white transition-colors">
            <i class="fa-solid fa-arrow-left mr-2"></i> Back to Login
        </a>
    </div>
}