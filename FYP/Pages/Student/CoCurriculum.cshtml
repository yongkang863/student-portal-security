@page
@model FYP.Pages.Student.CoCurriculumModel
@{
    ViewData["Title"] = "Co-curriculum Registration";
    Layout = "_StudentLayout";
    bool hasReachedLimit = Model.MyEnrollmentIds.Any();

    // Header Status Logic
    string statusText = "Dates Not Set";
    string statusClass = "text-purple-400";

    if (Model.RegistrationStart.HasValue)
    {
        DateTime now = DateTime.Now;
        if (now < Model.RegistrationStart.Value)
        {
            statusText = $"Opens: {Model.RegistrationStart.Value:dd MMM yyyy, hh:mm tt}";
            statusClass = "text-yellow-400";
        }
        else if (Model.RegistrationEnd.HasValue && now > Model.RegistrationEnd.Value)
        {
            statusText = "Registration Closed";
            statusClass = "text-red-400";
        }
        else
        {
            string endStr = Model.RegistrationEnd.HasValue ? Model.RegistrationEnd.Value.ToString("dd MMM yyyy") : "Indefinite";
            statusText = $"Open until {endStr}";
            statusClass = "text-green-400";
        }
    }
}

<div class="space-y-6 animate-fade-in-up">

    @* --- HEADER --- *@
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h2 class="text-3xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-white to-purple-200">
                Co-curriculum
            </h2>
            <div class="flex items-center gap-2 mt-1">
                <p class="text-purple-400">Browse and register for activities.</p>
                <span class="hidden md:inline text-purple-600">|</span>
                <span class="text-sm font-medium bg-black/30 px-3 py-1 rounded-lg border border-purple-500/20 @statusClass">
                    <i class="fa-regular fa-clock mr-2"></i>@statusText
                </span>
            </div>
        </div>

        <div class="flex gap-3">
            <div class="px-4 py-2 bg-purple-900/30 border border-purple-500/30 rounded-xl text-sm text-purple-200 flex items-center gap-2">
                <i class="fa-solid fa-signal text-green-400 animate-pulse"></i>
                <span>Live Status</span>
            </div>
            <div class="px-4 py-2 bg-black/40 border border-purple-500/30 rounded-xl text-sm text-purple-200 flex items-center gap-2">
                <i class="fa-solid fa-user-tag text-fuchsia-400"></i>
                <span>
                    You:
                    @if (hasReachedLimit)
                    {
                        <strong class="text-green-400">Registered</strong>
                    }
                    else
                    {

                        <strong class="text-purple-300">Not Registered</strong>
                    }
                </span>
            </div>
        </div>
    </div>

    @* --- ALERTS --- *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-green-500/10 border border-green-500/30 flex items-center gap-3 text-green-300 animate-fade-in-up">
            <i class="fa-solid fa-circle-check text-xl"></i>
            <span class="font-semibold">@TempData["SuccessMessage"]</span>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 rounded-xl bg-red-500/10 border border-red-500/30 flex items-center gap-3 text-red-300 animate-fade-in-up">
            <i class="fa-solid fa-circle-exclamation text-xl"></i>
            <span class="font-semibold">@TempData["ErrorMessage"]</span>
        </div>
    }

    @* --- GRID --- *@
    @foreach (var group in Model.Activities.GroupBy(x => x.Category))
    {
        <div class="mt-8">
            <h3 class="text-xl font-bold text-white mb-4 flex items-center">
                <span class="w-2 h-8 bg-fuchsia-500 rounded-full mr-3 shadow-[0_0_10px_#d946ef]"></span>
                @(group.Key ?? "General Activities")
            </h3>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var item in group)
                {
                    bool isRegistered = Model.MyEnrollmentIds.Contains(item.Id);
                    bool isFull = (item.SeatAvailable ?? 0) <= 0;

                    // Date Logic
                    DateTime now = DateTime.Now;
                    bool isDateMissing = !item.StartDate.HasValue;
                    bool isNotStarted = item.StartDate.HasValue && now < item.StartDate.Value;
                    bool isEnded = item.EndDate.HasValue && now > item.EndDate.Value;

                    string borderClass = isRegistered
                    ? "border-green-500/50 shadow-[0_0_20px_rgba(34,197,94,0.1)]"
                                            : "border-purple-500/20 hover:border-fuchsia-500/50";
                    string bgClass = isRegistered ? "bg-green-900/10" : "bg-purple-950/20";

                    <div class="relative rounded-2xl border @borderClass @bgClass p-6 backdrop-blur-sm transition-all duration-300 flex flex-col h-full group">

                        <div class="mb-4 pr-10">
                            <p class="text-xs font-mono text-purple-400 mb-1">@item.Code</p>
                            <h3 class="text-xl font-bold text-white group-hover:text-fuchsia-300 transition-colors">@item.Name</h3>
                        </div>

                        <div class="space-y-3 mb-6 flex-1">
                            <div class="flex items-center gap-3 text-sm text-purple-200/80">
                                <div class="w-8 h-8 rounded-lg bg-white/5 flex items-center justify-center flex-shrink-0">
                                    <i class="fa-regular fa-calendar text-fuchsia-400"></i>
                                </div>
                                <span>@(item.DayAndTimeRange ?? "TBA")</span>
                            </div>

                            <div class="flex items-center gap-3 text-sm text-purple-200/80">
                                <div class="w-8 h-8 rounded-lg bg-white/5 flex items-center justify-center flex-shrink-0">
                                    <i class="fa-solid fa-location-dot text-violet-400"></i>
                                </div>
                                <span>@(item.Venue ?? "TBA")</span>
                            </div>

                            <div class="flex items-center gap-3 text-sm text-purple-200/80">
                                <div class="w-8 h-8 rounded-lg bg-white/5 flex items-center justify-center flex-shrink-0">
                                    <i class="fa-solid fa-users text-blue-400"></i>
                                </div>
                                <div class="flex flex-col">
                                    <span>Capacity</span>
                                    <span class="text-xs text-purple-400">
                                        <span id="seat-count-@item.Id" class="font-bold @(isFull && !isRegistered ? "text-red-500" : "text-white") transition-colors duration-500">
                                            @(item.SeatAvailable ?? 0)
                                        </span>
                                        / @(item.MaxCapacity ?? 0)
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="mt-auto">
                            @if (isRegistered)
                            {
                                @if (isEnded)
                                {
                                    @* LOCKED: Registration ended, cannot drop *@
                                    <button disabled id="drop-btn-@item.Id" class="w-full py-3 rounded-xl bg-gray-800/50 border border-gray-700 text-gray-500 font-bold cursor-not-allowed">
                                        <i class="fa-solid fa-lock mr-2"></i> Registration Closed
                                    </button>
                                }
                                else
                                {
                                    @* ACTIVE DROP BUTTON *@
                                    <form method="post" asp-page-handler="Drop" asp-route-id="@item.Id" onsubmit="return confirm('Are you sure you want to drop this activity?');">
                                        <button id="drop-btn-@item.Id" type="submit" class="w-full py-3 rounded-xl bg-green-600/20 border border-green-500/50 text-green-300 font-bold hover:bg-red-600/20 hover:border-red-500/50 hover:text-red-300 transition-all group/btn">
                                            <span class="group-hover/btn:hidden"><i class="fa-solid fa-check mr-2"></i>Registered</span>
                                            <span class="hidden group-hover/btn:inline"><i class="fa-solid fa-xmark mr-2"></i>Drop Activity</span>
                                        </button>
                                    </form>
                                }
                            }
                            else if (hasReachedLimit)
                            {
                                <button disabled class="w-full py-3 rounded-xl bg-gray-800/50 border border-gray-700 text-gray-500 font-bold cursor-not-allowed">
                                    <i class="fa-solid fa-ban mr-2"></i> Limit Reached
                                </button>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="Register" asp-route-id="@item.Id">
                                    @if (isDateMissing)
                                    {
                                        <button disabled id="btn-@item.Id" class="w-full py-3 rounded-xl bg-gray-800/50 border border-gray-700 text-gray-500 font-bold cursor-not-allowed">
                                            <i class="fa-regular fa-calendar-xmark mr-2"></i> Date TBA
                                        </button>
                                    }
                                    else if (isNotStarted)
                                    {
                                        <button disabled id="btn-@item.Id" class="w-full py-3 rounded-xl bg-yellow-900/20 border border-yellow-700/50 text-yellow-500 font-bold cursor-not-allowed transition-all duration-500">
                                            <i class="fa-regular fa-clock mr-2"></i> Opening Soon
                                        </button>
                                    }
                                    else if (isEnded)
                                    {
                                        <button disabled id="btn-@item.Id" class="w-full py-3 rounded-xl bg-gray-800/50 border border-gray-700 text-gray-500 font-bold cursor-not-allowed">
                                            <i class="fa-solid fa-lock mr-2"></i> Registration Closed
                                        </button>
                                    }
                                    else if (isFull)
                                    {
                                        <button disabled id="btn-@item.Id" class="w-full py-3 rounded-xl bg-gray-800/50 border border-gray-700 text-gray-500 font-bold cursor-not-allowed">
                                            <i class="fa-solid fa-ban mr-2"></i> Full
                                        </button>
                                    }
                                    else
                                    {
                                        <button id="btn-@item.Id" type="submit" class="w-full py-3 rounded-xl bg-gradient-to-r from-purple-600 to-fuchsia-600 text-white font-bold shadow-[0_0_15px_rgba(217,70,239,0.3)] hover:shadow-[0_0_25px_rgba(217,70,239,0.5)] hover:scale-[1.02] transition-all">
                                            Register Now
                                        </button>
                                    }
                                </form>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function updateStatus() {
            fetch('?handler=SeatData')
                .then(response => response.json())
                .then(data => {
                    data.forEach(item => {

                        // 1. UPDATE SEAT NUMBERS
                        const countEl = document.getElementById(`seat-count-${item.id}`);
                        if (countEl) {
                            countEl.innerText = item.seats;
                            if (item.seats <= 0) {
                                countEl.classList.remove('text-white');
                                countEl.classList.add('text-red-500');
                            } else {
                                countEl.classList.add('text-white');
                                countEl.classList.remove('text-red-500');
                            }
                        }

                        const disabledStyle = "w-full py-3 rounded-xl bg-gray-800/50 border border-gray-700 text-gray-500 font-bold cursor-not-allowed";

                        // 2. LIVE LOCK: DROP BUTTON
                        // If user is looking at "Drop Activity" and time runs out, disable it immediately.
                        const dropBtn = document.getElementById(`drop-btn-${item.id}`);
                        if (dropBtn && item.isEnded) {
                            dropBtn.disabled = true;
                            dropBtn.innerHTML = '<i class="fa-solid fa-lock mr-2"></i> Registration Closed';
                            dropBtn.className = disabledStyle;
                            // Also remove the parent form submitting capability if possible, but disabling button is mostly enough for UI
                        }

                        // 3. LIVE BUTTON UPDATES (REGISTER BUTTONS)
                        const btn = document.getElementById(`btn-${item.id}`);
                        if (btn) {
                            const waitingStyle = "w-full py-3 rounded-xl bg-yellow-900/20 border border-yellow-700/50 text-yellow-500 font-bold cursor-not-allowed transition-all duration-500";
                            const activeStyle = "w-full py-3 rounded-xl bg-gradient-to-r from-purple-600 to-fuchsia-600 text-white font-bold shadow-[0_0_15px_rgba(217,70,239,0.3)] hover:shadow-[0_0_25px_rgba(217,70,239,0.5)] hover:scale-[1.02] transition-all";

                            if (item.isDateMissing) {
                                btn.disabled = true;
                                btn.innerHTML = '<i class="fa-regular fa-calendar-xmark mr-2"></i> Date TBA';
                                btn.className = disabledStyle;
                            }
                            else if (item.isNotStarted) {
                                btn.disabled = true;
                                btn.innerHTML = '<i class="fa-regular fa-clock mr-2"></i> Opening Soon';
                                btn.className = waitingStyle;
                            }
                            else if (item.isEnded) {
                                btn.disabled = true;
                                btn.innerHTML = '<i class="fa-solid fa-lock mr-2"></i> Registration Closed';
                                btn.className = disabledStyle;
                            }
                            else if (item.seats <= 0) {
                                btn.disabled = true;
                                btn.innerHTML = '<i class="fa-solid fa-ban mr-2"></i> Full';
                                btn.className = disabledStyle;
                            }
                            else {
                                // IT IS OPEN!
                                btn.disabled = false;
                                btn.innerHTML = 'Register Now';
                                btn.className = activeStyle;
                            }
                        }
                    });
                })
                .catch(err => console.error(err));
        }

        // Poll every 1 second
        setInterval(updateStatus, 1000);
    </script>
}