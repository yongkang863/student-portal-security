@page
@model FYP.Pages.Student.AcademicAdvisoryModel
@{
    ViewData["Title"] = "Academic Advisory";
    Layout = "_StudentLayout";
}

<div class="space-y-6 animate-fade-in-up">

    @* --- HEADER --- *@
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h2 class="text-3xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-white to-purple-200">
                Academic Advisory
            </h2>
            <p class="text-purple-400 mt-1">View your assigned academic advisor details and consultation hours.</p>
        </div>
    </div>

    @* --- MAIN CARD --- *@
    <div class="w-full max-w-5xl mx-auto mt-8">

        @if (Model.Advisor != null)
        {
            <div class="relative bg-purple-950/30 backdrop-blur-xl border border-purple-500/30 rounded-2xl p-8 md:p-12 overflow-hidden shadow-[0_0_50px_rgba(168,85,247,0.15)] group">

                <div class="absolute top-0 right-0 w-64 h-64 bg-fuchsia-600/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2 pointer-events-none"></div>
                <div class="absolute bottom-0 left-0 w-64 h-64 bg-blue-600/10 rounded-full blur-3xl translate-y-1/2 -translate-x-1/2 pointer-events-none"></div>

                <div class="relative z-10 flex flex-col md:flex-row gap-10 items-center md:items-start">

                    <div class="flex-shrink-0 text-center">
                        <div class="w-40 h-40 md:w-48 md:h-48 rounded-2xl border-2 border-purple-500/50 p-1 shadow-[0_0_25px_rgba(217,70,239,0.3)] bg-gradient-to-br from-purple-900/50 to-black relative overflow-hidden">
                            @if (!string.IsNullOrEmpty(Model.AdvisorPhotoBase64))
                            {
                                <img src="@Model.AdvisorPhotoBase64" alt="Advisor" class="w-full h-full object-cover rounded-xl transition-transform duration-500 group-hover:scale-110" />
                            }
                            else
                            {
                                <div class="w-full h-full bg-purple-900/40 rounded-xl flex items-center justify-center text-purple-400">
                                    <i class="fa-solid fa-user-tie text-6xl"></i>
                                </div>
                            }
                        </div>

                    </div>

                    <div class="flex-1 text-center md:text-left space-y-6 w-full">

                        <div>
                            <h3 class="text-2xl md:text-3xl font-bold text-white tracking-tight">@Model.Advisor.FullName</h3>
                            <p class="text-fuchsia-400 font-medium text-lg mt-1">Academic Advisor</p>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

                            <div class="bg-black/20 p-4 rounded-xl border border-purple-500/10 hover:border-purple-500/30 transition-colors">
                                <p class="text-xs uppercase text-purple-400 font-semibold mb-1">Department</p>
                                <p class="text-white flex items-center justify-center md:justify-start gap-2">
                                    <i class="fa-solid fa-sitemap text-purple-500"></i>
                                    @(Model.Advisor.Department?.DepartmentName ?? "General Faculty")
                                </p>
                            </div>

                            <div class="bg-black/20 p-4 rounded-xl border border-purple-500/10 hover:border-purple-500/30 transition-colors">
                                <p class="text-xs uppercase text-purple-400 font-semibold mb-1">Email Address</p>
                                <p class="text-white flex items-center justify-center md:justify-start gap-2 break-all">
                                    <i class="fa-solid fa-envelope text-purple-500"></i>
                                    @Model.Advisor.Email
                                </p>
                            </div>

                            <div class="bg-black/20 p-4 rounded-xl border border-purple-500/10 hover:border-purple-500/30 transition-colors">
                                <p class="text-xs uppercase text-purple-400 font-semibold mb-1">Office Location</p>
                                <p class="text-white flex items-center justify-center md:justify-start gap-2">
                                    <i class="fa-solid fa-building text-purple-500"></i>
                                    @(Model.AdvisoryInfo.OfficeLocation ?? "Not stated")
                                </p>
                            </div>

                            <div class="bg-black/20 p-4 rounded-xl border border-purple-500/10 hover:border-purple-500/30 transition-colors">
                                <p class="text-xs uppercase text-purple-400 font-semibold mb-1">Office Extension</p>
                                <p class="text-white flex items-center justify-center md:justify-start gap-2">
                                    <i class="fa-solid fa-phone text-purple-500"></i>
                                    @(Model.AdvisoryInfo.OfficeExtension ?? "N/A")
                                </p>
                            </div>

                            <div class="bg-black/20 p-4 rounded-xl border border-purple-500/10 hover:border-purple-500/30 transition-colors sm:col-span-2">
                                <p class="text-xs uppercase text-purple-400 font-semibold mb-1">Consultation Hours</p>
                                <p class="text-white flex items-center justify-center md:justify-start gap-2">
                                    <i class="fa-regular fa-clock text-fuchsia-500"></i>
                                    @(Model.AdvisoryInfo.ConsultationHours ?? "By Appointment")
                                </p>
                            </div>
                        </div>

                        <div class="flex flex-col sm:flex-row gap-4 pt-2">
                            <a href="mailto:@Model.Advisor.Email" class="flex-1 flex items-center justify-center py-3 px-6 rounded-xl border border-purple-500/30 text-white font-semibold hover:bg-purple-500/10 hover:border-fuchsia-500/50 transition-all group/btn">
                                <i class="fa-regular fa-envelope mr-2 text-fuchsia-400 group-hover/btn:scale-110 transition-transform"></i>
                                Send Email
                            </a>

                            <a href="https://chat.google.com/" target="_blank" onclick="copyEmailToClipboard('@Model.Advisor.Email')" class="flex-1 flex items-center justify-center py-3 px-6 rounded-xl bg-[#007b3e]/80 border border-[#00ac47]/50 text-white font-semibold shadow-[0_0_20px_rgba(0,172,71,0.2)] hover:bg-[#007b3e] hover:shadow-[0_0_30px_rgba(0,172,71,0.4)] hover:scale-[1.02] transition-all group/chat">
                                <i class="fa-regular fa-comments mr-2 group-hover/chat:animate-bounce"></i>
                                Google Chat
                            </a>
                        </div>

                        <p class="text-xs text-purple-400/50 text-center md:text-left">
                            <i class="fa-solid fa-circle-info mr-1"></i>
                            Clicking "Google Chat" will copy the advisor's email to your clipboard.
                        </p>

                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="text-center py-20 bg-purple-950/20 rounded-3xl border border-purple-500/20 border-dashed">
                <div class="w-24 h-24 mx-auto bg-purple-900/30 rounded-full flex items-center justify-center mb-6">
                    <i class="fa-solid fa-user-slash text-4xl text-purple-500/50"></i>
                </div>
                <h3 class="text-xl font-bold text-white mb-2">No Advisor Assigned</h3>
                <p class="text-purple-400 max-w-md mx-auto">
                    You have not been assigned an academic advisor yet. Please contact your faculty department for assistance.
                </p>
            </div>
        }
    </div>
</div>

<div id="toast" class="fixed bottom-8 right-8 bg-white text-black px-6 py-3 rounded-xl shadow-[0_0_20px_rgba(255,255,255,0.3)] transform translate-y-24 opacity-0 transition-all duration-300 z-50 flex items-center gap-3 font-semibold">
    <i class="fa-solid fa-circle-check text-green-600"></i>
    Email copied to clipboard!
</div>

@section Scripts {
    <script>
        function copyEmailToClipboard(email) {
            navigator.clipboard.writeText(email).then(function() {
                // Show Toast
                const toast = document.getElementById('toast');
                toast.classList.remove('translate-y-24', 'opacity-0');

                // Hide after 3 seconds
                setTimeout(() => {
                    toast.classList.add('translate-y-24', 'opacity-0');
                }, 3000);
            }, function(err) {
                console.error('Could not copy text: ', err);
            });
        }
    </script>
}