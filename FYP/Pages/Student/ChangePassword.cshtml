@page
@model FYP.Pages.Student.ChangePasswordModel
@{
    ViewData["Title"] = "Change Password";
    Layout = "_StudentLayout";
}

<div class="animate-fade-in-up max-w-2xl mx-auto">

    <div class="mb-8">
        <h2 class="text-3xl font-bold text-white tracking-tight">Security Settings</h2>
        <p class="text-purple-300/60 mt-2">Update your password to keep your account secure.</p>
    </div>

    <div class="bg-black/40 backdrop-blur-xl rounded-2xl border border-purple-500/20 p-8 shadow-[0_8px_32px_0_rgba(88,28,135,0.3)] relative overflow-hidden">

        <div class="absolute -top-24 -right-24 w-64 h-64 rounded-full bg-fuchsia-600/10 blur-[80px] pointer-events-none"></div>
        <div class="absolute -bottom-24 -left-24 w-64 h-64 rounded-full bg-violet-600/10 blur-[80px] pointer-events-none"></div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="mb-6 p-4 rounded-xl bg-red-900/20 border border-red-500/30 flex items-start gap-3">
                <i class="fa-solid fa-circle-exclamation text-red-400 mt-1"></i>
                <p class="text-red-200 text-sm">@Model.ErrorMessage</p>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="mb-6 p-4 rounded-xl bg-green-900/20 border border-green-500/30 flex items-start gap-3">
                <i class="fa-solid fa-circle-check text-green-400 mt-1"></i>
                <p class="text-green-200 text-sm">@Model.SuccessMessage</p>
            </div>
        }

        <form method="post" class="relative z-10 space-y-6">

            <div>
                <label class="block text-xs uppercase tracking-wider text-purple-400/70 font-semibold mb-2">Current Password</label>
                <div class="relative group">
                    <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <i class="fa-solid fa-key text-purple-500/50 group-focus-within:text-fuchsia-400 transition-colors"></i>
                    </span>
                    <input asp-for="CurrentPassword" type="password" id="currentPass" required
                           class="block w-full pl-10 pr-3 py-3 bg-purple-900/20 border border-purple-500/30 rounded-xl text-purple-100 placeholder-purple-400/30 focus:outline-none focus:border-fuchsia-500/50 focus:ring-1 focus:ring-fuchsia-500/50 transition-all sm:text-sm"
                           placeholder="Enter your current password" />
                </div>
            </div>

            <hr class="border-purple-500/20 my-6" />

            <div>
                <label class="block text-xs uppercase tracking-wider text-purple-400/70 font-semibold mb-2">New Password</label>
                <div class="relative group">
                    <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <i class="fa-solid fa-lock text-purple-500/50 group-focus-within:text-fuchsia-400 transition-colors"></i>
                    </span>
                    <input asp-for="NewPassword" type="password" id="newPass" required
                           class="block w-full pl-10 pr-3 py-3 bg-purple-900/20 border border-purple-500/30 rounded-xl text-purple-100 placeholder-purple-400/30 focus:outline-none focus:border-fuchsia-500/50 focus:ring-1 focus:ring-fuchsia-500/50 transition-all sm:text-sm"
                           placeholder="Enter new password" />
                </div>

                <div class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-purple-300/60 bg-black/20 p-3 rounded-lg border border-purple-500/10">
                    <div class="flex items-center"><i class="fa-solid fa-circle text-[6px] text-fuchsia-500 mr-2"></i> 8+ characters</div>
                    <div class="flex items-center"><i class="fa-solid fa-circle text-[6px] text-fuchsia-500 mr-2"></i> Upper & Lowercase</div>
                    <div class="flex items-center"><i class="fa-solid fa-circle text-[6px] text-fuchsia-500 mr-2"></i> One Number (0-9)</div>
                    <div class="flex items-center"><i class="fa-solid fa-circle text-[6px] text-fuchsia-500 mr-2"></i> One Symbol ($#@@!)</div>
                </div>
            </div>

            <div>
                <label class="block text-xs uppercase tracking-wider text-purple-400/70 font-semibold mb-2">Confirm New Password</label>
                <div class="relative group">
                    <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <i class="fa-solid fa-check-double text-purple-500/50 group-focus-within:text-fuchsia-400 transition-colors"></i>
                    </span>
                    <input asp-for="ConfirmNewPassword" type="password" id="confirmPass" required
                           class="block w-full pl-10 pr-3 py-3 bg-purple-900/20 border border-purple-500/30 rounded-xl text-purple-100 placeholder-purple-400/30 focus:outline-none focus:border-fuchsia-500/50 focus:ring-1 focus:ring-fuchsia-500/50 transition-all sm:text-sm"
                           placeholder="Confirm new password" />
                </div>
            </div>

            <div class="flex items-center">
                <input type="checkbox" id="showPassToggle" onclick="togglePasswords()"
                       class="h-4 w-4 text-fuchsia-600 focus:ring-fuchsia-500 border-purple-500/30 bg-purple-900/20 rounded cursor-pointer">
                <label for="showPassToggle" class="ml-2 block text-sm text-purple-300 cursor-pointer select-none">
                    Show Passwords
                </label>
            </div>

            <div class="pt-4 flex flex-col sm:flex-row gap-4">
                <button type="submit"
                        class="flex-1 flex justify-center py-3 px-4 border border-transparent rounded-xl shadow-[0_0_15px_rgba(217,70,239,0.3)] text-sm font-bold text-white bg-gradient-to-r from-purple-600 to-fuchsia-600 hover:shadow-[0_0_25px_rgba(217,70,239,0.5)] hover:scale-[1.02] transition-all duration-200">
                    Update Password
                </button>

                <a href="/Student/Homepage" class="flex-1 flex justify-center py-3 px-4 border border-purple-500/30 rounded-xl text-sm font-bold text-purple-300 hover:text-white hover:bg-purple-500/10 transition-colors">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function togglePasswords() {
            var current = document.getElementById("currentPass");
            var newP = document.getElementById("newPass");
            var confirmP = document.getElementById("confirmPass");

            if (current.type === "password") {
                current.type = "text";
                newP.type = "text";
                confirmP.type = "text";
            } else {
                current.type = "password";
                newP.type = "password";
                confirmP.type = "password";
            }
        }
    </script>
}