@page
@model FYP.Pages.Student.FacilityModel
@{
    Layout = "_StudentLayout";
    ViewData["Title"] = "Campus Facilities";
}

<div class="max-w-7xl mx-auto py-4">

    <div class="mb-8 p-8 bg-gradient-to-r from-purple-900/40 to-fuchsia-900/20 border border-purple-500/30 rounded-3xl shadow-[0_0_30px_rgba(168,85,247,0.15)] backdrop-blur-md">
        <h2 class="text-3xl font-extrabold tracking-tight text-white mb-2">Book a Facility</h2>
        <p class="text-purple-300">Reserve sports courts, study rooms, and halls across the campus.</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mb-6 p-4 bg-green-500/10 border border-green-500/50 text-green-400 rounded-xl flex items-center gap-3 shadow-[0_0_15px_rgba(34,197,94,0.2)]">
            <i class="fa-solid fa-circle-check"></i>
            <span class="font-semibold">@TempData["SuccessMessage"]</span>
        </div>
    }

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @if (Model.FacilityList.Any())
        {
            foreach (var facility in Model.FacilityList)
            {
                <div class="bg-purple-950/40 rounded-2xl border border-purple-500/20 overflow-hidden hover:shadow-[0_0_20px_rgba(217,70,239,0.3)] hover:border-fuchsia-500/50 transition-all duration-300 flex flex-col group">

                    <div class="h-48 bg-black/40 relative overflow-hidden">
                        @if (facility.Photos != null && facility.Photos.Any())
                        {
                            <img src="@facility.Photos.First().FilePath" alt="@facility.Name" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                        }
                        else
                        {
                            <div class="flex items-center justify-center h-full text-purple-700/50">
                                <i class="fa-solid fa-image text-4xl"></i>
                            </div>
                        }
                        <div class="absolute top-3 right-3">
                            <span class="px-3 py-1 text-xs font-bold rounded-full shadow-lg @(facility.Status?.StatusName == "Available" ? "bg-green-500/20 text-green-400 border border-green-500/30" : "bg-red-500/20 text-red-400 border border-red-500/30")">
                                @(facility.Status?.StatusName ?? "Unknown")
                            </span>
                        </div>
                    </div>

                    <div class="p-5 flex-1 flex flex-col">
                        <h3 class="text-lg font-bold text-white mb-2 line-clamp-1">@facility.Name</h3>
                        <span class="inline-block px-2 py-1 bg-fuchsia-900/30 border border-fuchsia-500/30 text-fuchsia-300 text-[10px] font-bold uppercase tracking-wider rounded mb-3 w-max">
                            @facility.FacilityType
                        </span>
                        <p class="text-sm text-purple-300/70 line-clamp-2 flex-1 mb-4">
                            @(string.IsNullOrEmpty(facility.Remark) ? "No remarks provided." : facility.Remark)
                        </p>
                    </div>

                    <div class="border-t border-purple-500/20 p-4 bg-black/20">
                        @if (facility.Status?.StatusName == "Available")
                        {
                            <a href="/Student/FacilityDetail?id=@facility.Id" class="block w-full text-center px-4 py-2.5 bg-gradient-to-r from-fuchsia-600 to-purple-600 hover:from-fuchsia-500 hover:to-purple-500 text-white font-bold rounded-xl shadow-[0_0_15px_rgba(217,70,239,0.4)] hover:shadow-[0_0_25px_rgba(217,70,239,0.6)] transition-all">
                                Select Date & Time
                            </a>
                        }
                        else
                        {
                            <button disabled class="block w-full text-center px-4 py-2.5 bg-purple-900/20 text-purple-500 font-bold rounded-xl cursor-not-allowed border border-purple-900/50">
                                Currently Unavailable
                            </button>
                        }
                    </div>

                </div>
            }
        }
    </div>
</div>