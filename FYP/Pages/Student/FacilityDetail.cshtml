@page
@model FYP.Pages.Student.FacilityDetailModel
@{
    Layout = "_StudentLayout";
    ViewData["Title"] = "Facility Details";
}

<div class="max-w-5xl mx-auto py-8">

    <a href="/Student/Facility" class="inline-flex items-center text-fuchsia-400 hover:text-fuchsia-300 mb-6 transition-colors font-medium">
        <i class="fa-solid fa-arrow-left mr-2"></i> Back to Facilities
    </a>

    <div class="bg-purple-950/40 rounded-3xl border border-purple-500/20 overflow-hidden shadow-[0_0_30px_rgba(88,28,135,0.3)] backdrop-blur-xl flex flex-col md:flex-row">

        <div class="w-full md:w-1/2 p-6 bg-black/20 border-r border-purple-500/20">
            @if (Model.DisplayFacility.Photos != null && Model.DisplayFacility.Photos.Any())
            {
                <div class="w-full h-64 md:h-80 rounded-2xl overflow-hidden border border-purple-500/30 mb-4 shadow-[0_0_20px_rgba(168,85,247,0.15)]">
                    <img src="@Model.DisplayFacility.Photos.First().FilePath" class="w-full h-full object-cover" alt="@Model.DisplayFacility.Name" />
                </div>

                @if (Model.DisplayFacility.Photos.Count > 1)
                {
                    <div class="grid grid-cols-3 gap-3">
                        @foreach (var photo in Model.DisplayFacility.Photos.Skip(1))
                        {
                            <div class="h-20 md:h-24 rounded-xl overflow-hidden border border-purple-500/30 opacity-70 hover:opacity-100 transition-opacity cursor-pointer">
                                <img src="@photo.FilePath" class="w-full h-full object-cover" />
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <div class="w-full h-64 rounded-2xl bg-purple-900/30 border border-purple-500/30 flex items-center justify-center text-purple-500/50">
                    <div class="text-center">
                        <i class="fa-solid fa-image text-5xl mb-2"></i>
                        <p>No photos available</p>
                    </div>
                </div>
            }
        </div>

        <div class="w-full md:w-1/2 p-8 flex flex-col">

            <div class="flex-1">
                <div class="flex justify-between items-start mb-2">
                    <span class="px-3 py-1 bg-fuchsia-900/30 text-fuchsia-300 text-[10px] font-bold uppercase tracking-wider rounded border border-fuchsia-500/30">
                        @Model.DisplayFacility.FacilityType
                    </span>
                    <span class="px-3 py-1 text-xs font-bold rounded-full shadow-lg @(Model.DisplayFacility.Status?.StatusName == "Available" ? "bg-green-500/20 text-green-400 border border-green-500/30" : "bg-red-500/20 text-red-400 border border-red-500/30")">
                        @(Model.DisplayFacility.Status?.StatusName ?? "Unknown")
                    </span>
                </div>

                <h2 class="text-3xl font-extrabold text-white mt-4 mb-6">@Model.DisplayFacility.Name</h2>

                <div class="mb-8">
                    <h3 class="text-sm font-bold text-purple-300 uppercase tracking-widest mb-2 border-b border-purple-500/20 pb-2">Remarks & Rules</h3>
                    <p class="text-purple-200/80 leading-relaxed text-sm whitespace-pre-line">
                        @(string.IsNullOrEmpty(Model.DisplayFacility.Remark) ? "No specific remarks or rules provided for this facility." : Model.DisplayFacility.Remark)
                    </p>
                </div>
            </div>

            <div class="pt-6 border-t border-purple-500/20 mt-auto">
                @if (Model.DisplayFacility.Status?.StatusName == "Available")
                {
                    <p class="text-xs text-purple-400 mb-3 text-center"><i class="fa-solid fa-circle-info mr-1"></i> You can book this facility up to 1 month in advance.</p>
                    <a href="/Student/FacilityBooking?id=@Model.DisplayFacility.Id" class="block w-full text-center px-6 py-4 bg-gradient-to-r from-fuchsia-600 to-purple-600 hover:from-fuchsia-500 hover:to-purple-500 text-white text-lg font-bold rounded-xl shadow-[0_0_20px_rgba(217,70,239,0.4)] hover:shadow-[0_0_30px_rgba(217,70,239,0.7)] transition-all transform hover:-translate-y-1">
                        Proceed to Booking <i class="fa-solid fa-arrow-right ml-2"></i>
                    </a>
                }
                else
                {
                    <div class="p-4 bg-red-900/20 border border-red-500/30 rounded-xl text-center">
                        <i class="fa-solid fa-lock text-red-400 text-2xl mb-2"></i>
                        <h4 class="text-red-300 font-bold">Facility is Closed</h4>
                        <p class="text-red-400/70 text-sm mt-1">This facility is currently under maintenance or completely booked out.</p>
                    </div>
                }
            </div>

        </div>
    </div>
</div>