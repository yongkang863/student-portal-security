@page
@model FYP.Pages.Student.CurrentBillingModel
@{
    Layout = "_StudentLayout";
    ViewData["Title"] = "Current Billing";
}

<div class="space-y-6 animate-fade-in-up">

    <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-4 border-b border-purple-500/20 pb-6">
        <div>
            <h1 class="text-3xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-white to-fuchsia-300 tracking-tight">Outstanding Bills</h1>
            <p class="text-sm text-purple-300/70 mt-2">Manage and pay your current university fees here.</p>
        </div>
        <div class="bg-purple-900/30 border border-fuchsia-500/30 px-4 py-2 rounded-xl backdrop-blur-md">
            <span class="text-sm text-purple-200">Total Due:</span>
            <span class="text-xl font-bold text-fuchsia-400 ml-2">RM @Model.Bills.Sum(b => b.Amount).ToString("0.00")</span>
        </div>
    </div>

    @if (Model.Bills.Any())
    {
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
            @foreach (var bill in Model.Bills)
            {
                var isOverdue = bill.DueDate < DateOnly.FromDateTime(DateTime.Now);

                <div class="bg-purple-950/40 backdrop-blur-xl border border-purple-500/20 rounded-2xl p-6 shadow-[0_4px_20px_-5px_rgba(88,28,135,0.3)] hover:border-fuchsia-500/40 hover:shadow-[0_0_20px_rgba(217,70,239,0.15)] transition-all flex flex-col justify-between">
                    <div>
                        <div class="flex justify-between items-start mb-4">
                            <span class="px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider rounded-lg bg-purple-900/50 text-purple-300 border border-purple-500/30">
                                @bill.BillType
                            </span>
                            @if (isOverdue)
                            {
                                <span class="px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider rounded-lg bg-rose-500/20 text-rose-400 border border-rose-500/30 animate-pulse">
                                    Overdue
                                </span>
                            }
                        </div>

                        <h3 class="text-lg font-bold text-purple-100 mb-1 leading-tight">@bill.Title</h3>
                        <p class="text-xs text-purple-400 font-mono mb-4">Ref: @bill.ReferenceNo</p>
                    </div>

                    <div class="mt-4 pt-4 border-t border-purple-500/20">
                        <div class="flex justify-between items-end mb-5">
                            <div>
                                <p class="text-xs text-purple-400/70 uppercase tracking-wider mb-1">Amount Due</p>
                                <p class="text-2xl font-bold text-white">RM @bill.Amount.ToString("0.00")</p>
                            </div>
                            <div class="text-right">
                                <p class="text-xs text-purple-400/70 uppercase tracking-wider mb-1">Due Date</p>
                                <p class="text-sm font-medium @(isOverdue ? "text-rose-400" : "text-purple-200")">
                                    @bill.DueDate.ToString("dd MMM yyyy")
                                </p>
                            </div>
                        </div>

                        <button onclick="openBillModal(@bill.Id, '@bill.ReferenceNo', '@bill.Title.Replace("'", "\\'")', '@(bill.Description?.Replace("'", "\\'") ?? "No description provided.")', '@bill.Amount.ToString("0.00")', '@bill.DueDate.ToString("dd MMM yyyy")', '@bill.BillType', @isOverdue.ToString().ToLower())"
                                class="w-full py-3 bg-gradient-to-r from-purple-600/50 to-fuchsia-600/50 hover:from-purple-500 hover:to-fuchsia-500 text-white font-semibold rounded-xl border border-fuchsia-500/30 shadow-[0_0_15px_rgba(217,70,239,0.2)] hover:shadow-[0_0_25px_rgba(217,70,239,0.4)] transition-all flex justify-center items-center gap-2">
                            <i class="fa-solid fa-file-invoice-dollar"></i>
                            View Detail
                        </button>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="bg-purple-950/30 backdrop-blur-xl border border-purple-500/20 rounded-2xl p-12 text-center flex flex-col items-center justify-center">
            <div class="w-20 h-20 rounded-full bg-purple-900/30 border border-purple-500/30 flex items-center justify-center text-purple-400 mb-4 shadow-[0_0_30px_rgba(168,85,247,0.2)]">
                <i class="fa-solid fa-check-double text-3xl"></i>
            </div>
            <h3 class="text-xl font-bold text-white mb-2">You're all caught up!</h3>
            <p class="text-purple-300/70 max-w-sm">There are no outstanding bills on your account. Great job staying on top of your finances.</p>
        </div>
    }
</div>

<div id="billModal" class="hidden fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 transition-opacity">
    <div class="bg-purple-950/90 border border-fuchsia-500/30 rounded-2xl shadow-[0_0_50px_rgba(217,70,239,0.2)] max-w-lg w-full overflow-hidden transform transition-all">

        <div class="px-6 py-4 border-b border-purple-500/20 flex justify-between items-center bg-black/20">
            <h3 class="text-lg font-bold text-fuchsia-300 flex items-center gap-2">
                <i class="fa-solid fa-receipt"></i> Bill Details
            </h3>
            <button onclick="closeBillModal()" class="text-purple-400 hover:text-white transition-colors">
                <i class="fa-solid fa-xmark text-xl"></i>
            </button>
        </div>

        <div class="p-6 space-y-5">
            <input type="hidden" id="hiddenBillId" />

            <div>
                <span id="modalCategory" class="text-xs font-bold uppercase tracking-wider text-fuchsia-400 mb-1 block"></span>
                <h4 id="modalTitle" class="text-xl font-bold text-white leading-tight"></h4>
                <p id="modalRef" class="text-xs text-purple-400 font-mono mt-1"></p>
            </div>

            <div class="bg-black/30 p-4 rounded-xl border border-purple-500/20">
                <p class="text-xs text-purple-400/70 uppercase tracking-wider mb-2">Description</p>
                <p id="modalDescription" class="text-sm text-purple-200 leading-relaxed"></p>
            </div>

            <div class="flex justify-between items-center p-4 bg-gradient-to-r from-purple-900/40 to-fuchsia-900/20 rounded-xl border border-fuchsia-500/20">
                <div>
                    <p class="text-xs text-purple-400/70 uppercase tracking-wider mb-1">Due Date</p>
                    <p id="modalDueDate" class="text-sm font-semibold text-purple-200"></p>
                </div>
                <div class="text-right">
                    <p class="text-xs text-purple-400/70 uppercase tracking-wider mb-1">Total Amount</p>
                    <p class="text-2xl font-bold text-white">RM <span id="modalAmount"></span></p>
                </div>
            </div>
        </div>

        <div class="px-6 py-5 border-t border-purple-500/20 bg-black/20 flex gap-3">
            <button type="button" onclick="closeBillModal()" class="flex-1 py-3 px-4 bg-purple-900/30 hover:bg-purple-800/50 text-purple-200 font-semibold rounded-xl border border-purple-500/30 transition-colors">
                Close
            </button>
            <button type="button" id="payButton" onclick="proceedToPayment()" class="flex-1 py-3 px-4 bg-fuchsia-600 hover:bg-fuchsia-500 text-white font-bold rounded-xl shadow-[0_0_15px_rgba(217,70,239,0.4)] transition-colors flex justify-center items-center gap-2">
                <i class="fa-solid fa-credit-card"></i>
                Proceed to Pay
            </button>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        function openBillModal(id, ref, title, description, amount, dueDate, category, isOverdue) {
            // Assign the bill ID to the hidden input
            document.getElementById('hiddenBillId').value = id;
            document.getElementById('modalRef').textContent = 'Ref: ' + ref;
            document.getElementById('modalTitle').textContent = title;
            document.getElementById('modalDescription').textContent = description;
            document.getElementById('modalAmount').textContent = amount;
            document.getElementById('modalDueDate').textContent = dueDate;
            document.getElementById('modalCategory').textContent = category;

            // Handle the Pay Button Logic
            const payBtn = document.getElementById('payButton');
            if (isOverdue) {
                payBtn.disabled = true;
                payBtn.innerHTML = '<i class="fa-solid fa-lock"></i> Overdue - Pay at Counter';
                payBtn.className = "flex-1 py-3 px-4 bg-purple-950/50 text-purple-400 font-bold rounded-xl border border-purple-800/50 flex justify-center items-center gap-2 cursor-not-allowed";
            } else {
                payBtn.disabled = false;
                payBtn.innerHTML = '<i class="fa-solid fa-credit-card"></i> Proceed to Pay';
                payBtn.className = "flex-1 py-3 px-4 bg-fuchsia-600 hover:bg-fuchsia-500 text-white font-bold rounded-xl shadow-[0_0_15px_rgba(217,70,239,0.4)] transition-colors flex justify-center items-center gap-2";
            }

            document.getElementById('billModal').classList.remove('hidden');
        }

        function closeBillModal() {
            document.getElementById('billModal').classList.add('hidden');
        }

        function proceedToPayment() {
            // Read the hidden input and redirect the student to the simulated gateway
            const billId = document.getElementById('hiddenBillId').value;
            // FIXED: changed '?billId=' to '?id=' to match the C# parameter
            window.location.href = '/Student/Payment?id=' + billId;
        }
    </script>
}