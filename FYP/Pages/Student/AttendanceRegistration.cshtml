@page
@model FYP.Pages.Student.AttendanceRegistrationModel
@{
    ViewData["Title"] = "Attendance Registration";
    Layout = "_StudentLayout";
}

<div class="max-w-3xl mx-auto">
    <div class="animate-fade-in-up bg-black/40 backdrop-blur-xl rounded-2xl border border-purple-500/20 p-8 shadow-[0_8px_32px_0_rgba(88,28,135,0.3)] text-center relative overflow-hidden group">

        <div class="absolute top-0 right-0 w-64 h-64 bg-fuchsia-600/10 rounded-full blur-[80px] pointer-events-none group-hover:bg-fuchsia-500/20 transition-all duration-700"></div>
        <div class="absolute bottom-0 left-0 w-64 h-64 bg-violet-600/10 rounded-full blur-[80px] pointer-events-none group-hover:bg-violet-500/20 transition-all duration-700"></div>

        <div class="w-20 h-20 rounded-full bg-purple-900/50 border border-purple-500/30 flex items-center justify-center mx-auto mb-6 shadow-[0_0_20px_rgba(168,85,247,0.2)]">
            <i class="fa-solid fa-qrcode text-3xl text-fuchsia-400"></i>
        </div>

        <h2 class="text-3xl font-extrabold text-white mb-2 tracking-tight">Record Attendance</h2>
        <p class="text-purple-300/80 mb-8 max-w-md mx-auto">Enter the 6-digit code provided by your lecturer to verify your presence in the current class.</p>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 px-4 py-3 rounded-xl mb-6 flex items-center justify-center gap-2 font-medium">
                <i class="fa-solid fa-circle-check"></i> @TempData["SuccessMessage"]
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="bg-rose-500/10 border border-rose-500/30 text-rose-300 px-4 py-3 rounded-xl mb-6 flex items-center justify-center gap-2 font-medium">
                <i class="fa-solid fa-circle-exclamation"></i> @TempData["ErrorMessage"]
            </div>
        }
        @if (TempData["InfoMessage"] != null)
        {
            <div class="bg-blue-500/10 border border-blue-500/30 text-blue-300 px-4 py-3 rounded-xl mb-6 flex items-center justify-center gap-2 font-medium">
                <i class="fa-solid fa-circle-info"></i> @TempData["InfoMessage"]
            </div>
        }

        @if (Model.ActiveSlot == null)
        {
            <div class="p-6 rounded-xl bg-purple-950/30 border border-dashed border-purple-500/30">
                <p class="text-purple-300/70 font-medium"><i class="fa-solid fa-clock mr-2"></i>You have no ongoing classes at this moment.</p>
            </div>
        }
        else
        {
            <div class="mb-8 p-4 rounded-xl bg-purple-900/20 border border-purple-500/20 inline-block text-left relative z-10 w-full max-w-md">
                <div class="text-xs font-bold text-fuchsia-400 uppercase tracking-wider mb-1">Ongoing Class</div>
                <div class="text-lg font-bold text-white">@(Model.ActiveSlot.Course?.Code) - @(Model.ActiveSlot.Course?.Title)</div>
                <div class="text-sm text-purple-200 mt-1"><i class="fa-regular fa-clock text-violet-400 mr-1.5"></i> @Model.ActiveSlot.StartTime.ToString("hh:mm tt") - @Model.ActiveSlot.EndTime.ToString("hh:mm tt")</div>
                <div class="text-sm text-purple-200 mt-0.5"><i class="fa-solid fa-location-dot text-violet-400 mr-1.5"></i> @(Model.ActiveSlot.Venue?.Name)</div>
            </div>

            if (!Model.AlreadyRecorded)
            {
                <form method="post" class="relative z-10 max-w-xs mx-auto">
                    <div class="mb-6">
                        <input type="text" asp-for="InputCode" maxlength="6" pattern="\d{6}" placeholder="000000" required
                               class="w-full text-center text-4xl tracking-[0.5em] font-bold bg-black/50 border-2 border-purple-500/30 rounded-xl py-4 text-fuchsia-300 placeholder-purple-500/20 focus:border-fuchsia-500 focus:ring-0 focus:outline-none shadow-inner transition-colors" />
                        <div class="text-xs text-purple-400/60 mt-2 text-center">Numbers only (6 digits)</div>
                    </div>

                    <button type="submit" class="w-full py-3.5 rounded-xl bg-gradient-to-r from-fuchsia-600 to-purple-600 hover:from-fuchsia-500 hover:to-purple-500 text-white font-bold tracking-wide shadow-[0_0_20px_rgba(217,70,239,0.4)] hover:shadow-[0_0_30px_rgba(217,70,239,0.6)] hover:-translate-y-0.5 transition-all duration-300">
                        Submit Code
                    </button>
                </form>
            }
        }
    </div>
</div>