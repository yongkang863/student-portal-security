@page
@model FYP.Pages.Student.SemesterResultModel
@{
    ViewData["Title"] = "Semester Result";
    Layout = "_StudentLayout";
}

<div class="animate-fade-in-up relative bg-black/40 backdrop-blur-xl rounded-2xl border border-purple-500/20 p-8 mb-8 overflow-hidden shadow-[0_8px_32px_0_rgba(88,28,135,0.3)]">
    <div class="absolute -top-24 -right-24 w-64 h-64 rounded-full bg-fuchsia-600/10 blur-[80px] pointer-events-none"></div>

    <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
            <h2 class="text-3xl font-bold text-white tracking-tight flex items-center gap-3 mb-2">
                <i class="fa-solid fa-square-poll-vertical text-fuchsia-400"></i>
                Semester Result
            </h2>
            <p class="text-purple-300/80">View your academic performance for a specific semester.</p>
        </div>

        @if (Model.AvailableSemesters.Any())
        {
            <form method="get" class="flex items-center gap-3 bg-purple-950/40 p-2 rounded-xl border border-purple-500/30">
                <span class="text-sm font-medium text-purple-300 pl-2">Select Term:</span>
                <select name="ResultId" onchange="this.form.submit()" class="bg-black/50 border border-purple-500/30 text-white text-sm rounded-lg focus:ring-fuchsia-500 focus:border-fuchsia-500 block p-2 outline-none">
                    @foreach (var sem in Model.AvailableSemesters)
                    {
                        if (Model.ResultId == sem.Id || (Model.ResultId == null && sem.Id == Model.SelectedSemester?.Id))
                        {
                            <option value="@sem.Id" selected>Year @sem.YearLevel, Semester @sem.Semester</option>
                        }
                        else
                        {
                            <option value="@sem.Id">Year @sem.YearLevel, Semester @sem.Semester</option>
                        }
                    }
                </select>
            </form>
        }
    </div>
</div>

@if (!Model.AvailableSemesters.Any())
{
    <div class="bg-purple-950/20 border border-dashed border-purple-500/30 rounded-xl p-12 text-center text-purple-300/60 shadow-inner">
        <i class="fa-solid fa-folder-open text-5xl mb-4 text-purple-500/30"></i>
        <h3 class="text-xl font-bold text-purple-200 mb-2">No Results Found</h3>
        <p>You do not have any published semester results yet.</p>
    </div>
}
else if (Model.SelectedSemester != null)
{
    @* Summary Cards *@
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <div class="bg-purple-950/30 rounded-xl border border-purple-500/20 p-5 flex items-center justify-between shadow-[0_4px_20px_0_rgba(0,0,0,0.2)] hover:border-fuchsia-500/30 transition-colors">
            <div>
                <p class="text-sm font-medium text-purple-300/70 uppercase tracking-wide">Semester GPA</p>
                <div class="text-3xl font-extrabold text-white mt-1">@Model.SelectedSemester.Gpa?.ToString("0.00")</div>
            </div>
            <div class="w-12 h-12 rounded-full bg-fuchsia-500/20 text-fuchsia-400 flex items-center justify-center text-xl border border-fuchsia-500/30">
                <i class="fa-solid fa-chart-line"></i>
            </div>
        </div>

        <div class="bg-purple-950/30 rounded-xl border border-purple-500/20 p-5 flex items-center justify-between shadow-[0_4px_20px_0_rgba(0,0,0,0.2)] hover:border-fuchsia-500/30 transition-colors">
            <div>
                <p class="text-sm font-medium text-purple-300/70 uppercase tracking-wide">Cumulative GPA</p>
                <div class="text-3xl font-extrabold text-white mt-1">@Model.SelectedSemester.Cgpa?.ToString("0.00")</div>
            </div>
            <div class="w-12 h-12 rounded-full bg-purple-500/20 text-purple-400 flex items-center justify-center text-xl border border-purple-500/30">
                <i class="fa-solid fa-ranking-star"></i>
            </div>
        </div>

        <div class="bg-purple-950/30 rounded-xl border border-purple-500/20 p-5 flex items-center justify-between shadow-[0_4px_20px_0_rgba(0,0,0,0.2)] hover:border-fuchsia-500/30 transition-colors">
            <div>
                <p class="text-sm font-medium text-purple-300/70 uppercase tracking-wide">Academic Status</p>
                <div class="text-xl font-bold text-white mt-2">
                    <span class="px-3 py-1 bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 rounded-full text-sm">
                        @Model.SelectedSemester.AcademicStatus
                    </span>
                </div>
            </div>
            <div class="w-12 h-12 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-xl border border-emerald-500/30">
                <i class="fa-solid fa-award"></i>
            </div>
        </div>
    </div>

    @* Course Results Table *@
    <div class="overflow-x-auto rounded-xl border border-purple-500/20 shadow-[0_8px_32px_0_rgba(88,28,135,0.2)]">
        <table class="w-full text-left border-collapse">
            <thead class="bg-purple-900/40 border-b border-purple-500/30 text-purple-200 text-sm font-semibold uppercase tracking-wider">
                <tr>
                    <th class="p-4">Course Details</th>
                    <th class="p-4 text-center">Credit Hours</th>
                    <th class="p-4 text-center">Grade</th>
                    <th class="p-4 text-center">Grade Point</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-purple-500/10 bg-black/30 backdrop-blur-md">
                @foreach (var cr in Model.CourseResults)
                {
                    <tr class="transition-colors hover:bg-purple-900/30">
                        <td class="p-4">
                            <div class="font-bold text-fuchsia-300">@(cr.Course?.Code)</div>
                            <div class="text-sm text-purple-100 mt-0.5">@(cr.Course?.Title)</div>
                        </td>
                        <td class="p-4 text-center text-purple-200 font-medium">
                            @(cr.Course?.CreditHours)
                        </td>
                        <td class="p-4 text-center">
                            <span class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-purple-800/50 border border-purple-500/30 font-bold text-lg text-white shadow-inner">
                                @(cr.Grade?.GradeLabel ?? "-")
                            </span>
                        </td>
                        <td class="p-4 text-center text-purple-200 font-medium">
                            @(cr.Grade?.GradePoint.ToString("0.00") ?? "-")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}