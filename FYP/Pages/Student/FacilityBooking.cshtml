@page
@model FYP.Pages.Student.FacilityBookingModel
@{
    Layout = "_StudentLayout";
    ViewData["Title"] = "Confirm Booking";
}

<div class="max-w-4xl mx-auto py-8">

    <a href="/Student/Facility" class="inline-flex items-center text-fuchsia-400 hover:text-fuchsia-300 mb-6 transition-colors">
        <i class="fa-solid fa-arrow-left mr-2"></i> Back to Facilities
    </a>

    <div class="bg-purple-950/40 rounded-3xl border border-purple-500/20 overflow-hidden shadow-[0_0_30px_rgba(88,28,135,0.3)] backdrop-blur-xl">

        <div class="p-8 border-b border-purple-500/20 bg-black/20 flex items-center gap-6">
            <div class="w-24 h-24 rounded-2xl overflow-hidden flex-shrink-0 border border-purple-500/30">
                @if (Model.BookingFacility.Photos != null && Model.BookingFacility.Photos.Any())
                {
                    <img src="@Model.BookingFacility.Photos.First().FilePath" class="w-full h-full object-cover" />
                }
                else
                {
                    <div class="w-full h-full bg-purple-900/50 flex items-center justify-center"><i class="fa-solid fa-building text-2xl text-purple-400"></i></div>
                }
            </div>
            <div>
                <span class="px-2 py-1 bg-fuchsia-900/30 text-fuchsia-300 text-[10px] font-bold uppercase rounded border border-fuchsia-500/30">@Model.BookingFacility.FacilityType</span>
                <h2 class="text-3xl font-extrabold text-white mt-2">@Model.BookingFacility.Name</h2>
            </div>
        </div>

        <div class="p-8">
            <div asp-validation-summary="ModelOnly" class="mb-6 p-4 bg-red-500/10 border border-red-500/50 text-red-400 rounded-xl"></div>

            <form method="get" class="mb-8">
                <input type="hidden" name="id" value="@Model.BookingFacility.Id" />
                <label class="block text-sm font-bold text-purple-300 mb-2">1. Select Date</label>

                <input type="date" name="SelectedDate" value="@Model.SelectedDate"
                       min="@DateTime.Now.ToString("yyyy-MM-dd")"
                       max="@DateTime.Now.AddMonths(1).ToString("yyyy-MM-dd")"
                       onchange="this.form.submit()"
                       class="w-full md:w-1/2 px-4 py-3 bg-black/40 border border-purple-500/30 text-white rounded-xl focus:outline-none focus:border-fuchsia-500 focus:ring-1 focus:ring-fuchsia-500 transition-all custom-date-picker" />
            </form>

            <form method="post">
                <input type="hidden" name="SelectedDate" value="@Model.SelectedDate" />

                <label class="block text-sm font-bold text-purple-300 mb-3">2. Select 1-Hour Time Slot (8 AM - 8 PM)</label>
                <span asp-validation-for="SelectedTimeSlot" class="text-red-400 text-sm mb-3 block"></span>

                <div class="grid grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3 mb-8">
                    @foreach (var slot in Model.DailySlots)
                    {
                        if (slot.IsAvailable)
                        {
                            <label class="cursor-pointer">
                                <input type="radio" asp-for="SelectedTimeSlot" value="@slot.Time.ToString("HH:mm")" class="peer sr-only" required />
                                <div class="text-center py-3 rounded-xl border border-purple-500/30 bg-purple-900/20 text-purple-200 peer-checked:bg-fuchsia-600 peer-checked:border-fuchsia-400 peer-checked:text-white peer-checked:shadow-[0_0_15px_rgba(217,70,239,0.5)] hover:bg-purple-800/40 transition-all">
                                    @slot.Time.ToString("hh:mm tt")
                                </div>
                            </label>
                        }
                        else
                        {
                            <div class="text-center py-3 rounded-xl border border-purple-900/30 bg-black/20 text-purple-700/50 cursor-not-allowed">
                                @slot.Time.ToString("hh:mm tt")
                            </div>
                        }
                    }
                </div>

                <div class="flex justify-end pt-6 border-t border-purple-500/20">
                    <button type="submit" class="px-8 py-3 bg-gradient-to-r from-fuchsia-600 to-purple-600 hover:from-fuchsia-500 hover:to-purple-500 text-white font-bold rounded-xl shadow-[0_0_15px_rgba(217,70,239,0.4)] hover:shadow-[0_0_25px_rgba(217,70,239,0.6)] transition-all flex items-center gap-2">
                        <i class="fa-solid fa-calendar-check"></i> Confirm Booking
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    /* Forces the calendar icon to be visible and stylable in dark mode */
    .custom-date-picker::-webkit-calendar-picker-indicator {
        filter: invert(1) sepia(100%) saturate(1000%) hue-rotate(240deg);
        cursor: pointer;
    }
</style>