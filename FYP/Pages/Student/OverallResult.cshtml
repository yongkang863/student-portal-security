@page
@model FYP.Pages.Student.OverallResultModel
@{
    ViewData["Title"] = "Overall Result";
    Layout = "_StudentLayout";
}

@* =========================================================================
   PRINT STYLES FOR OFFICIAL TRANSCRIPT
   ========================================================================= *@
<style>
    .print-only { display: none; }

    @@media print {
        /* Hide UI elements */
        aside, header, #sidebarToggle, .screen-only, .fixed.inset-0 { display: none !important; }

        /* Set page to White A4 setup */
        body, main, .p-8 {
            padding: 0 !important; margin: 0 !important;
            background-color: white !important; color: black !important;
            height: auto !important; overflow: visible !important;
        }

        /* Force text colors to black/dark gray */
        h1, h2, h3, h4, p, span, div, i, td, th {
            color: black !important; text-shadow: none !important;
            -webkit-text-fill-color: black !important;
        }

        /* Remove background styles */
        .bg-purple-950\/20, .bg-black\/40, .backdrop-blur-xl, .backdrop-blur-md, .shadow-inner {
            background: transparent !important; box-shadow: none !important;
            border: none !important;
        }

        /* Show Print Layouts */
        .print-only { display: block !important; }

        /* Transcript specific formatting */
        .transcript-container { width: 100%; font-size: 11pt; line-height: 1.3; }
        .transcript-header { border-bottom: 2px solid black; padding-bottom: 15px; margin-bottom: 20px; text-align: center; }
        .student-details { display: flex; justify-content: space-between; margin-bottom: 25px; font-size: 10pt; }
        .semester-block { break-inside: avoid; margin-bottom: 20px; }

        /* Table overrides */
        table { width: 100%; border-collapse: collapse; margin-bottom: 5px; font-size: 10pt; }
        th { border-bottom: 1px solid black; border-top: 1px solid black; padding: 4px 0; text-align: left; font-weight: bold; }
        td { padding: 3px 0; }
        .text-right { text-align: right !important; }
        .text-center { text-align: center !important; }
        .summary-row { border-top: 1px dashed black; font-weight: bold; padding-top: 5px; margin-top: 5px; }

        .print-footer { position: fixed; bottom: 0; width: 100%; text-align: center; font-size: 8pt; border-top: 1px solid #ccc; padding-top: 5px; }
        .page-break { page-break-after: always; }
    }
</style>

<script>
    function printTranscript() {
        window.print();
    }
</script>

@* =========================================================================
   PRINT ONLY: OFFICIAL ACADEMIC TRANSCRIPT
   ========================================================================= *@
<div class="print-only transcript-container">
    <div class="transcript-header">
        <h1 class="text-2xl font-bold uppercase tracking-widest">Ronnie University</h1>
        <h2 class="text-lg font-semibold mt-1">UNOFFICIAL ACADEMIC TRANSCRIPT</h2>
    </div>

    <div class="student-details">
        <div>
            <p><strong>Student Name:</strong> @Model.CurrentUser?.FullName</p>
            <p><strong>Student ID:</strong> @Model.CurrentUser?.UserId</p>
            <p><strong>IC / Passport No:</strong> @Model.CurrentUser?.IcNumber</p>
        </div>
        <div class="text-right">
            <p><strong>Programme Code:</strong> @Model.CurrentUser?.Programme?.Code</p>
            <p><strong>Programme Level:</strong> @Model.CurrentUser?.Programme?.Level</p>
            <p><strong>Intake Session:</strong> @Model.CurrentUser?.SessionJoined</p>
        </div>
    </div>

    @foreach (var sem in Model.AllSemesters)
    {
        <div class="semester-block">
            <div class="font-bold mb-1 border-b border-black inline-block">Year @sem.YearLevel, Semester @sem.Semester</div>
            <table>
                <thead>
                    <tr>
                        <th style="width: 15%;">Course Code</th>
                        <th style="width: 55%;">Course Title</th>
                        <th style="width: 10%;" class="text-center">Credits</th>
                        <th style="width: 10%;" class="text-center">Grade</th>
                        <th style="width: 10%;" class="text-right">Points</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.SemesterCourses.ContainsKey(sem.Id))
                    {
                        foreach (var cr in Model.SemesterCourses[sem.Id])
                        {
                            <tr>
                                <td>@cr.Course?.Code</td>
                                <td>@cr.Course?.Title</td>
                                <td class="text-center">@cr.Course?.CreditHours</td>
                                <td class="text-center">@cr.Grade?.GradeLabel</td>
                                <td class="text-right">@cr.Grade?.GradePoint.ToString("0.00")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            <div class="summary-row flex justify-between">
                <div>Academic Status: @sem.AcademicStatus</div>
                <div>GPA: @sem.Gpa?.ToString("0.00") &nbsp;&nbsp;|&nbsp;&nbsp; CGPA: @sem.Cgpa?.ToString("0.00")</div>
            </div>
        </div>
    }

    <div class="mt-8 border-2 border-black p-4 text-center font-bold">
        <p>TOTAL CREDITS ATTEMPTED: @Model.TotalCreditsAttempted</p>
        <p>TOTAL CREDITS EARNED: @Model.TotalCreditsEarned</p>
        <p class="mt-2 text-lg">FINAL CUMULATIVE GPA: @Model.FinalCgpa.ToString("0.00")</p>
    </div>

    <div class="print-footer">
        <p>This document is generated electronically and serves as an unofficial record. End of Transcript.</p>
        <p>Date Printed: @DateTime.Now.ToString("dd MMM yyyy HH:mm:ss")</p>
    </div>
</div>

@* =========================================================================
   DASHBOARD UI (SCREEN ONLY)
   ========================================================================= *@
<div class="screen-only">
    <div class="animate-fade-in-up relative bg-black/40 backdrop-blur-xl rounded-2xl border border-purple-500/20 p-8 mb-8 overflow-hidden shadow-[0_8px_32px_0_rgba(88,28,135,0.3)]">
        <div class="absolute -top-24 -right-24 w-64 h-64 rounded-full bg-fuchsia-600/10 blur-[80px] pointer-events-none"></div>

        <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
            <div>
                <h2 class="text-3xl font-bold text-white tracking-tight flex items-center gap-3 mb-2">
                    <i class="fa-solid fa-graduation-cap text-fuchsia-400"></i>
                    Overall Academic Record
                </h2>
                <p class="text-purple-300/80">View your entire academic journey and generate your transcript.</p>
            </div>

            @if (Model.AllSemesters.Any())
            {
                <button onclick="printTranscript()" class="flex items-center justify-center px-5 py-2.5 bg-gradient-to-r from-purple-600 to-fuchsia-600 text-white rounded-xl shadow-[0_0_15px_rgba(217,70,239,0.4)] hover:shadow-[0_0_25px_rgba(217,70,239,0.6)] hover:scale-105 transition-all font-semibold text-sm">
                    <i class="fa-solid fa-download mr-2"></i> Download / Print Transcript
                </button>
            }
        </div>
    </div>

    @if (!Model.AllSemesters.Any())
    {
        <div class="bg-purple-950/20 border border-dashed border-purple-500/30 rounded-xl p-12 text-center text-purple-300/60 shadow-inner">
            <i class="fa-solid fa-ghost text-5xl mb-4 text-purple-500/30"></i>
            <h3 class="text-xl font-bold text-purple-200 mb-2">No Records Found</h3>
            <p>You do not have any academic records on file yet.</p>
        </div>
    }
    else
    {
        @* Quick Stats *@
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <div class="bg-purple-900/20 rounded-xl border border-purple-500/20 p-6 flex flex-col items-center justify-center text-center">
                <i class="fa-solid fa-award text-3xl text-fuchsia-400 mb-2"></i>
                <div class="text-sm font-medium text-purple-300/70 uppercase">Final CGPA</div>
                <div class="text-4xl font-extrabold text-white mt-1">@Model.FinalCgpa.ToString("0.00")</div>
            </div>
            <div class="bg-purple-900/20 rounded-xl border border-purple-500/20 p-6 flex flex-col items-center justify-center text-center">
                <i class="fa-solid fa-book-open text-3xl text-purple-400 mb-2"></i>
                <div class="text-sm font-medium text-purple-300/70 uppercase">Credits Attempted</div>
                <div class="text-4xl font-extrabold text-white mt-1">@Model.TotalCreditsAttempted</div>
            </div>
            <div class="bg-purple-900/20 rounded-xl border border-purple-500/20 p-6 flex flex-col items-center justify-center text-center">
                <i class="fa-solid fa-check-double text-3xl text-emerald-400 mb-2"></i>
                <div class="text-sm font-medium text-purple-300/70 uppercase">Credits Earned</div>
                <div class="text-4xl font-extrabold text-white mt-1">@Model.TotalCreditsEarned</div>
            </div>
        </div>

        @* Timeline View of Semesters *@
        <div class="space-y-6">
            @foreach (var sem in Model.AllSemesters)
            {
                <div class="bg-black/30 backdrop-blur-md border border-purple-500/20 rounded-2xl overflow-hidden shadow-[0_4px_20px_rgba(0,0,0,0.2)]">
                    <div class="bg-purple-950/50 p-4 border-b border-purple-500/20 flex flex-wrap justify-between items-center gap-4">
                        <h3 class="font-bold text-lg text-fuchsia-300">
                            Year @sem.YearLevel, Semester @sem.Semester
                        </h3>
                        <div class="flex gap-4 text-sm font-medium">
                            <span class="bg-purple-900/50 border border-purple-500/30 text-purple-200 px-3 py-1 rounded-lg">GPA: @sem.Gpa?.ToString("0.00")</span>
                            <span class="bg-purple-900/50 border border-purple-500/30 text-purple-200 px-3 py-1 rounded-lg">CGPA: @sem.Cgpa?.ToString("0.00")</span>
                            <span class="bg-emerald-900/30 border border-emerald-500/30 text-emerald-300 px-3 py-1 rounded-lg">@sem.AcademicStatus</span>
                        </div>
                    </div>

                    <div class="p-4 overflow-x-auto">
                        <table class="w-full text-left border-collapse min-w-[600px]">
                            <thead class="text-purple-300/70 text-xs uppercase tracking-wider border-b border-purple-500/10">
                                <tr>
                                    <th class="pb-2">Course</th>
                                    <th class="pb-2 text-center w-24">Credits</th>
                                    <th class="pb-2 text-center w-24">Grade</th>
                                    <th class="pb-2 text-center w-24">Points</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-purple-500/5">
                                @if (Model.SemesterCourses.ContainsKey(sem.Id))
                                {
                                    foreach (var cr in Model.SemesterCourses[sem.Id])
                                    {
                                        <tr class="hover:bg-purple-900/10 transition-colors">
                                            <td class="py-3">
                                                <div class="font-bold text-white">@cr.Course?.Code</div>
                                                <div class="text-sm text-purple-200/80">@cr.Course?.Title</div>
                                            </td>
                                            <td class="py-3 text-center text-purple-200">@cr.Course?.CreditHours</td>
                                            <td class="py-3 text-center">
                                                <span class="inline-block bg-purple-800/40 text-white font-bold px-2.5 py-1 rounded border border-purple-500/20">
                                                    @(cr.Grade?.GradeLabel ?? "-")
                                                </span>
                                            </td>
                                            <td class="py-3 text-center text-purple-200">@(cr.Grade?.GradePoint.ToString("0.00") ?? "-")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    }
</div>