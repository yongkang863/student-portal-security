@page
@model FYP.Pages.Staff.ViewLeaveModel
@{
    Layout = "_StaffLayout";
    ViewData["Title"] = "View Leave History";
}

<div class="max-w-6xl mx-auto space-y-6 py-8">

    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-8 flex justify-between items-center">
        <div>
            <h2 class="text-2xl font-extrabold text-slate-800">Leave History</h2>
            <p class="text-slate-500 mt-1">View your past and pending leave applications.</p>
        </div>
        <div class="p-3 bg-blue-50 text-blue-600 rounded-xl hidden sm:block">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden p-6">
        @if (Model.LeaveHistory != null && Model.LeaveHistory.Any())
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="border-b border-slate-200 text-slate-600 bg-slate-50">
                            <th class="p-4 font-bold rounded-tl-xl">Start Date</th>
                            <th class="p-4 font-bold">End Date</th>
                            <th class="p-4 font-bold">Type</th>
                            <th class="p-4 font-bold">Reason</th>
                            <th class="p-4 font-bold">Document</th>
                            <th class="p-4 font-bold rounded-tr-xl">Status</th>
                        </tr>
                    </thead>
                    <tbody class="text-slate-700">
                        @foreach (var leave in Model.LeaveHistory)
                        {
                            <tr class="border-b border-slate-100 hover:bg-slate-50 transition-colors">
                                <td class="p-4">@leave.StartDate.ToString("yyyy-MM-dd")</td>
                                <td class="p-4">@leave.EndDate.ToString("yyyy-MM-dd")</td>
                                <td class="p-4">
                                    <span class="font-medium text-slate-800">@leave.LeaveType</span>
                                </td>
                                <td class="p-4 max-w-xs truncate" title="@leave.Reason">@leave.Reason</td>
                                <td class="p-4">
                                    @if (!string.IsNullOrEmpty(leave.Document))
                                    {
                                        <a href="@leave.Document" target="_blank" class="flex items-center gap-1 text-blue-600 hover:text-blue-800 font-medium transition-colors">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"></path></svg>
                                            View
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-slate-400 italic">None</span>
                                    }
                                </td>
                                <td class="p-4">
                                    @if (leave.StatusId == 1)
                                    {
                                        <span class="px-3 py-1 bg-green-100 text-green-700 border border-green-200 rounded-full text-xs font-bold uppercase tracking-wider">Approved</span>
                                    }
                                    else if (leave.StatusId == 3)
                                    {
                                        <span class="px-3 py-1 bg-yellow-100 text-yellow-700 border border-yellow-200 rounded-full text-xs font-bold uppercase tracking-wider">Pending</span>
                                    }
                                    else
                                    {
                                        <span class="px-3 py-1 bg-red-100 text-red-700 border border-red-200 rounded-full text-xs font-bold uppercase tracking-wider">Rejected</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-16">
                <svg class="w-16 h-16 mx-auto text-slate-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                <h3 class="text-2xl font-bold text-slate-700 mb-2">No Leave History</h3>
                <p class="text-slate-500">You haven't applied for any leaves yet.</p>
                <a href="/Staff/ApplyLeave" class="inline-block mt-6 px-6 py-2 bg-blue-50 text-blue-600 font-semibold rounded-lg hover:bg-blue-100 transition-colors border border-blue-200">
                    Apply for Leave
                </a>
            </div>
        }
    </div>
</div>