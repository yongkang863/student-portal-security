@page
@model FYP.Pages.Staff.ProfileModel
@{
    Layout = "_StaffLayout";
    ViewData["Title"] = "My Profile";
}

<div class="max-w-5xl mx-auto space-y-6">

    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="h-32 bg-gradient-to-r from-blue-700 to-indigo-800"></div>
        <div class="px-8 pb-8 relative">
            <div class="flex flex-col sm:flex-row items-center sm:items-end sm:space-x-6 -mt-16 sm:-mt-12">
                <div class="relative w-32 h-32 rounded-full border-4 border-white bg-white shadow-lg overflow-hidden flex-shrink-0">
                    <img src="@Model.ProfileImageSrc" alt="Profile Picture" class="w-full h-full object-cover" />
                </div>

                <div class="mt-4 sm:mt-0 flex-1 text-center sm:text-left pb-2">
                    <h1 class="text-2xl font-bold text-slate-800">@Model.CurrentStaff.FullName</h1>
                    <div class="flex flex-wrap items-center justify-center sm:justify-start gap-3 mt-2 text-sm text-slate-600 font-medium">
                        <span class="flex items-center gap-1">
                            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0m-5 8a2 2 0 100-4 2 2 0 000 4zm0 0c1.306 0 2.417.835 2.83 2M9 14a3.001 3.001 0 00-2.83 2M15 11h3m-3 4h2"></path></svg>
                            @Model.CurrentStaff.UserId
                        </span>
                        <span class="px-2.5 py-0.5 bg-blue-50 text-blue-700 rounded-full text-xs font-bold uppercase tracking-wider">
                            @(Model.CurrentStaff.Role?.RoleName ?? "Staff")
                        </span>

                        <span class="px-2.5 py-0.5 bg-indigo-50 text-indigo-700 rounded-full text-xs font-bold uppercase tracking-wider">
                            @(Model.CurrentStaff.Department?.DepartmentName ?? "No Department")
                        </span>

                        @if (Model.CurrentStaff.AdvisoryId != null)
                        {
                            <span class="px-2.5 py-0.5 bg-amber-50 text-amber-700 rounded-full text-xs font-bold uppercase tracking-wider flex items-center gap-1">
                                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                                Academic Advisor
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

        <div class="md:col-span-2 space-y-6">

            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6">
                <h3 class="text-lg font-bold text-slate-800 border-b border-slate-100 pb-3 mb-4 flex items-center gap-2">
                    <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                    Employment Details
                </h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-6 gap-x-8">
                    <div>
                        <p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Email Address</p>
                        <p class="text-slate-800 font-medium">@Model.CurrentStaff.Email</p>
                    </div>
                    <div>
                        <p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">IC Number</p>
                        <p class="text-slate-800 font-mono text-sm">@Model.CurrentStaff.IcNumber</p>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6">
                <h3 class="text-lg font-bold text-slate-800 border-b border-slate-100 pb-3 mb-4 flex items-center gap-2">
                    <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                    Contact Information
                </h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-6 gap-x-8">
                    <div>
                        <p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Phone Number</p>
                        <p class="text-slate-800 font-medium">@(Model.CurrentStaff.ContactNo ?? "Not Provided")</p>
                    </div>
                    <div>
                        <p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Emergency Contact</p>
                        <p class="text-slate-800 font-medium">@(Model.CurrentStaff.EmergencyContact ?? "Not Provided")</p>
                    </div>
                </div>
            </div>

        </div>

        <div class="space-y-6">

            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6">
                <h3 class="text-lg font-bold text-slate-800 border-b border-slate-100 pb-3 mb-4 flex items-center gap-2">
                    <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
                    Teaching Courses
                </h3>
                <div class="space-y-3">
                    @if (Model.TeachingCourses != null && Model.TeachingCourses.Any())
                    {
                        @foreach (var course in Model.TeachingCourses)
                        {
                            <div class="p-3 bg-slate-50 border border-slate-100 rounded-lg">
                                <p class="text-xs font-bold text-blue-600 uppercase tracking-wider mb-1">@course.Code</p>
                                <p class="text-slate-800 font-medium text-sm">@course.Title</p>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-sm text-slate-500 italic text-center py-4 bg-slate-50 rounded-lg border border-dashed border-slate-200">No courses assigned.</p>
                    }
                </div>
            </div>

            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6">
                <h3 class="text-lg font-bold text-slate-800 border-b border-slate-100 pb-3 mb-4 flex items-center gap-2">
                    <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
                    Payroll Details
                </h3>
                <div class="space-y-4">
                    <div>
                        <p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Bank Name</p>
                        <p class="text-slate-800 font-medium">@(Model.CurrentStaff.Bank?.BankName ?? "Not Assigned")</p>
                    </div>
                    <div>
                        <p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Account Number</p>
                        <p class="text-slate-800 font-mono text-sm tracking-widest">
                            @(Model.CurrentStaff.BankAccNo ?? "XXXX-XXXX")
                        </p>
                    </div>
                </div>
            </div>

            <a href="/Staff/Settings" class="block w-full text-center py-3 px-4 bg-slate-50 border border-slate-200 text-slate-600 font-bold rounded-xl hover:bg-slate-100 hover:text-blue-600 transition-colors">
                Change Password
            </a>

        </div>

    </div>
</div>