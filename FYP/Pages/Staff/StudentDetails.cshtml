@page
@model FYP.Pages.Staff.StudentDetailsModel
@{
    ViewData["Title"] = "Student Details";
    Layout = "_StaffLayout";
}

<div class="space-y-6 max-w-5xl mx-auto">

    <div class="flex items-center gap-4">
        <a href="/Staff/Advisor" class="p-2 bg-white border border-slate-200 rounded-lg text-slate-500 hover:text-blue-600 hover:bg-blue-50 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        </a>
        <div>
            <h2 class="text-2xl font-bold text-slate-800 tracking-tight">Student Profile</h2>
            <p class="text-slate-500 mt-1 text-sm">Viewing academic and personal details</p>
        </div>
    </div>

    @if (Model.StudentInfo != null)
    {
        <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden">
            <div class="p-8 flex flex-col md:flex-row gap-8 items-start">

                <div class="flex-shrink-0">
                    <div class="w-32 h-32 rounded-xl border-4 border-slate-50 overflow-hidden shadow-sm bg-slate-100 flex items-center justify-center text-slate-400">
                        @if (!string.IsNullOrEmpty(Model.StudentPhotoBase64))
                        {
                            <img src="@Model.StudentPhotoBase64" alt="@Model.StudentInfo.FullName" class="w-full h-full object-cover" />
                        }
                        else
                        {
                            <svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                        }
                    </div>
                </div>

                <div class="flex-1 w-full space-y-6">

                    <div class="border-b border-slate-100 pb-6 flex justify-between items-start">
                        <div>
                            <h3 class="text-2xl font-bold text-slate-900">@Model.StudentInfo.FullName</h3>
                            <p class="text-blue-600 font-medium text-sm mt-1">Student ID: @Model.StudentInfo.Uid</p>
                        </div>
                        <span class="px-3 py-1 rounded-full text-xs font-bold bg-green-100 text-green-700 border border-green-200">
                            Active Student
                        </span>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                        <div class="space-y-4">
                            <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Contact Information</h4>

                            <div class="flex items-start gap-3">
                                <svg class="w-5 h-5 text-slate-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                                <div>
                                    <p class="text-sm font-medium text-slate-900">Email Address</p>
                                    <a href="mailto:@Model.StudentInfo.Email" class="text-sm text-blue-600 hover:underline">@Model.StudentInfo.Email</a>
                                </div>
                            </div>
                        </div>

                        <div class="space-y-4">
                            <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Academic Details</h4>

                            <div class="flex items-start gap-3">
                                <svg class="w-5 h-5 text-slate-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"></path></svg>
                                <div>
                                    <p class="text-sm font-medium text-slate-900">Programme</p>
                                    <p class="text-sm text-slate-600">
                                        @(Model.StudentInfo.Programme?.Name ?? "N/A")
                                        <span class="text-slate-400">(@(Model.StudentInfo.Programme?.Code ?? "Unassigned"))</span>
                                    </p>
                                </div>
                            </div>

                            <div class="flex items-start gap-3">
                                <svg class="w-5 h-5 text-slate-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                                <div>
                                    <p class="text-sm font-medium text-slate-900">Department</p>
                                    <p class="text-sm text-slate-600">@(Model.StudentInfo.Programme?.Department?.DepartmentName ?? "General Faculty")</p>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <div class="bg-slate-50 px-8 py-4 border-t border-slate-100 flex justify-end gap-3">
                <a href="mailto:@Model.StudentInfo.Email" class="px-4 py-2 bg-white border border-slate-300 rounded-lg text-sm font-bold text-slate-700 hover:bg-slate-50 shadow-sm transition-colors">
                    Send Email
                </a>
            </div>
        </div>
    }
</div>