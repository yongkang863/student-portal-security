@page
@model FYP.Pages.Staff.TimetableModel
@{
    ViewData["Title"] = "My Teaching Timetable";
    Layout = "_StaffLayout";
    bool isViewingRealToday = Model.CurrentViewDate == DateOnly.FromDateTime(DateTime.Today);
    var currentTime = TimeOnly.FromDateTime(DateTime.Now);
}

@Html.AntiForgeryToken()

<div class="space-y-8 max-w-7xl mx-auto pb-12">

    @* --- Header & Week Selector --- *@
    <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 flex flex-col md:flex-row justify-between items-center gap-4">
        <div>
            <h2 class="text-2xl font-bold text-slate-800 tracking-tight flex items-center gap-3">
                <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                Weekly Schedule
            </h2>
            <p class="text-slate-500 text-sm mt-1">Viewing week: <span class="text-blue-600 font-bold">@Model.StartOfWeek.ToString("dd MMM yyyy") - @Model.EndOfWeek.ToString("dd MMM yyyy")</span></p>
        </div>

        <form method="get" class="flex items-center gap-3 bg-slate-50 p-2 rounded-xl border border-slate-200">
            <a href="?SelectedDate=@(Model.StartOfWeek.AddDays(-7).ToString("yyyy-MM-dd"))" class="w-8 h-8 flex items-center justify-center rounded-lg text-slate-400 hover:text-blue-600 hover:bg-white shadow-sm transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
            </a>
            <input type="date" name="SelectedDate" value="@((Model.SelectedDate ?? DateTime.Today).ToString("yyyy-MM-dd"))" onchange="this.form.submit()" class="bg-transparent border-none text-slate-700 text-sm font-bold focus:ring-0 cursor-pointer" />
            <a href="?SelectedDate=@(Model.StartOfWeek.AddDays(7).ToString("yyyy-MM-dd"))" class="w-8 h-8 flex items-center justify-center rounded-lg text-slate-400 hover:text-blue-600 hover:bg-white shadow-sm transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
            </a>
        </form>
    </div>

    @* --- Timetable Grid --- *@
    <div class="overflow-x-auto bg-white rounded-2xl shadow-sm border border-slate-200">
        <div class="min-w-[900px] relative">
            <div class="flex border-b border-slate-200 bg-slate-50 sticky top-0 z-20">
                <div class="w-16 flex-shrink-0 border-r border-slate-200"></div>
                @for (int i = 0; i < 7; i++)
                {
                    var currentDay = Model.StartOfWeek.AddDays(i);
                    bool isSelectedDay = currentDay == Model.CurrentViewDate;
                    <div class="flex-1 text-center py-3 border-r border-slate-200 last:border-r-0 @(isSelectedDay ? "bg-blue-50" : "")">
                        <div class="text-xs uppercase font-bold tracking-wider @(isSelectedDay ? "text-blue-600" : "text-slate-400")">@currentDay.ToString("ddd")</div>
                        <div class="text-sm font-bold @(isSelectedDay ? "text-blue-800" : "text-slate-600")">@currentDay.ToString("dd")</div>
                    </div>
                }
            </div>

            <div class="flex relative bg-slate-50/30" style="height: 1440px;">
                <div class="w-16 flex-shrink-0 border-r border-slate-200 relative z-10 bg-white">
                    @for (int i = 0; i <= 12; i++)
                    {
                        int hour = i + 8;
                        <div class="absolute w-full text-right pr-2" style="top: @(i * 120 - 8)px;">
                            <span class="text-[10px] text-slate-400 font-bold">@(hour > 12 ? $"{hour - 12} PM" : (hour == 12 ? "12 PM" : $"{hour} AM"))</span>
                        </div>
                    }
                </div>

                <div class="flex-1 flex relative">
                    <div class="absolute inset-0 pointer-events-none z-0">
                        @for (int i = 0; i <= 12; i++)
                        {
                            <div class="absolute w-full border-t border-slate-200" style="top: @(i * 120)px;"></div>
                        }
                    </div>

                    @for (int dayOffset = 0; dayOffset < 7; dayOffset++)
                    {
                        var currentDay = Model.StartOfWeek.AddDays(dayOffset);
                        var dailySlots = Model.Slots.Where(s => s.Date == currentDay).ToList();
                        bool isSelectedDay = currentDay == Model.CurrentViewDate;
                        bool isRealTodayForCol = currentDay == DateOnly.FromDateTime(DateTime.Today);

                        <div class="flex-1 border-r border-slate-200 last:border-r-0 relative z-10 @(isSelectedDay ? "bg-blue-50/30" : "")">
                            @foreach (var slot in dailySlots)
                            {
                                int startMinutes = (slot.StartTime.Hour * 60 + slot.StartTime.Minute) - 480;
                                int durationMinutes = (slot.EndTime.Hour * 60 + slot.EndTime.Minute) - (slot.StartTime.Hour * 60 + slot.StartTime.Minute);
                                if (startMinutes < 0) startMinutes = 0;
                                if (startMinutes + durationMinutes > 720) durationMinutes = 720 - startMinutes;
                                bool isOngoing = isRealTodayForCol && slot.StartTime <= currentTime && slot.EndTime > currentTime;

                                string baseClasses = isOngoing
                                ? "bg-blue-600 text-white border-blue-700 shadow-md z-20"
                                                        : "bg-white border-slate-200 shadow-sm hover:shadow-md hover:border-blue-300 z-10";

                                <div class="absolute w-[calc(100%-8px)] left-[4px] rounded-lg border p-2.5 flex flex-col overflow-hidden transition-all @baseClasses" style="top: @(startMinutes * 2)px; height: @(durationMinutes * 2)px;">
                                    <div class="text-[12px] font-bold @(isOngoing ? "text-white" : "text-slate-800") truncate">@(slot.Course?.Code)</div>
                                    <div class="text-[10px] font-medium @(isOngoing ? "text-blue-100" : "text-slate-500") leading-tight mt-0.5 line-clamp-2">@(slot.Course?.Title)</div>
                                    @if (durationMinutes >= 50)
                                    {
                                        <div class="mt-auto flex items-center justify-between text-[11px] font-medium @(isOngoing ? "text-blue-200" : "text-slate-500")">
                                            <span>@(slot.Venue?.Classroom ?? "TBA")</span>
                                            <span>@slot.StartTime.ToString("hh:mm tt")</span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @* --- Daily Classes & Attendance List --- *@
    <div>
        <h3 class="text-xl font-bold text-slate-800 mb-4 flex items-center gap-2">
            <span class="w-2 h-6 bg-blue-600 rounded-full"></span>
            Classes for @(isViewingRealToday ? "Today" : Model.CurrentViewDate.ToString("dddd, dd MMM yyyy"))
        </h3>

        @if (!Model.DailyClasses.Any())
        {
            <div class="bg-slate-50 border border-dashed border-slate-300 rounded-2xl p-10 text-center text-slate-500 font-medium">
                No classes scheduled for this day.
            </div>
        }
        else
        {
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                <table class="w-full text-left border-collapse">
                    <thead class="bg-slate-50 border-b border-slate-200 text-slate-500 text-xs font-bold uppercase tracking-wider">
                        <tr>
                            <th class="p-4">Time</th>
                            <th class="p-4">Course</th>
                            <th class="p-4">Venue</th>
                            <th class="p-4">Status</th>
                            <th class="p-4 text-right">Attendance Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var cls in Model.DailyClasses)
                        {
                            bool isOngoing = isViewingRealToday && cls.StartTime <= currentTime && cls.EndTime > currentTime;
                            bool isEnd = (isViewingRealToday && cls.EndTime <= currentTime) || Model.CurrentViewDate < DateOnly.FromDateTime(DateTime.Today);
                            bool isUpcoming = isViewingRealToday && cls.StartTime > currentTime;
                            bool canMarkAttendance = isOngoing || isEnd;

                            <tr class="hover:bg-slate-50 transition-colors @(isOngoing ? "bg-blue-50/30" : "")">
                                <td class="p-4 whitespace-nowrap text-slate-700 font-bold">@cls.StartTime.ToString("hh:mm tt") - @cls.EndTime.ToString("hh:mm tt")</td>
                                <td class="p-4">
                                    <div class="font-bold text-slate-800">@(cls.Course?.Code ?? "N/A")</div>
                                    <div class="text-xs text-slate-500 mt-0.5">@(cls.Course?.Title ?? "")</div>
                                </td>
                                <td class="p-4 text-slate-600 text-sm font-medium">@(cls.Venue?.Name) - @(cls.Venue?.Classroom ?? "TBA")</td>
                                <td class="p-4">
                                    @if (isOngoing)
                                    {
                                        <span class="px-2.5 py-1 rounded-md text-xs font-bold bg-green-100 text-green-700">Ongoing</span>
                                    }
                                    else if (isEnd)
                                    {

                                        <span class="px-2.5 py-1 rounded-md text-xs font-bold bg-slate-100 text-slate-600">Ended</span>
                                    }
                                    else if (isUpcoming)
                                    {

                                        <span class="px-2.5 py-1 rounded-md text-xs font-bold bg-blue-100 text-blue-700">Upcoming</span>
                                    }
                                </td>
                                <td class="p-4 text-right flex items-center justify-end gap-2">
                                    @* Attendance Code Logic *@
                                    @if (isOngoing)
                                    {
                                        <button onclick="generateCode(@cls.Id)" id="codeBtn-@cls.Id" class="px-4 py-2 bg-blue-600 text-white text-sm font-bold rounded-lg hover:bg-blue-700 transition-colors shadow-sm">
                                            @(cls.AttendanceCode != null ? $"Code: {cls.AttendanceCode:D6}" : "Generate Code")
                                        </button>
                                    }
                                    else if (isEnd && cls.AttendanceCode != null)
                                    {
                                        <span class="px-4 py-2 bg-slate-100 text-slate-500 text-sm font-bold rounded-lg border border-slate-200 cursor-not-allowed">Code: @cls.AttendanceCode</span>
                                    }
                                    else
                                    {
                                        <button disabled class="px-4 py-2 bg-slate-100 text-slate-400 text-sm font-bold rounded-lg border border-slate-200 cursor-not-allowed">Generate Code</button>
                                    }

                                    @* Mark Attendance List Button *@
                                    <button onclick="openAttendanceModal(@cls.Id, '@cls.Course?.Code')" class="px-4 py-2 bg-white text-slate-700 border border-slate-300 text-sm font-bold rounded-lg hover:bg-slate-50 transition-colors shadow-sm @(!canMarkAttendance ? "opacity-50 cursor-not-allowed" : "")" @(!canMarkAttendance ? "disabled" : "")>
                                        Student List
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@* --- Modal: Mark Attendance --- *@
<div id="attendanceModal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-slate-900/50 backdrop-blur-sm opacity-0 transition-opacity duration-300">
    @* --- CHANGED: Made the modal wider (max-w-5xl) to fit extra data --- *@
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-5xl mx-4 overflow-hidden flex flex-col max-h-[85vh]">
        <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center bg-slate-50">
            <h3 class="font-bold text-lg text-slate-800" id="modalTitle">Mark Attendance - <span id="modalCourseCode" class="text-blue-600"></span></h3>
            <button onclick="closeAttendanceModal()" class="text-slate-400 hover:text-slate-600"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg></button>
        </div>

        <div class="p-6 overflow-y-auto flex-1 relative min-h-[300px]">
            <div id="loadingSpinner" class="absolute inset-0 bg-white/80 z-10 hidden flex flex-col items-center justify-center">
                <svg class="animate-spin h-8 w-8 text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                <p class="mt-2 text-sm text-slate-500 font-medium">Loading students...</p>
            </div>

            <table class="w-full text-left" id="studentsTable">
                <thead class="text-xs uppercase text-slate-500 border-b border-slate-200">
                    <tr>
                        <th class="pb-3 font-bold">Student Info</th>
                        <th class="pb-3 font-bold">Method</th>
                        <th class="pb-3 font-bold">Taken Time</th>
                        <th class="pb-3 font-bold">IP Address</th>
                        <th class="pb-3 font-bold text-center">Present?</th>
                    </tr>
                </thead>
                <tbody class="text-sm divide-y divide-slate-100" id="studentsListBody">
                </tbody>
            </table>
        </div>

        <div class="px-6 py-4 border-t border-slate-100 bg-slate-50 flex justify-end gap-3">
            <button onclick="closeAttendanceModal()" class="px-4 py-2 rounded-lg font-bold text-slate-600 hover:bg-slate-200 transition-colors">Cancel</button>
            <button onclick="saveAttendance()" class="px-4 py-2 rounded-lg font-bold text-white bg-blue-600 hover:bg-blue-700 transition-colors shadow-sm">Save Attendance</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        let currentSlotId = null;

        async function generateCode(slotId) {
            const btn = document.getElementById(`codeBtn-${slotId}`);
            btn.innerHTML = `<svg class="animate-spin h-5 w-5 mx-auto" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>`;

            try {
                const formData = new FormData();
                formData.append('slotId', slotId);

                const response = await fetch('?handler=GenerateCode', {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token },
                    body: formData
                });
                const result = await response.json();

                if (result.success) {
                    btn.innerText = `Code: ${result.code}`;
                    btn.classList.replace('bg-blue-600', 'bg-green-600');
                } else {
                    alert(result.message);
                    btn.innerText = "Generate Code";
                }
            } catch (error) {
                console.error(error);
                alert("Error generating code.");
                btn.innerText = "Generate Code";
            }
        }

        const modal = document.getElementById('attendanceModal');
        const loading = document.getElementById('loadingSpinner');
        const tbody = document.getElementById('studentsListBody');

        async function openAttendanceModal(slotId, courseCode) {
            currentSlotId = slotId;
            document.getElementById('modalCourseCode').innerText = courseCode;
            tbody.innerHTML = '';

            modal.classList.remove('hidden');
            modal.classList.add('flex');
            setTimeout(() => modal.classList.replace('opacity-0', 'opacity-100'), 10);

            loading.classList.remove('hidden');

            try {
                const response = await fetch(`?handler=ClassList&slotId=${slotId}`, {
                    headers: { 'RequestVerificationToken': token }
                });
                const result = await response.json();

                if (result.success) {
                    if (result.data.length === 0) {
                        tbody.innerHTML = `<tr><td colspan="5" class="py-6 text-center text-slate-500 border-dashed border-2 rounded-lg">No students found in this cohort.</td></tr>`;
                    } else {
                        result.data.forEach(student => {
                            // Formatting the badges
                            let methodBadge = '<span class="text-slate-400 font-medium">-</span>';
                            if (student.updateMethod === 'Code') {
                                methodBadge = '<span class="px-2 py-1 bg-indigo-50 text-indigo-600 border border-indigo-200 text-[10px] font-bold uppercase rounded-md">Code</span>';
                            } else if (student.updateMethod === 'Manual') {
                                methodBadge = '<span class="px-2 py-1 bg-purple-50 text-purple-600 border border-purple-200 text-[10px] font-bold uppercase rounded-md">Manual</span>';
                            }

                            const tr = document.createElement('tr');
                            tr.innerHTML = `
                                <td class="py-3">
                                    <div class="font-bold text-slate-700">${student.studentName}</div>
                                    <div class="text-[11px] font-medium text-slate-500 mt-0.5">ID: ${student.studentId} | Group: ${student.tutorialGroup}</div>
                                </td>
                                <td class="py-3">${methodBadge}</td>
                                <td class="py-3 text-sm font-medium text-slate-600">${student.takenTime}</td>
                                <td class="py-3 text-xs font-mono text-slate-500">${student.ipAddress}</td>
                                <td class="py-3 text-center">
                                    <input type="checkbox" class="student-checkbox w-5 h-5 text-blue-600 rounded border-slate-300 focus:ring-blue-500 cursor-pointer"
                                           value="${student.studentId}" ${student.isPresent ? 'checked' : ''} />
                                </td>
                            `;
                            tbody.appendChild(tr);
                        });
                    }
                } else {
                    alert(result.message);
                    closeAttendanceModal();
                }
            } catch (error) {
                console.error(error);
                alert("Error fetching students.");
            } finally {
                loading.classList.add('hidden');
            }
        }

        function closeAttendanceModal() {
            modal.classList.replace('opacity-100', 'opacity-0');
            setTimeout(() => {
                modal.classList.remove('flex');
                modal.classList.add('hidden');
                currentSlotId = null;
            }, 300);
        }

        async function saveAttendance() {
            const checkboxes = document.querySelectorAll('.student-checkbox:checked');
            const presentIds = Array.from(checkboxes).map(cb => parseInt(cb.value));

            try {
                const response = await fetch('?handler=SaveAttendance', {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token,
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ SlotId: currentSlotId, PresentStudentIds: presentIds })
                });
                const result = await response.json();

                if (result.success) {
                    // Refresh data to show updated 'Manual' tags visually right away
                    openAttendanceModal(currentSlotId, document.getElementById('modalCourseCode').innerText);
                } else {
                    alert(result.message || "Failed to save attendance.");
                }
            } catch (error) {
                console.error(error);
                alert("An error occurred while saving.");
            }
        }
    </script>
}