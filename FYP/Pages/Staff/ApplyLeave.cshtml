@page
@model FYP.Pages.Staff.ApplyLeaveModel
@{
    Layout = "_StaffLayout";
    ViewData["Title"] = "Apply Leave";

    string minDate = DateTime.Now.AddDays(-7).ToString("yyyy-MM-dd");
    string maxDate = DateTime.Now.AddYears(1).ToString("yyyy-MM-dd");
}

<div class="max-w-4xl mx-auto space-y-6">

    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-8 flex justify-between items-center">
        <div>
            <h2 class="text-2xl font-extrabold text-slate-800">Request Leave</h2>
            <p class="text-slate-500 mt-1">Submit your leave applications and supporting medical documents.</p>
        </div>
        <div class="p-3 bg-blue-50 text-blue-600 rounded-xl hidden sm:block">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 bg-green-50 border border-green-200 text-green-700 rounded-xl flex items-center gap-3">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            <span class="font-semibold">@TempData["SuccessMessage"]</span>
        </div>
    }

    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 flex flex-col md:flex-row justify-between items-center gap-4">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-blue-50 border border-blue-100 rounded-full flex items-center justify-center text-blue-600">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
            </div>
            <div>
                <p class="text-xs font-bold text-slate-400 uppercase tracking-widest">Applicant Profile</p>
                <h3 class="text-lg font-bold text-slate-800">@(Model.CurrentStaff?.FullName ?? "Unknown Staff")</h3>
                <p class="text-sm text-slate-500">ID: @(Model.CurrentStaff?.UserId ?? "N/A")</p>
            </div>
        </div>

        <div class="text-center md:text-right">
            <p class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-1">Annual Quota Remaining</p>
            <div class="flex items-end justify-center md:justify-end gap-1">
                <span class="text-3xl font-extrabold @(Model.IsQuotaExceeded ? "text-red-500" : "text-blue-600")">
                    @(12 - Model.LeavesTakenThisYear)
                </span>
                <span class="text-slate-500 mb-1 font-medium">/ 12 Uses</span>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        @if (Model.IsQuotaExceeded)
        {
            <div class="p-12 text-center bg-red-50">
                <svg class="w-16 h-16 mx-auto text-red-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                <h3 class="text-2xl font-bold text-red-700 mb-2">Leave Quota Exceeded</h3>
                <p class="text-red-600 max-w-lg mx-auto">You have used all 12 of your approved leave requests for this year. Please contact the HR department if you require additional absence.</p>
            </div>
        }
        else
        {
            <form method="post" enctype="multipart/form-data" class="p-8 space-y-6">
                <div asp-validation-summary="ModelOnly" class="p-4 bg-red-50 border border-red-200 text-red-600 rounded-xl text-sm mb-6"></div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label asp-for="NewLeave.StartDate" class="block text-sm font-bold text-slate-700 mb-2">Start Date</label>
                        <input type="date" asp-for="NewLeave.StartDate" min="@minDate" max="@maxDate" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 text-slate-800 rounded-xl focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all" required />
                        <span asp-validation-for="NewLeave.StartDate" class="text-red-500 text-xs mt-1 block"></span>
                    </div>

                    <div>
                        <label asp-for="NewLeave.EndDate" class="block text-sm font-bold text-slate-700 mb-2">End Date</label>
                        <input type="date" asp-for="NewLeave.EndDate" min="@minDate" max="@maxDate" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 text-slate-800 rounded-xl focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all" required />
                        <span asp-validation-for="NewLeave.EndDate" class="text-red-500 text-xs mt-1 block"></span>
                    </div>
                </div>

                <div>
                    <label asp-for="NewLeave.LeaveType" class="block text-sm font-bold text-slate-700 mb-2">Leave Category</label>
                    <select asp-for="NewLeave.LeaveType" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 text-slate-800 rounded-xl focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all" required>
                        <option value="">-- Select Category --</option>
                        <option value="Annual">Annual Leave</option>
                        <option value="Medical">Medical / Sick Leave</option>
                        <option value="Unpaid">Unpaid Leave</option>
                        <option value="Emergency">Emergency Leave</option>
                        <option value="Other">Other</option>
                    </select>
                </div>

                <div>
                    <label asp-for="NewLeave.Reason" class="block text-sm font-bold text-slate-700 mb-2">Reason</label>
                    <textarea asp-for="NewLeave.Reason" rows="3" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 text-slate-800 rounded-xl focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-all" placeholder="Provide a brief explanation..."></textarea>
                    <span asp-validation-for="NewLeave.Reason" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <div class="p-5 border border-dashed border-slate-300 rounded-xl bg-slate-50">
                    <label class="block text-sm font-bold text-slate-700 mb-2">Supporting Document (Optional)</label>
                    <input type="file" asp-for="UploadedDocument" accept=".pdf, .png, .jpg, .jpeg" class="block w-full text-sm text-slate-500 file:mr-4 file:py-2.5 file:px-5 file:rounded-xl file:border-0 file:text-sm file:font-bold file:bg-blue-100 file:text-blue-700 hover:file:bg-blue-200 transition-all cursor-pointer" />
                    <p class="text-xs text-slate-400 mt-2">Accepted formats: PDF, PNG, JPG.</p>
                    <span asp-validation-for="UploadedDocument" class="text-red-500 text-xs mt-1 block"></span>
                </div>

                <div class="pt-6 border-t border-slate-100 flex justify-end">
                    <button type="submit" class="px-8 py-3 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl shadow-lg transition-all flex items-center gap-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path></svg>
                        Submit Application
                    </button>
                </div>
            </form>
        }
    </div>
</div>