@page
@model FYP.Pages.Staff.ForceChangePasswordModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Action Required";
}

<div>
    <h1 class="text-3xl font-bold text-gray-900 tracking-tight">Update Password</h1>
    <p class="text-sm text-gray-500 mt-2 mb-8">For security reasons, you must change your default password before continuing.</p>

    <form method="post" class="space-y-6">

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="bg-red-50 border-l-4 border-red-500 p-4 rounded-md shadow-sm">
                <p class="text-sm text-red-700 font-medium">@Model.ErrorMessage</p>
            </div>
        }

        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">New Password</label>
            <div class="relative rounded-lg shadow-sm">
                <input asp-for="Input.NewPassword" type="password" id="newPassword"
                       oninput="this.value = this.value.replace(/[^\x21-\x7E]/g, '');"
                       class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-black focus:border-transparent outline-none transition-all sm:text-sm pr-10"
                       placeholder="••••••••" />

                <button type="button" onclick="togglePassword('newPassword', 'eyeIconNew')" class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-black transition-colors outline-none">
                    <svg id="eyeIconNew" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                    </svg>
                </button>
            </div>
            <span asp-validation-for="Input.NewPassword" class="text-xs text-red-500 mt-1 block"></span>

            <div class="mt-2 bg-gray-50 p-3 rounded-md border border-gray-100">
                <ul class="text-xs text-gray-500 list-disc pl-4 space-y-1">
                    <li>Minimum 8 characters</li>
                    <li>Cannot be your previous password</li>
                    <li>1 uppercase, 1 lowercase, 1 number, 1 special character</li>
                    <li class="font-semibold text-gray-700">No spaces or emojis allowed</li>
                </ul>
            </div>
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Confirm Password</label>
            <div class="relative rounded-lg shadow-sm">
                <input asp-for="Input.ConfirmPassword" type="password" id="confirmPassword"
                       oninput="this.value = this.value.replace(/[^\x21-\x7E]/g, '');"
                       class="block w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-black focus:border-transparent outline-none transition-all sm:text-sm pr-10"
                       placeholder="••••••••" />

                <button type="button" onclick="togglePassword('confirmPassword', 'eyeIconConfirm')" class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-black transition-colors outline-none">
                    <svg id="eyeIconConfirm" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                    </svg>
                </button>
            </div>
            <span asp-validation-for="Input.ConfirmPassword" class="text-xs text-red-500 mt-1 block"></span>
        </div>

        <div class="pt-2">
            <button type="submit" class="w-full flex justify-center py-3 px-4 border border-transparent rounded-lg shadow-md text-sm font-semibold text-white bg-black hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-black transform transition hover:-translate-y-0.5">
                Update & Continue
            </button>
        </div>
    </form>
</div>

<script>
    function togglePassword(inputId, iconId) {
        const input = document.getElementById(inputId);
        const icon = document.getElementById(iconId);

        // Open Eye SVG Path
        const eyeOpen = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />`;
        // Closed Eye (Slashed) SVG Path
        const eyeClosed = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />`;

        if (input.type === "password") {
            input.type = "text";
            icon.innerHTML = eyeClosed;
        } else {
            input.type = "password";
            icon.innerHTML = eyeOpen;
        }
    }
</script>