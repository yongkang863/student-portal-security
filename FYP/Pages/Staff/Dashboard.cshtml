@page
@model FYP.Pages.Staff.DashboardModel
@{
    Layout = "_StaffLayout";
    ViewData["Title"] = "Staff Dashboard";
}

<div class="space-y-8 max-w-7xl mx-auto">

    <div class="relative overflow-hidden bg-gradient-to-r from-blue-700 to-indigo-800 rounded-3xl p-10 shadow-xl text-white">
        <div class="relative z-10">
            <h1 class="text-3xl font-extrabold tracking-tight mb-2">Welcome back, @Model.CurrentStaffName! 👋</h1>
            <p class="text-blue-100 text-lg max-w-2xl">
                You have <span class="font-bold text-white">@Model.Announcements.Count new updates</span>.
            </p>

            <div class="mt-8 flex gap-4">
                <a href="/Staff/ApplyLeave" class="px-6 py-2.5 bg-white text-blue-700 font-bold rounded-xl shadow-lg hover:bg-blue-50 transition-all">
                    Apply Leave
                </a>
                <a href="/Staff/Timetable" class="px-6 py-2.5 bg-blue-600/50 border border-blue-400/30 text-white font-bold rounded-xl hover:bg-blue-600 transition-all backdrop-blur-sm">
                    View Timetable
                </a>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

        <div class="lg:col-span-2 space-y-6">
            <h2 class="text-xl font-bold text-slate-800 flex items-center gap-2">
                <span class="w-2 h-8 bg-blue-600 rounded-full"></span> Latest Announcements
            </h2>

            <div class="grid gap-4">
                @if (Model.Announcements.Any())
                {
                    @foreach (var item in Model.Announcements)
                    {
                        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 hover:shadow-md transition-shadow">
                            <div class="flex justify-between items-start mb-2">
                                <span class="px-3 py-1 bg-blue-50 text-blue-700 text-[10px] font-bold uppercase tracking-wider rounded-full">
                                    @item.Category
                                </span>
                                <span class="text-xs text-slate-400 font-medium">@item.PublishDate.ToString("dd MMM yyyy")</span>
                            </div>
                            <h3 class="text-lg font-bold text-slate-800 mb-2">@item.Title</h3>
                            <div class="text-slate-500 text-sm line-clamp-2">@Html.Raw(item.Description)</div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-slate-500 text-center py-10 bg-white rounded-2xl border border-dashed border-slate-300">No new announcements.</p>
                }
            </div>

            <div class="mt-8">
                <h3 class="font-bold text-slate-800 mb-4">My Recent Login Activity</h3>
                <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                    <table class="w-full text-sm text-left">
                        <thead class="bg-slate-50 text-slate-500 border-b border-slate-200">
                            <tr>
                                <th class="px-6 py-3">Time</th>
                                <th class="px-6 py-3">IP Address</th>
                                <th class="px-6 py-3">Status</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @if (Model.MyRecentLogins.Any())
                            {
                                @foreach (var login in Model.MyRecentLogins)
                                {
                                    <tr>
                                        <td class="px-6 py-3 text-slate-600">@login.Time.ToString("g")</td>
                                        <td class="px-6 py-3 font-mono text-slate-500">@login.IpAddress</td>
                                        <td class="px-6 py-3">
                                            @if (login.Status?.Equals("Success", StringComparison.OrdinalIgnoreCase) == true)
                                            {
                                                <span class="text-green-600 font-bold text-xs bg-green-50 px-2 py-1 rounded-md">Success</span>
                                            }
                                            else
                                            {
                                                <span class="text-red-600 font-bold text-xs bg-red-50 px-2 py-1 rounded-md">Failed</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="px-6 py-8 text-center text-slate-400 text-sm border-dashed border-2 border-slate-100 rounded-lg">
                                        No recent login activity found.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>


    </div>
</div>