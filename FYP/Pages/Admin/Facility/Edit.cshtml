@page
@model FYP.Pages.Admin.Facilities.EditModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Edit Facility";
}

<div class="max-w-4xl mx-auto py-8">
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden p-6">
        <h2 class="text-2xl font-extrabold text-slate-800 mb-6">Edit Facility</h2>

        <form method="post" class="space-y-6">
            <input type="hidden" asp-for="EditFacility.Id" />

            <div>
                <label asp-for="EditFacility.Name" class="block text-sm font-bold text-slate-700 mb-2">Facility Name</label>
                <input asp-for="EditFacility.Name" type="text" class="w-full px-4 py-2 border border-slate-300 rounded-xl focus:ring-blue-500" required />
                <span asp-validation-for="EditFacility.Name" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <div>
                <label asp-for="EditFacility.FacilityType" class="block text-sm font-bold text-slate-700 mb-2">Facility Type</label>
                <select asp-for="EditFacility.FacilityType" class="w-full px-4 py-2 border border-slate-300 rounded-xl focus:ring-blue-500">
                    <option value="Sports">Sports</option>
                    <option value="Study Room">Study Room</option>
                    <option value="Hall">Hall</option>
                    <option value="Equipment">Equipment</option>
                </select>
            </div>

            <div>
                <label asp-for="EditFacility.StatusId" class="block text-sm font-bold text-slate-700 mb-2">Status</label>
                <select asp-for="EditFacility.StatusId" class="w-full px-4 py-2 border border-slate-300 rounded-xl focus:ring-blue-500">
                    <option value="4">Available</option>
                    <option value="5">Unavailable</option>
                </select>
            </div>

            <div>
                <label asp-for="EditFacility.Remark" class="block text-sm font-bold text-slate-700 mb-2">Remarks</label>
                <textarea asp-for="EditFacility.Remark" rows="3" class="w-full px-4 py-2 border border-slate-300 rounded-xl focus:ring-blue-500"></textarea>
                <span asp-validation-for="EditFacility.Remark" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <div class="pt-4 flex justify-end gap-3">
                <a href="/Admin/Facility/Index" class="px-5 py-2.5 bg-slate-100 text-slate-600 font-bold rounded-xl">Cancel</a>
                <button type="submit" class="px-5 py-2.5 bg-blue-600 text-white font-bold rounded-xl">Save Changes</button>
            </div>
        </form>
    </div>
</div>