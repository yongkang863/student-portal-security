@page
@model FYP.Pages.Admin.Facilities.DetailsModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Facility Details";
}

<div class="max-w-5xl mx-auto py-8">
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="p-6 border-b border-slate-100 flex justify-between items-center">
            <h2 class="text-2xl font-extrabold text-slate-800">@Model.DisplayFacility.Name</h2>
            <a href="/Admin/Facility/Index" class="text-blue-600 font-bold hover:underline">&larr; Back to List</a>
        </div>

        <div class="p-6">
            <p><strong>Type:</strong> @Model.DisplayFacility.FacilityType</p>
            <p><strong>Status:</strong> @Model.DisplayFacility.Status</p>
            <p><strong>Remarks:</strong> @Model.DisplayFacility.Remark</p>

            <h3 class="mt-8 mb-4 font-bold text-slate-800">Photos</h3>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                @foreach (var photo in Model.DisplayFacility.Photos)
                {
                    <img src="@photo.FilePath" class="w-full h-32 object-cover rounded-xl border border-slate-200" />
                }
            </div>
        </div>
    </div>
</div>