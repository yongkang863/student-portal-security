@model List<FYP.Pages.Admin.LoginActivity.MainModel.AuditViewModel>

@if (Model.Any())
{
    <div class="overflow-x-auto rounded-lg border border-slate-200">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-slate-50 text-slate-500 text-xs uppercase tracking-wider font-semibold border-b border-slate-200">
                    <th class="px-4 py-3">Timestamp</th>
                    <th class="px-4 py-3">User</th>
                    <th class="px-4 py-3">Device / IP</th>
                    <th class="px-4 py-3">Location</th>
                    <th class="px-4 py-3">Status</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-sm text-slate-700">
                @foreach (var log in Model)
                {
                    <tr class="hover:bg-slate-50/80 transition-colors">
                        <td class="px-4 py-3 whitespace-nowrap">
                            <span class="block font-medium">@log.Time.ToString("dd MMM yyyy")</span>
                            <span class="text-xs text-slate-400">@log.Time.ToString("hh:mm:ss tt")</span>
                        </td>
                        <td class="px-4 py-3">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-full bg-slate-200 flex items-center justify-center text-slate-600 font-bold text-xs">
                                    @log.UserName.Substring(0, 1)
                                </div>
                                <div>
                                    <p class="font-semibold text-slate-800">@log.UserName</p>
                                    <p class="text-xs text-slate-500 font-mono">ID: @log.UserId</p>
                                </div>
                            </div>
                        </td>
                        <td class="px-4 py-3">
                            <p class="text-slate-600 text-xs truncate max-w-[150px]" title="@log.Device">@log.Device</p>
                            <p class="text-[10px] font-mono text-slate-400 bg-slate-100 inline-block px-1 rounded mt-0.5">@log.IpAddress</p>
                        </td>
                        <td class="px-4 py-3 text-slate-600">
                            @log.Location
                        </td>
                        <td class="px-4 py-3">
                            @if (log.Status.Contains("Success"))
                            {
                                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-50 text-green-700 border border-green-100">
                                    <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span> Success
                                </span>
                            }
                            else if (log.Status.Contains("Lockout"))
                            {
                                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-50 text-red-700 border border-red-100">
                                    <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span> Locked
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-orange-50 text-orange-700 border border-orange-100">
                                    <span class="w-1.5 h-1.5 rounded-full bg-orange-500"></span> Failed
                                </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="flex flex-col items-center justify-center py-12 text-center text-slate-400">
        <svg class="w-12 h-12 mb-3 text-slate-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
        <p>No login activity found for this category.</p>
    </div>
}