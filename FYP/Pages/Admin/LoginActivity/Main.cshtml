@page
@model FYP.Pages.Admin.LoginActivity.MainModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Login Activity Audit";
}

<div class="space-y-6">

    <div class="flex justify-between items-end">
        <div>
            <h1 class="text-2xl font-bold font-serif text-slate-800">Security Audit Logs</h1>
            <p class="text-sm text-slate-500 mt-1">Monitor authentication attempts across the university platform.</p>
        </div>
        <div class="text-xs font-mono text-slate-400 bg-slate-100 px-3 py-1 rounded-lg">
            Last Updated: @DateTime.Now.ToString("HH:mm:ss")
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden" x-data="{ activeTab: 'staff' }">

        <div class="flex border-b border-slate-200 bg-slate-50/50">
            <button @@click="activeTab = 'admin'"
                    :class="activeTab === 'admin' ? 'border-blue-600 text-blue-600 bg-white' : 'border-transparent text-slate-500 hover:text-slate-700 hover:bg-slate-100'"
                    class="flex-1 py-4 text-sm font-bold border-b-2 transition-all duration-200 flex items-center justify-center gap-2">
                <span class="w-2 h-2 rounded-full bg-purple-600"></span> Administrators
                <span class="ml-2 bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full text-[10px]">@Model.AdminLogs.Count</span>
            </button>

            <button @@click="activeTab = 'staff'"
                    :class="activeTab === 'staff' ? 'border-blue-600 text-blue-600 bg-white' : 'border-transparent text-slate-500 hover:text-slate-700 hover:bg-slate-100'"
                    class="flex-1 py-4 text-sm font-bold border-b-2 transition-all duration-200 flex items-center justify-center gap-2">
                <span class="w-2 h-2 rounded-full bg-blue-600"></span> Staff Members
                <span class="ml-2 bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full text-[10px]">@Model.StaffLogs.Count</span>
            </button>

            <button @@click="activeTab = 'student'"
                    :class="activeTab === 'student' ? 'border-blue-600 text-blue-600 bg-white' : 'border-transparent text-slate-500 hover:text-slate-700 hover:bg-slate-100'"
                    class="flex-1 py-4 text-sm font-bold border-b-2 transition-all duration-200 flex items-center justify-center gap-2">
                <span class="w-2 h-2 rounded-full bg-emerald-600"></span> Students
                <span class="ml-2 bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full text-[10px]">@Model.StudentLogs.Count</span>
            </button>
        </div>

        <div class="p-6 min-h-[500px]">

            <div x-show="activeTab === 'admin'" class="animate-fade-in">
                @await Html.PartialAsync("_AuditTable", Model.AdminLogs)
            </div>

            <div x-show="activeTab === 'staff'" class="animate-fade-in" style="display: none;">
                @await Html.PartialAsync("_AuditTable", Model.StaffLogs)
            </div>

            <div x-show="activeTab === 'student'" class="animate-fade-in" style="display: none;">
                @await Html.PartialAsync("_AuditTable", Model.StudentLogs)
            </div>

        </div>
    </div>
</div>

<script src="//unpkg.com/alpinejs" defer></script>

<style>
    .animate-fade-in {
        animation: fadeIn 0.3s ease-in-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(5px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>