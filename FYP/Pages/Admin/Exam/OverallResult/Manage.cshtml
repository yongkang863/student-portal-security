@page
@model FYP.Pages.Admin.Exam.OverallResult.ManageModel
@{
    ViewData["Title"] = "Student Transcript";
    Layout = "_AdminLayout";
}

@* =========================================================================
   PRINT STYLES FOR OFFICIAL TRANSCRIPT
   ========================================================================= *@
<style>
    .print-only { display: none; }

    @@media print {
        /* Hide Admin UI elements completely */
        aside, header, #main-sidebar, .screen-only, .fixed.inset-0 { display: none !important; }

        /* Force pure white A4 print setup */
        body, main, .p-8 {
            padding: 0 !important; margin: 0 !important;
            background-color: white !important; color: black !important;
            height: auto !important; overflow: visible !important;
        }

        /* Force all text to black to save ink and look professional */
        h1, h2, h3, h4, p, span, div, i, td, th {
            color: black !important; text-shadow: none !important;
            -webkit-text-fill-color: black !important;
        }

        .print-only { display: block !important; }

        /* Transcript specific formatting */
        .transcript-container { width: 100%; font-size: 11pt; line-height: 1.4; padding: 20px; }
        .transcript-header { border-bottom: 2px solid black; padding-bottom: 15px; margin-bottom: 20px; text-align: center; }
        .student-details { display: flex; justify-content: space-between; margin-bottom: 25px; font-size: 10pt; }
        .semester-block { break-inside: avoid; margin-bottom: 20px; }

        /* Table overrides */
        table { width: 100%; border-collapse: collapse; margin-bottom: 5px; font-size: 10pt; }
        th { border-bottom: 1px solid black; border-top: 1px solid black; padding: 6px 0; text-align: left; font-weight: bold; }
        td { padding: 4px 0; }
        
        .text-right { text-align: right !important; }
        .text-center { text-align: center !important; }
        .summary-row { border-top: 1px dashed black; font-weight: bold; padding-top: 5px; margin-top: 5px; }

        .print-footer { position: fixed; bottom: 0; width: 100%; text-align: center; font-size: 8pt; border-top: 1px solid #ccc; padding-top: 5px; }
        .page-break { page-break-after: always; }
    }
</style>

<script>
    function printTranscript() {
        window.print();
    }
</script>

@* =========================================================================
   PRINT ONLY: OFFICIAL ACADEMIC TRANSCRIPT
   ========================================================================= *@
<div class="print-only transcript-container">
    <div class="transcript-header">
        <h1 class="text-2xl font-bold uppercase tracking-widest">Ronnie University</h1>
        <h2 class="text-lg font-semibold mt-1">OFFICIAL ACADEMIC TRANSCRIPT</h2>
    </div>

    <div class="student-details">
        <div>
            <p><strong>Student Name:</strong> @Model.TargetStudent?.FullName</p>
            <p><strong>Student ID:</strong> @Model.TargetStudent?.UserId</p>
            <p><strong>IC / Passport No:</strong> @Model.TargetStudent?.IcNumber</p>
        </div>
        <div class="text-right">
            <p><strong>Programme Code:</strong> @Model.TargetStudent?.Programme?.Code</p>
            <p><strong>Programme Level:</strong> @Model.TargetStudent?.Programme?.Level</p>
            <p><strong>Intake Session:</strong> @Model.TargetStudent?.SessionJoined</p>
        </div>
    </div>

    @foreach (var sem in Model.AllSemesters)
    {
        <div class="semester-block">
            <div class="font-bold mb-1 border-b border-black inline-block">Year @sem.YearLevel, Semester @sem.Semester</div>
            <table>
                <thead>
                    <tr>
                        <th style="width: 15%;">Course Code</th>
                        <th style="width: 55%;">Course Title</th>
                        <th style="width: 10%;" class="text-center">Credits</th>
                        <th style="width: 10%;" class="text-center">Grade</th>
                        <th style="width: 10%;" class="text-right">Points</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.SemesterCourses.ContainsKey(sem.Id))
                    {
                        foreach (var cr in Model.SemesterCourses[sem.Id])
                        {
                            <tr>
                                <td>@cr.Course?.Code</td>
                                <td>@cr.Course?.Title</td>
                                <td class="text-center">@cr.Course?.CreditHours</td>
                                <td class="text-center">@cr.Grade?.GradeLabel</td>
                                <td class="text-right">@cr.Grade?.GradePoint.ToString("0.00")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            <div class="summary-row flex justify-between">
                <div>Academic Status: @sem.AcademicStatus</div>
                <div>GPA: @sem.Gpa?.ToString("0.00") &nbsp;&nbsp;|&nbsp;&nbsp; CGPA: @sem.Cgpa?.ToString("0.00")</div>
            </div>
        </div>
    }

    <div class="mt-8 border-2 border-black p-4 text-center font-bold">
        <p>TOTAL CREDITS ATTEMPTED: @Model.TotalCreditsAttempted</p>
        <p>TOTAL CREDITS EARNED: @Model.TotalCreditsEarned</p>
        <p class="mt-2 text-lg">FINAL CUMULATIVE GPA: @Model.FinalCgpa.ToString("0.00")</p>
    </div>

    <div class="print-footer">
        <p>This document is generated electronically and verified by Ronnie University Registry.</p>
        <p>Date Printed: @DateTime.Now.ToString("dd MMM yyyy hh:mm tt")</p>
    </div>
</div>

@* =========================================================================
   DASHBOARD UI (SCREEN ONLY)
   ========================================================================= *@
<div class="screen-only">
    
    <div class="mb-6 flex justify-between items-center">
        <a href="/Admin/Exam/OverallResult/Index" class="text-sm font-medium text-slate-500 hover:text-indigo-600 hover:underline transition-colors">
            &larr; Back to Student Directory
        </a>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 mb-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
        <div>
            <h2 class="text-3xl font-bold text-slate-800 tracking-tight brand-font mb-1">
                @Model.TargetStudent?.FullName
            </h2>
            <div class="flex flex-wrap items-center gap-3 text-sm">
                <span class="px-3 py-1 rounded-md bg-slate-100 border border-slate-200 text-slate-700 font-mono font-bold">@Model.TargetStudent?.UserId</span>
                <span class="px-3 py-1 rounded-md bg-slate-100 border border-slate-200 text-slate-600">@Model.TargetStudent?.Programme?.Code</span>
                <span class="px-3 py-1 rounded-md bg-slate-100 border border-slate-200 text-slate-600">Session: @Model.TargetStudent?.SessionJoined</span>
            </div>
        </div>

        @if (Model.AllSemesters.Any())
        {
            <button onclick="printTranscript()" class="flex items-center justify-center px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl shadow-lg shadow-indigo-600/20 transition-all font-semibold text-sm">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path></svg>
                Print / Download Transcript
            </button>
        }
    </div>

    @if (!Model.AllSemesters.Any())
    {
        <div class="bg-slate-50 border border-dashed border-slate-300 rounded-xl p-12 text-center text-slate-500">
            <svg class="mx-auto h-12 w-12 text-slate-400 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            <h3 class="text-xl font-bold text-slate-700 mb-2">No Results Found</h3>
            <p>This student does not have any recorded semester results yet.</p>
        </div>
    }
    else
    {
        @* Quick Stats *@
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <div class="bg-indigo-50 rounded-xl border border-indigo-100 p-6 flex flex-col items-center justify-center text-center shadow-sm">
                <div class="text-sm font-bold text-indigo-700 uppercase tracking-wide">Final CGPA</div>
                <div class="text-4xl font-black text-indigo-900 mt-2">@Model.FinalCgpa.ToString("0.00")</div>
            </div>
            <div class="bg-white rounded-xl border border-slate-200 p-6 flex flex-col items-center justify-center text-center shadow-sm">
                <div class="text-sm font-bold text-slate-500 uppercase tracking-wide">Credits Attempted</div>
                <div class="text-4xl font-black text-slate-800 mt-2">@Model.TotalCreditsAttempted</div>
            </div>
            <div class="bg-emerald-50 rounded-xl border border-emerald-100 p-6 flex flex-col items-center justify-center text-center shadow-sm">
                <div class="text-sm font-bold text-emerald-700 uppercase tracking-wide">Credits Earned</div>
                <div class="text-4xl font-black text-emerald-900 mt-2">@Model.TotalCreditsEarned</div>
            </div>
        </div>

        @* Timeline View of Semesters *@
        <div class="space-y-6">
            @foreach (var sem in Model.AllSemesters)
            {
                <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm">
                    <div class="bg-slate-50 p-4 border-b border-slate-200 flex flex-wrap justify-between items-center gap-4">
                        <h3 class="font-bold text-lg text-slate-800">
                            Year @sem.YearLevel, Semester @sem.Semester
                        </h3>
                        <div class="flex gap-4 text-sm font-bold">
                            <span class="text-slate-600">GPA: <span class="text-blue-600">@sem.Gpa?.ToString("0.00")</span></span>
                            <span class="text-slate-600">CGPA: <span class="text-indigo-600">@sem.Cgpa?.ToString("0.00")</span></span>
                            <span class="bg-blue-100 text-blue-800 px-3 py-0.5 rounded-md border border-blue-200">@sem.AcademicStatus</span>
                        </div>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-sm">
                            <thead class="bg-white text-slate-500 border-b border-slate-200 text-xs uppercase tracking-wider">
                                <tr>
                                    <th class="px-6 py-3 font-semibold">Course</th>
                                    <th class="px-6 py-3 font-semibold text-center w-24">Credits</th>
                                    <th class="px-6 py-3 font-semibold text-center w-24">Grade</th>
                                    <th class="px-6 py-3 font-semibold text-center w-24">Points</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                @if (Model.SemesterCourses.ContainsKey(sem.Id))
                                {
                                    foreach (var cr in Model.SemesterCourses[sem.Id])
                                    {
                                        <tr class="hover:bg-slate-50 transition-colors">
                                            <td class="px-6 py-4">
                                                <div class="font-bold text-slate-800">@cr.Course?.Code</div>
                                                <div class="text-slate-500">@cr.Course?.Title</div>
                                            </td>
                                            <td class="px-6 py-4 text-center font-mono text-slate-600">@cr.Course?.CreditHours</td>
                                            <td class="px-6 py-4 text-center">
                                                <span class="inline-block bg-slate-100 text-slate-800 font-bold px-3 py-1 rounded border border-slate-200">
                                                    @(cr.Grade?.GradeLabel ?? "-")
                                                </span>
                                            </td>
                                            <td class="px-6 py-4 text-center font-bold text-slate-700">@(cr.Grade?.GradePoint.ToString("0.00") ?? "-")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    }
</div>