@page
@model FYP.Pages.Admin.Exam.OverallResult.IndexModel
@{
    ViewData["Title"] = "Overall Academic Results";
    Layout = "_AdminLayout";
}

<div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 mb-6">
    <div class="mb-6">
        <h2 class="text-xl font-bold text-slate-800">Student Overall Results & Transcripts</h2>
        <p class="text-sm text-slate-500">Filter students to view their entire academic timeline or generate an official transcript.</p>
    </div>

    <form method="get" class="flex flex-wrap gap-4 p-5 bg-slate-50 rounded-xl border border-slate-100 mb-6">
        <div class="flex-1 min-w-[200px]">
            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Programme</label>
            <select asp-for="SearchProgId" asp-items="Model.ProgrammeOptions" class="w-full px-4 py-2 border border-slate-300 rounded-lg text-sm">
                <option value="">All Programmes</option>
            </select>
        </div>
        <div class="w-40">
            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Session</label>
            <select asp-for="SearchSession" asp-items="Model.SessionOptions" class="w-full px-4 py-2 border border-slate-300 rounded-lg text-sm">
                <option value="">All Sessions</option>
            </select>
        </div>
        <div class="w-32">
            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Group</label>
            <select asp-for="SearchGroup" asp-items="Model.GroupOptions" class="w-full px-4 py-2 border border-slate-300 rounded-lg text-sm">
                <option value="">All</option>
            </select>
        </div>
        <div class="flex-1 min-w-[200px]">
            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Search Name / ID</label>
            <input asp-for="SearchName" type="text" placeholder="e.g. John Doe..." class="w-full px-4 py-2 border border-slate-300 rounded-lg text-sm" />
        </div>
        <div class="flex items-end gap-2">
            <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-6 rounded-lg text-sm h-[38px] transition-colors shadow-md">
                Filter
            </button>
            <a href="/Admin/Exam/OverallResult/Index" class="bg-white border border-slate-300 hover:bg-slate-100 text-slate-600 font-bold py-2 px-4 rounded-lg text-sm h-[38px] transition-colors">
                Clear
            </a>
        </div>
    </form>

    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-slate-600">
            <thead class="bg-slate-50 border-b border-slate-200 text-slate-500 uppercase tracking-wider text-xs">
                <tr>
                    <th class="px-4 py-3 font-semibold">Student ID</th>
                    <th class="px-4 py-3 font-semibold">Name</th>
                    <th class="px-4 py-3 font-semibold">Programme</th>
                    <th class="px-4 py-3 font-semibold text-center">Session / Group</th>
                    <th class="px-4 py-3 font-semibold text-center">Current Y/S</th>
                    <th class="px-4 py-3 font-semibold text-right">Action</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @if (Model.Students.Any())
                {
                    @foreach (var student in Model.Students)
                    {
                        <tr class="hover:bg-slate-50 transition">
                            <td class="px-4 py-4 font-mono font-bold text-slate-800">@student.UserId</td>
                            <td class="px-4 py-4 font-medium text-slate-800">@student.FullName</td>
                            <td class="px-4 py-4">@student.Programme?.Code</td>
                            <td class="px-4 py-4 text-center">
                                <span class="bg-slate-100 px-2 py-1 rounded text-xs border border-slate-200">@student.SessionJoined</span>
                                <span class="bg-indigo-50 text-indigo-700 px-2 py-1 rounded text-xs ml-1 border border-indigo-100">@student.TutorialGroup</span>
                            </td>
                            <td class="px-4 py-4 text-center font-bold text-slate-700">Y@(student.YearLevel) / S@(student.Semester)</td>
                            <td class="px-4 py-4 text-right">
                                <a href="/Admin/Exam/OverallResult/Manage?uid=@student.Uid" class="inline-flex items-center px-3 py-1.5 bg-indigo-50 text-indigo-700 hover:bg-indigo-600 hover:text-white rounded-lg font-bold transition-all text-xs border border-indigo-200 shadow-sm">
                                    View Full Transcript &rarr;
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="6" class="px-4 py-8 text-center text-slate-500">No students found matching your criteria.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>