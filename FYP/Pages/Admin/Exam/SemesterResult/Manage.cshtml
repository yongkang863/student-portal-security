@page
@model FYP.Pages.Admin.Exam.SemesterResult.ManageModel
@{
    ViewData["Title"] = "Manage Student Results";
    Layout = "_AdminLayout";
}

@if (Model.SuccessMessage != null)
{
    <div class="mb-6 p-4 bg-emerald-50 text-emerald-700 border-l-4 border-emerald-500 rounded-r-lg shadow-sm flex items-center">
        <svg class="w-5 h-5 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
        @Model.SuccessMessage
    </div>
}
@if (Model.ErrorMessage != null)
{
    <div class="mb-6 p-4 bg-rose-50 text-rose-700 border-l-4 border-rose-500 rounded-r-lg shadow-sm flex items-center">
        <svg class="w-5 h-5 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
        @Model.ErrorMessage
    </div>
}

@if (!Model.IsEditable && Model.Student != null)
{
    <div class="mb-6 p-4 bg-amber-50 text-amber-800 border-l-4 border-amber-500 rounded-r-lg shadow-sm flex items-center">
        <svg class="w-6 h-6 mr-3 flex-shrink-0 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
        <div>
            <strong class="font-bold">Read-Only View Active:</strong>
            <span class="block sm:inline"> You can only modify results for the student's current term (Y@(Model.Student.YearLevel) S@(Model.Student.Semester)) or previous term.</span>
        </div>
    </div>
}

<div class="mb-4 flex justify-between items-center">
    <a href="/Admin/Exam/SemesterResult/Index" class="text-sm font-medium text-slate-500 hover:text-blue-600 hover:underline transition-colors">
        &larr; Back to Student List
    </a>
</div>

<div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 mb-6 flex flex-col md:flex-row justify-between md:items-center gap-6">
    <div>
        <h2 class="text-2xl font-bold text-slate-800 font-serif">@Model.Student?.FullName</h2>
        <div class="mt-2 flex flex-wrap gap-3 text-sm text-slate-500 font-medium">
            <span class="bg-slate-100 px-3 py-1 rounded-md border border-slate-200">ID: @Model.Student?.UserId</span>
            <span class="bg-slate-100 px-3 py-1 rounded-md border border-slate-200">Prog: @Model.Student?.Programme?.Code</span>
            <span class="bg-slate-100 px-3 py-1 rounded-md border border-slate-200">Session: @Model.Student?.SessionJoined</span>
        </div>
    </div>

    <div class="bg-indigo-50 p-4 rounded-xl border border-indigo-100 min-w-[250px]">
        <label class="block text-xs font-bold text-indigo-800 uppercase tracking-wider mb-2">Select Term</label>
        <select id="termSelector" onchange="changeTerm()" class="w-full px-4 py-2 border border-indigo-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none font-bold text-indigo-900">
            @foreach (var opt in Model.TermOptions)
            {
                if (opt.Selected)
                {
                    <option value="@opt.Value" selected>@opt.Text</option>
                }
                else
                {
                    <option value="@opt.Value">@opt.Text</option>
                }
            }
        </select>
    </div>
</div>

<form method="post" asp-page-handler="SaveResults" class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
    <input type="hidden" asp-for="Uid" />
    <input type="hidden" asp-for="TargetYear" />
    <input type="hidden" asp-for="TargetSem" />

    <div class="p-6 bg-slate-50 border-b border-slate-200 flex justify-between items-center">
        <div>
            <h3 class="text-lg font-bold text-slate-800">Result Entry - Year @Model.TargetYear, Sem @Model.TargetSem</h3>
            <p class="text-sm text-slate-500 mt-1">Subjects automatically loaded based on programme structure.</p>
        </div>

        @if (Model.CurrentSemesterResult != null)
        {
            <div class="flex gap-4">
                <div class="text-right">
                    <div class="text-xs text-slate-500 font-bold uppercase tracking-wider">Semester GPA</div>
                    <div class="text-xl font-black text-blue-600">@Model.CurrentSemesterResult.Gpa?.ToString("0.00")</div>
                </div>
                <div class="text-right pl-4 border-l border-slate-300">
                    <div class="text-xs text-slate-500 font-bold uppercase tracking-wider">Overall CGPA</div>
                    <div class="text-xl font-black text-indigo-600">@Model.CurrentSemesterResult.Cgpa?.ToString("0.00")</div>
                </div>
            </div>
        }
    </div>

    @if (!Model.CourseInputs.Any())
    {
        <div class="p-12 text-center text-slate-500">
            <svg class="mx-auto h-12 w-12 text-slate-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <p>No subjects found for this specific Year and Semester in the Programme Structure.</p>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-slate-600">
                <thead class="bg-white border-b border-slate-200 text-slate-500 uppercase tracking-wider text-xs">
                    <tr>
                        <th class="px-6 py-4 font-semibold w-32">Course Code</th>
                        <th class="px-6 py-4 font-semibold">Course Title</th>
                        <th class="px-6 py-4 font-semibold text-center w-24">Credits</th>
                        <th class="px-6 py-4 font-semibold w-48 text-right">Assign Grade</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @for (int i = 0; i < Model.CourseInputs.Count; i++)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <input type="hidden" asp-for="CourseInputs[i].CourseId" />
                            <input type="hidden" asp-for="CourseInputs[i].CreditHours" />
                            
                            <td class="px-6 py-4 font-bold text-indigo-700">@Model.CourseInputs[i].CourseCode</td>
                            <td class="px-6 py-4 font-medium text-slate-800">@Model.CourseInputs[i].CourseTitle</td>
                            <td class="px-6 py-4 text-center font-mono bg-slate-50">@Model.CourseInputs[i].CreditHours</td>
                            <td class="px-6 py-4 text-right">
                                <select asp-for="CourseInputs[i].SelectedGradeId" asp-items="Model.GradeOptions"
                                        disabled="@(!Model.IsEditable)"
                                        class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 outline-none font-bold disabled:bg-slate-100 disabled:text-slate-400 disabled:cursor-not-allowed">
                                    <option value="">-- No Grade --</option>
                                </select>
                                @if (!Model.IsEditable && Model.CourseInputs[i].SelectedGradeId.HasValue)
                                {
                                    <input type="hidden" asp-for="CourseInputs[i].SelectedGradeId" />
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.IsEditable)
        {
            <div class="px-6 py-4 bg-slate-50 border-t border-slate-200 flex justify-end gap-3">
                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2.5 px-8 rounded-lg shadow-md transition-all flex items-center gap-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"></path></svg>
                    Calculate & Save Results
                </button>
            </div>
        }
    }
</form>

@section Scripts {
    <script>
        function changeTerm() {
            const selector = document.getElementById('termSelector');
            const val = selector.value.split('-'); // Splits "Year-Sem"
            if(val.length === 2) {
                window.location.href = `/Admin/Exam/SemesterResult/Manage?uid=@Model.Uid&targetYear=${val[0]}&targetSem=${val[1]}`;
            }
        }
    </script>
}