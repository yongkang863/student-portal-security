@page
@model FYP.Pages.Admin.Exam.Timetable.ManageModel
@{
    ViewData["Title"] = "Manage Exam Slots";
    Layout = "_AdminLayout";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">

@if (Model.SuccessMessage != null)
{
    <div class="mb-4 p-4 bg-emerald-50 text-emerald-700 border-l-4 border-emerald-500 rounded-r-lg shadow-sm flex items-center">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
        @Model.SuccessMessage
    </div>
}
@if (Model.ErrorMessage != null)
{
    <div class="mb-4 p-4 bg-rose-50 text-rose-700 border-l-4 border-rose-500 rounded-r-lg shadow-sm flex items-center">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
        @Model.ErrorMessage
    </div>
}

<div class="mb-4 flex justify-between items-center">
    <a href="/Admin/Exam/Timetable/Index" class="text-sm font-medium text-slate-500 hover:text-blue-600 hover:underline transition-colors">
        &larr; Back to Schedules
    </a>
</div>

<div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 mb-8">
    <div class="flex flex-col md:flex-row justify-between items-start gap-4">
        <div>
            <h2 class="text-2xl font-bold text-slate-800 brand-font">@Model.Schedule?.Programme?.Name</h2>
            <div class="mt-2 flex flex-wrap gap-3 text-sm text-slate-500 font-medium">
                <span class="bg-slate-100 px-3 py-1 rounded-md border border-slate-200">Code: @Model.Schedule?.Programme?.Code</span>
                <span class="bg-slate-100 px-3 py-1 rounded-md border border-slate-200">Session: @Model.Schedule?.SessionJoined</span>
                <span class="bg-slate-100 px-3 py-1 rounded-md border border-slate-200 font-bold text-blue-700">Target Students: @Model.TotalStudents</span>
                <span class="px-3 py-1 rounded-md border @(Model.Schedule?.Status == "Published" ? "bg-emerald-50 text-emerald-700 border-emerald-200" : "bg-amber-50 text-amber-700 border-amber-200")">
                    Status: @Model.Schedule?.Status
                </span>
            </div>
        </div>
        
        <div class="flex gap-3">
            <form method="post" asp-page-handler="AutoAssignSeats" asp-route-id="@Model.Id">
                <button type="submit" onclick="return confirm('This will assign seats alphabetically to all @Model.TotalStudents students. Proceed?');"
                        class="flex items-center px-4 py-2 bg-indigo-600 text-white font-bold rounded-lg hover:bg-indigo-700 transition shadow-md">
                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                    Auto Assign Seats
                </button>
            </form>

            @if (Model.Schedule?.Status == "Published")
            {
                <form method="post" asp-page-handler="UnpublishSchedule" asp-route-id="@Model.Id">
                    <button type="submit" onclick="return confirm('Students will no longer be able to see this schedule. Continue?');" class="flex items-center px-4 py-2 bg-amber-500 text-white font-bold rounded-lg hover:bg-amber-600 transition shadow-md">
                        Unpublish
                    </button>
                </form>
            }
            else
            {
                <form method="post" asp-page-handler="PublishSchedule" asp-route-id="@Model.Id">
                    <button type="submit" class="flex items-center px-4 py-2 bg-emerald-600 text-white font-bold rounded-lg hover:bg-emerald-700 transition shadow-md">
                        Publish Schedule
                    </button>
                </form>
            }
        </div>
    </div>
</div>

<div class="flex justify-between items-center mb-6">
    <h3 class="text-xl font-bold text-slate-800">Exam Slots</h3>
    <button onclick="openSlotModal('add')" class="px-5 py-2.5 bg-slate-900 text-white font-bold text-sm rounded-xl hover:bg-slate-800 transition shadow-lg">
        + Add Exam Slot
    </button>
</div>

@if (!Model.Slots.Any())
{
    <div class="text-center py-12 bg-white rounded-2xl border border-dashed border-slate-300">
        <p class="text-slate-500">No exam slots have been added yet.</p>
    </div>
}
else
{
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
        @foreach (var slot in Model.Slots)
        {
            <div class="bg-white rounded-2xl border border-slate-200 p-6 hover:shadow-xl hover:border-blue-300 transition-all flex flex-col">
                <div class="flex justify-between items-start mb-4">
                    <span class="text-xs font-bold px-3 py-1 bg-blue-50 text-blue-700 border border-blue-100 rounded-lg uppercase tracking-wide">
                        @slot.Course?.Code
                    </span>
                    <div class="flex gap-2">
                        <button onclick="openSlotModal('edit', @slot.Id, '@slot.CourseId', '@slot.ExamDate.ToString("yyyy-MM-dd")', '@slot.StartTime.ToString("HH:mm")', '@slot.EndTime.ToString("HH:mm")', '@slot.VenueId', @slot.MaxCapacity)" class="text-slate-400 hover:text-blue-600 transition">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                        </button>
                        <form method="post" asp-page-handler="DeleteSlot" asp-route-id="@Model.Id" class="inline" onsubmit="return confirm('Are you sure you want to delete this slot? All assigned seats will be lost.');">
                            <input type="hidden" name="slotId" value="@slot.Id" />
                            <button type="submit" class="text-slate-400 hover:text-red-600 transition">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                            </button>
                        </form>
                    </div>
                </div>
                
                <h4 class="font-bold text-slate-800 text-lg leading-tight mb-5 flex-1">@slot.Course?.Title</h4>
                
                <div class="space-y-3 text-sm text-slate-600 bg-slate-50 p-4 rounded-xl border border-slate-100">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-full bg-white flex items-center justify-center border border-slate-200 shadow-sm"><svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg></div>
                        <span class="font-medium">@slot.ExamDate.ToString("dd/MM/yyyy")</span>
                    </div>
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-full bg-white flex items-center justify-center border border-slate-200 shadow-sm"><svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></div>
                        <span class="font-medium">@slot.StartTime.ToString("hh:mm tt") - @slot.EndTime.ToString("hh:mm tt")</span>
                    </div>
                </div>
                
                <div class="mt-4 pt-4 border-t border-slate-100 flex justify-between items-center text-xs font-bold uppercase tracking-wider text-slate-500">
                    <span>Capacity: @slot.MaxCapacity</span>
                    <span>Available: <span class="@(slot.SeatAvailable < 5 ? "text-rose-600" : "text-emerald-600")">@slot.SeatAvailable</span></span>
                </div>
            </div>
        }
    </div>
}

@if (Model.AssignedSeats.Any())
{
    <div class="mt-12 mb-6">
        <h3 class="text-xl font-bold text-slate-800 mb-6">Assigned Student Seats (Grouped by Course)</h3>
        
        @foreach (var slot in Model.Slots)
        {
            var slotSeats = Model.AssignedSeats.Where(s => s.ExamSlotId == slot.Id).ToList();
            
            if (slotSeats.Any())
            {
                <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden mb-8">
                    <div class="bg-indigo-50 px-6 py-4 border-b border-indigo-100 flex flex-col md:flex-row md:justify-between md:items-center gap-4">
                        <div>
                            <h4 class="font-bold text-indigo-900 text-lg">@slot.Course?.Code - @slot.Course?.Title</h4>
                            <div class="text-sm text-indigo-700 mt-1 flex flex-wrap gap-x-4 gap-y-1">
                                <span class="flex items-center gap-1">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                                    @slot.ExamDate.ToString("dd/MM/yyyy")
                                </span>
                                <span class="flex items-center gap-1">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                    @slot.StartTime.ToString("hh:mm tt") - @slot.EndTime.ToString("hh:mm tt")
                                </span>
                                <span class="flex items-center gap-1">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                                    @(slot.Venue?.Name ?? "TBA")
                                </span>
                            </div>
                        </div>
                        <div class="bg-white px-4 py-1.5 rounded-lg border border-indigo-200 text-indigo-700 font-bold text-sm shadow-sm whitespace-nowrap">
                            Total Students: @slotSeats.Count
                        </div>
                    </div>
                    
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-sm">
                            <thead class="bg-slate-50 text-slate-500 border-b border-slate-200 uppercase tracking-wider text-xs">
                                <tr>
                                    <th class="px-6 py-3 font-semibold w-32">Seat Number</th>
                                    <th class="px-6 py-3 font-semibold w-48">Student ID</th>
                                    <th class="px-6 py-3 font-semibold">Student Name</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                @foreach (var seat in slotSeats)
                                {
                                    <tr class="hover:bg-slate-50 transition-colors">
                                        <td class="px-6 py-3">
                                            <span class="px-3 py-1 bg-indigo-100 text-indigo-800 font-bold rounded-lg border border-indigo-200 block text-center">
                                                @seat.SeatNumber
                                            </span>
                                        </td>
                                        <td class="px-6 py-3 font-mono text-slate-500">@seat.Student?.UserId</td>
                                        <td class="px-6 py-3 font-medium text-slate-800">@seat.Student?.FullName</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }
    </div>
}

<div id="slotModal" class="fixed inset-0 z-[100] hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm transition-opacity opacity-0" id="slotBackdrop"></div>
    <div class="fixed inset-0 z-10 w-screen overflow-y-auto">
        <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
            <div class="relative transform overflow-hidden rounded-2xl bg-white text-left shadow-2xl transition-all sm:my-8 sm:w-full sm:max-w-xl opacity-0 scale-95" id="slotPanel">
                
                <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center bg-slate-50">
                    <h3 class="text-lg font-bold text-slate-800" id="modalTitle">Add Exam Slot</h3>
                    <button type="button" onclick="closeSlotModal()" class="text-slate-400 hover:text-slate-600">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                    </button>
                </div>

                <form id="slotForm" method="post" asp-route-id="@Model.Id" class="p-6">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="Input.SlotId" id="inputSlotId" />

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                        <div class="md:col-span-2">
                            <label class="block text-sm font-bold text-slate-700 mb-1">Course</label>
                            <select asp-for="Input.CourseId" asp-items="Model.CourseOptions" id="inputCourseId" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none">
                                <option value="">Select Course...</option>
                            </select>
                            <span asp-validation-for="Input.CourseId" class="text-xs text-red-500 mt-1 block"></span>
                        </div>

                        <div>
                            <label class="block text-sm font-bold text-slate-700 mb-1">Exam Date (DD/MM/YYYY)</label>
                            <input type="text" asp-for="Input.ExamDate" id="inputExamDate" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none bg-white" placeholder="Select Date..." />
                            <span asp-validation-for="Input.ExamDate" class="text-xs text-red-500 mt-1 block"></span>
                        </div>
                        
                        <div>
                            <label class="block text-sm font-bold text-slate-700 mb-1">Venue</label>
                            <select asp-for="Input.VenueId" asp-items="Model.VenueOptions" id="inputVenueId" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none">
                                <option value="">Select Venue...</option>
                            </select>
                            <span asp-validation-for="Input.VenueId" class="text-xs text-red-500 mt-1 block"></span>
                        </div>

                        <div>
                            <label class="block text-sm font-bold text-slate-700 mb-1">Start Time</label>
                            <select asp-for="Input.StartTime" asp-items="Model.TimeOptions" id="inputStartTime" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none">
                                <option value="">Select Time...</option>
                            </select>
                            <span asp-validation-for="Input.StartTime" class="text-xs text-red-500 mt-1 block"></span>
                        </div>

                        <div>
                            <label class="block text-sm font-bold text-slate-700 mb-1">End Time</label>
                            <select asp-for="Input.EndTime" asp-items="Model.TimeOptions" id="inputEndTime" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none">
                                <option value="">Select Time...</option>
                            </select>
                            <span asp-validation-for="Input.EndTime" class="text-xs text-red-500 mt-1 block"></span>
                        </div>

                        <div class="md:col-span-2">
                            <label class="block text-sm font-bold text-slate-700 mb-1">Maximum Seat Capacity</label>
                            <input type="number" asp-for="Input.MaxCapacity" id="inputCapacity" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none" />
                            <span asp-validation-for="Input.MaxCapacity" class="text-xs text-red-500 mt-1 block"></span>
                            
                            <div class="mt-2 p-3 bg-blue-50 border border-blue-100 rounded-lg flex items-start gap-2 text-sm text-blue-800">
                                <svg class="w-5 h-5 flex-shrink-0 mt-0.5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                <div>
                                    <strong>Recommendation:</strong> Ensure the capacity is at least <strong>@Model.TotalStudents</strong> to accommodate all enrolled students.
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-6 flex justify-end gap-3 pt-4 border-t border-slate-100">
                        <button type="button" onclick="closeSlotModal()" class="px-4 py-2 text-slate-600 font-bold hover:bg-slate-100 rounded-lg transition-colors">Cancel</button>
                        
                        <button type="submit" asp-page-handler="AddSlot" id="btnAddSlot" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-6 rounded-lg shadow-md transition-all">
                            Save Slot
                        </button>
                        <button type="submit" asp-page-handler="EditSlot" id="btnEditSlot" class="hidden bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-6 rounded-lg shadow-md transition-all">
                            Update Slot
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

    <script>
        const slotModal = document.getElementById('slotModal');
        const slotBackdrop = document.getElementById('slotBackdrop');
        const slotPanel = document.getElementById('slotPanel');
        const modalTitle = document.getElementById('modalTitle');
        const btnAddSlot = document.getElementById('btnAddSlot');
        const btnEditSlot = document.getElementById('btnEditSlot');

        const inputSlotId = document.getElementById('inputSlotId');
        const inputCourseId = document.getElementById('inputCourseId');
        const inputStartTime = document.getElementById('inputStartTime');
        const inputEndTime = document.getElementById('inputEndTime');
        const inputVenueId = document.getElementById('inputVenueId');
        const inputCapacity = document.getElementById('inputCapacity');
        
        let fpInstance;

        document.addEventListener('DOMContentLoaded', function() {
        // Initialize Flatpickr to FORCE the DD/MM/YYYY visual format, while keeping standard submission format
        fpInstance = flatpickr("#inputExamDate", {
        altInput: true,
        altFormat: "d/m/Y",  // Displays nicely to the user as DD/MM/YYYY
        dateFormat: "Y-m-d", // Sends properly to the C# backend DateOnly property
        minDate: "today"     // Prevents user from clicking dates in the past
        });
        });

        function openSlotModal(mode, id = '', course = '', date = '', start = '', end = '', venue = '', capacity = '') {
        document.getElementById('slotForm').reset();
            
        document.querySelectorAll('.field-validation-error').forEach(el => {
        el.innerHTML = '';
        });
            
        if (mode === 'edit') {
        modalTitle.innerText = 'Edit Exam Slot';
        btnAddSlot.classList.add('hidden');
        btnEditSlot.classList.remove('hidden');
                
        inputSlotId.value = id;
        inputCourseId.value = course;
        inputStartTime.value = start;
        inputEndTime.value = end;
        inputVenueId.value = venue;
        inputCapacity.value = capacity || @Model.TotalStudents;
                
        // Set the Flatpickr date to the existing record
        fpInstance.setDate(date);
        } else {
        modalTitle.innerText = 'Add Exam Slot';
        btnAddSlot.classList.remove('hidden');
        btnEditSlot.classList.add('hidden');
                
        inputSlotId.value = '';
        inputCapacity.value = @Model.TotalStudents;

        // Set Flatpickr to current date by default
        const today = new Date();
        const offset = today.getTimezoneOffset() * 60000;
        const localISOTime = (new Date(today - offset)).toISOString().slice(0, 10);
        fpInstance.setDate(localISOTime);
        }

        showModalUI();
        }

        function closeSlotModal() {
        slotBackdrop.classList.add('opacity-0');
        slotPanel.classList.add('opacity-0', 'scale-95');
        setTimeout(() => {
        slotModal.classList.add('hidden');
        }, 300);
        }

        function showModalUI() {
        slotModal.classList.remove('hidden');
        setTimeout(() => {
        slotBackdrop.classList.remove('opacity-0');
        slotPanel.classList.remove('opacity-0', 'scale-95');
        }, 10);
        }
    </script>

    @if (ViewData["KeepModalOpen"] != null && (bool)ViewData["KeepModalOpen"] == true)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function() {
            const mode = '@ViewData["ModalMode"]';
                
            if (mode === 'edit') {
            modalTitle.innerText = 'Edit Exam Slot';
            btnAddSlot.classList.add('hidden');
            btnEditSlot.classList.remove('hidden');
            } else {
            modalTitle.innerText = 'Add Exam Slot';
            btnAddSlot.classList.remove('hidden');
            btnEditSlot.classList.add('hidden');
            }
                
            // Flatpickr automatically preserves the user's invalid submitted value during postbacks
            showModalUI();
            });
        </script>
    }
}