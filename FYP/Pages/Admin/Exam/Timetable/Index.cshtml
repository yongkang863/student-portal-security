@page
@model FYP.Pages.Admin.Exam.Timetable.IndexModel
@{
    ViewData["Title"] = "Manage Exam Schedules";
    Layout = "_AdminLayout";
}

@if (Model.SuccessMessage != null)
{
    <div class="mb-6 p-4 bg-emerald-50 text-emerald-700 border-l-4 border-emerald-500 rounded-r-lg shadow-sm flex items-center">
        <svg class="w-5 h-5 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
        @Model.SuccessMessage
    </div>
}
@if (Model.ErrorMessage != null)
{
    <div class="mb-6 p-4 bg-rose-50 text-rose-700 border-l-4 border-rose-500 rounded-r-lg shadow-sm flex items-center">
        <svg class="w-5 h-5 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
        @Model.ErrorMessage
    </div>
}

<div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6">
        <div>
            <h2 class="text-xl font-bold text-slate-800">Examination Schedules</h2>
            <p class="text-sm text-slate-500">Filter and manage exam timetables for student cohorts.</p>
        </div>
        <a href="/Admin/Exam/Timetable/Create" class="px-5 py-2.5 bg-blue-600 text-white font-bold rounded-xl hover:bg-blue-700 transition shadow-lg shadow-blue-600/20 flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
            New Schedule
        </a>
    </div>

    <form method="get" class="flex flex-col md:flex-row gap-4 p-5 bg-slate-50 rounded-xl border border-slate-100 mb-8">
        <div class="flex-1">
            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Filter by Programme</label>
            <select asp-for="SearchProgId" asp-items="Model.ProgrammeOptions" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none text-sm font-medium">
                <option value="">All Programmes</option>
            </select>
        </div>
        <div class="w-full md:w-56">
            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Filter by Session</label>
            <select asp-for="SearchSession" asp-items="Model.SessionOptions" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none text-sm font-medium">
                <option value="">All Sessions</option>
            </select>
        </div>
        <div class="flex items-end gap-2">
            <button type="submit" class="bg-slate-800 hover:bg-slate-900 text-white font-bold py-2 px-6 rounded-lg shadow-md transition-all text-sm h-[38px]">
                Filter Data
            </button>
            @if (Model.SearchProgId.HasValue || Model.SearchSession.HasValue)
            {
                <a href="/Admin/Exam/Timetable/Index" class="bg-white border border-slate-300 hover:bg-slate-100 text-slate-600 font-bold py-2 px-4 rounded-lg shadow-sm transition-all text-sm h-[38px] flex items-center">
                    Clear
                </a>
            }
        </div>
    </form>

    <form method="post" asp-page-handler="DeleteSelected" id="bulkDeleteForm">
        
        <div id="bulkActionsBar" class="hidden mb-4 p-3 bg-red-50 border border-red-200 rounded-xl flex justify-between items-center transition-all animate-fade-in-up">
            <span class="text-sm font-bold text-red-800 flex items-center gap-2">
                <span class="bg-white text-red-600 px-2 py-0.5 rounded-md border border-red-200" id="selectedCount">0</span> schedules selected
            </span>
            <button type="submit" onclick="return confirm('WARNING: Are you sure you want to delete these schedules? ALL associated slots and student seat assignments will be permanently deleted.');" class="bg-red-600 hover:bg-red-700 text-white text-sm font-bold py-1.5 px-4 rounded-lg shadow-md flex items-center gap-2 transition">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                Delete Selected
            </button>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-slate-600">
                <thead class="bg-slate-50 border-b border-slate-200 text-slate-500 uppercase tracking-wider text-xs">
                    <tr>
                        <th class="px-4 py-3 font-semibold text-center w-12">
                            <input type="checkbox" id="selectAllCb" class="w-4 h-4 text-blue-600 rounded border-slate-300 focus:ring-blue-500 cursor-pointer" />
                        </th>
                        <th class="px-4 py-3 font-semibold">Programme</th>
                        <th class="px-4 py-3 font-semibold text-center">Session Joined</th>
                        <th class="px-4 py-3 font-semibold text-center">Status</th>
                        <th class="px-4 py-3 font-semibold">Last Updated</th>
                        <th class="px-4 py-3 font-semibold text-right">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (Model.Schedules.Any())
                    {
                        @foreach (var schedule in Model.Schedules)
                        {
                            <tr class="hover:bg-slate-50 transition">
                                <td class="px-4 py-4 text-center">
                                    <input type="checkbox" name="SelectedSchedules" value="@schedule.Id" class="schedule-cb w-4 h-4 text-blue-600 rounded border-slate-300 focus:ring-blue-500 cursor-pointer" />
                                </td>
                                <td class="px-4 py-4 font-medium text-slate-800">
                                    @schedule.Programme?.Code - @schedule.Programme?.Name
                                </td>
                                <td class="px-4 py-4 text-center font-mono">@schedule.SessionJoined</td>
                                <td class="px-4 py-4 text-center">
                                    <span class="px-2.5 py-1 rounded-full text-xs font-bold uppercase tracking-wide
                                        @(schedule.Status == "Published" ? "bg-emerald-100 text-emerald-800 border border-emerald-200" : "bg-amber-100 text-amber-800 border border-amber-200")">
                                        @schedule.Status
                                    </span>
                                </td>
                                <td class="px-4 py-4 text-xs text-slate-500">@(schedule.LastUpdated?.ToString("dd MMM yyyy, hh:mm tt") ?? "Never")</td>
                                <td class="px-4 py-4 text-right">
                                    <a href="/Admin/Exam/Timetable/Manage?id=@schedule.Id" class="inline-flex items-center px-3 py-1.5 bg-white border border-slate-300 rounded-lg text-blue-600 hover:text-blue-800 hover:bg-blue-50 font-bold shadow-sm transition-all text-xs">
                                        Manage Slots <span aria-hidden="true" class="ml-1">&rarr;</span>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="px-4 py-8 text-center text-slate-500">
                                No exam schedules found matching your criteria.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const selectAllCb = document.getElementById('selectAllCb');
            const checkboxes = document.querySelectorAll('.schedule-cb');
            const bulkActionsBar = document.getElementById('bulkActionsBar');
            const selectedCountSpan = document.getElementById('selectedCount');

            // Function to recount and show/hide the red delete bar
            function updateBulkActions() {
                const checkedCount = document.querySelectorAll('.schedule-cb:checked').length;
                selectedCountSpan.innerText = checkedCount;

                if (checkedCount > 0) {
                    bulkActionsBar.classList.remove('hidden');
                } else {
                    bulkActionsBar.classList.add('hidden');
                    if(selectAllCb) selectAllCb.checked = false; // Uncheck 'select all' if everything is manually unchecked
                }
            }

            // Select All Logic
            if (selectAllCb) {
                selectAllCb.addEventListener('change', function (e) {
                    checkboxes.forEach(cb => {
                        cb.checked = e.target.checked;
                    });
                    updateBulkActions();
                });
            }

            // Individual Checkbox Logic
            checkboxes.forEach(cb => {
                cb.addEventListener('change', updateBulkActions);
            });
        });
    </script>
}