@page
@model FYP.Pages.Admin.Announcements.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Manage Announcements";
}

<div class="space-y-6">

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold font-serif text-slate-800">Announcements</h1>
            <p class="text-sm text-slate-500 mt-1">Manage news and updates for the university portal.</p>
        </div>

        <a href="/Admin/Announcements/Create" class="inline-flex items-center justify-center bg-blue-600 hover:bg-blue-700 text-white font-bold py-2.5 px-6 rounded-xl shadow-lg transition-all hover:-translate-y-0.5">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
            New Announcement
        </a>
    </div>

    @if (Model.AnnouncementList.Any())
    {
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
            @foreach (var item in Model.AnnouncementList)
            {
                <div class="bg-white rounded-2xl shadow-sm border border-slate-200 flex flex-col hover:shadow-md transition-shadow group">
                    <div class="p-5 border-b border-slate-100 flex justify-between items-start">
                        <div class="space-y-1">
                            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">
                                @item.PublishDate.ToString("MMM dd, yyyy")
                            </span>
                            <h3 class="text-lg font-bold text-slate-800 line-clamp-2 leading-tight group-hover:text-blue-600 transition-colors">
                                @item.Title
                            </h3>
                        </div>

                        @if (item.TargetRole == "All")
                        {
                            <span class="bg-purple-100 text-purple-700 text-[10px] font-bold px-2 py-1 rounded-full uppercase">All Users</span>
                        }
                        else if (item.TargetRole == "Staff")
                        {
                            <span class="bg-blue-100 text-blue-700 text-[10px] font-bold px-2 py-1 rounded-full uppercase">Staff Only</span>
                        }
                        else
                        {
                            <span class="bg-emerald-100 text-emerald-700 text-[10px] font-bold px-2 py-1 rounded-full uppercase">Students</span>
                        }
                    </div>

                    <div class="p-5 flex-1">
                        <p class="text-slate-600 text-sm line-clamp-3">
                            @{
                                // SECURITY FIX: Safely encode the string to prevent XSS, then replace newlines with line breaks
                                var safeDescription = System.Net.WebUtility.HtmlEncode(item.Description).Replace("\n", "<br/>");
                            }
                            @Html.Raw(safeDescription)
                        </p>
                    </div>

                    <div class="p-4 bg-slate-50 border-t border-slate-100 rounded-b-2xl flex justify-between items-center">
                        <div class="flex items-center gap-2">
                            <div class="w-6 h-6 rounded-full bg-slate-200 flex items-center justify-center text-xs font-bold text-slate-500">
                                @(item.Admin?.FullName?.Substring(0, 1) ?? "A")
                            </div>
                            <span class="text-xs text-slate-500 font-medium truncate max-w-[100px]">
                                @(item.Admin?.FullName ?? "Admin")
                            </span>
                        </div>

                        <div class="flex items-center gap-1">
                            <a href="/Admin/Announcements/Edit?id=@item.Id"
                                   class="p-2 text-slate-400 hover:text-blue-600 hover:bg-blue-50 rounded-lg transition-all"
                                   title="Modify Announcement">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                            </a>

                            <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" onsubmit="return confirm('Are you sure you want to delete this announcement? This action cannot be undone.');">
                                <button type="submit" class="p-2 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-all" title="Delete Announcement">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-20 bg-white rounded-2xl border border-dashed border-slate-300">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-slate-100 mb-4 text-slate-400">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"></path></svg>
            </div>
            <h3 class="text-lg font-bold text-slate-800">No Announcements Yet</h3>
            <p class="text-slate-500 text-sm max-w-xs mx-auto mt-1 mb-6">Create your first update to notify staff and students.</p>
            <a href="/Admin/Announcements/Create" class="text-blue-600 font-bold hover:underline">Create Now &rarr;</a>
        </div>
    }
</div>