@page
@model FYP.Pages.Admin.Announcements.EditModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Modify Announcement";
}

<div class="max-w-3xl mx-auto">

    <div class="mb-6 flex justify-between items-end">
        <div>
            <h1 class="text-2xl font-bold font-serif text-slate-800">Modify Announcement</h1>
            <p class="text-sm text-slate-500">Update content or correct mistakes.</p>
        </div>
        <a href="/Admin/Announcements/Index" class="text-sm text-slate-500 hover:text-slate-800 hover:underline">Cancel</a>
    </div>

    <form method="post" enctype="multipart/form-data" class="bg-white p-8 rounded-xl shadow-sm border border-slate-200 space-y-6">

        <input type="hidden" asp-for="AnnouncementId" />

        <div>
            <label class="block text-sm font-bold text-slate-700 mb-1">Title</label>
            <input asp-for="Input.Title" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none font-bold" />
            <span asp-validation-for="Input.Title" class="text-xs text-red-500"></span>
        </div>

        <div>
            <label class="block text-sm font-bold text-slate-700 mb-1">Target Audience</label>
            <select asp-for="Input.TargetRole" asp-items="Model.TargetOptions" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none bg-slate-50"></select>
        </div>

        <div>
            <label class="block text-sm font-bold text-slate-700 mb-1">Content</label>
            <textarea asp-for="Input.Description" rows="8" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none"></textarea>
            <span asp-validation-for="Input.Description" class="text-xs text-red-500"></span>
        </div>

        <div class="p-5 border border-dashed border-slate-300 rounded-xl bg-slate-50">
            <label class="block text-sm font-bold text-slate-700 mb-2">Update Attachment (Optional)</label>
            <input type="file" asp-for="Input.UploadedFile" accept=".pdf, .png, .jpg, .jpeg" class="block w-full text-sm text-slate-500 file:mr-4 file:py-2.5 file:px-5 file:rounded-xl file:border-0 file:text-sm file:font-bold file:bg-blue-100 file:text-blue-700 hover:file:bg-blue-200 transition-all cursor-pointer" />
            <p class="text-xs text-slate-400 mt-2">Uploading a new file will replace the old one. Accepted formats: PDF, PNG, JPG.</p>
            <span asp-validation-for="Input.UploadedFile" class="text-red-500 text-xs mt-1 block"></span>
        </div>

        <div class="flex justify-end pt-4 gap-3">
            <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-6 rounded-lg shadow-md transition-all flex items-center gap-2">
                Save Changes
            </button>
        </div>
    </form>
</div>