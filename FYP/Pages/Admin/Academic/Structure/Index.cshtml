@page
@model FYP.Pages.Admin.Academic.Structure.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Programme Structure Directory";
}

<div class="space-y-6">

    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold font-serif text-slate-800">Programme Structures</h1>
            <p class="text-sm text-slate-500 mt-1">View and manage academic configurations by session intake.</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="p-4 bg-green-50 text-green-700 rounded-xl border border-green-200 flex items-center shadow-sm">
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            @Model.SuccessMessage
        </div>
    }

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        
        <div class="lg:col-span-2 bg-white rounded-xl shadow-sm border border-slate-200 p-6">
            <h3 class="font-bold text-slate-800 mb-4 border-b border-slate-100 pb-2">View Existing Structure</h3>
            <form method="get" class="grid grid-cols-1 md:grid-cols-5 gap-4 items-end">
                <div class="md:col-span-2">
                    <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Programme</label>
                    <select asp-for="ProgId" asp-items="Model.ProgrammeOptions" class="w-full px-4 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none bg-slate-50" required>
                        <option value="">-- Select Programme --</option>
                    </select>
                </div>
                <div class="md:col-span-2">
                    <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1">Session Joined</label>
                    <select asp-for="SessionJoined" asp-items="Model.SessionOptions" class="w-full px-4 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none bg-slate-50" required>
                        <option value="">-- Select Session --</option>
                    </select>
                </div>
                <div class="md:col-span-1">
                    <button type="submit" class="w-full bg-slate-800 hover:bg-slate-900 text-white font-bold py-2 px-4 rounded-lg shadow-md transition-all text-sm h-[38px]">
                        View
                    </button>
                </div>
            </form>
        </div>

        <div class="lg:col-span-1 bg-orange-50 rounded-xl border border-orange-200 p-6 shadow-inner flex flex-col justify-center">
            <div class="flex items-center gap-2 mb-3">
                <svg class="w-5 h-5 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                <h3 class="font-bold text-orange-900 text-sm">Action Required</h3>
            </div>
            
            <label class="block text-xs font-bold text-orange-800 mb-1">Cohorts Pending Setup:</label>
            <select onchange="if(this.value) window.location.href=this.value" class="w-full px-4 py-2 text-sm border border-orange-300 rounded-lg focus:ring-2 focus:ring-orange-500 outline-none bg-white text-slate-700">
                <option value="">-- Select an unset cohort --</option>
                @foreach (var unset in Model.UnsetCohorts)
                {
                    <option value="/Admin/Academic/Structure/Manage?ProgId=@unset.ProgrammeId&SessionJoined=@unset.SessionJoined">
                        @unset.ProgrammeCode (Session @unset.SessionJoined) - @unset.StudentCount Students
                    </option>
                }
            </select>
        </div>
    </div>

    @if (Model.HasSearched && Model.CurrentProgramme != null)
    {
        <div class="bg-white rounded-xl shadow-lg border border-slate-200 overflow-hidden mt-6 animate-fade-in-up">
            
            <div class="bg-slate-800 p-6 text-white flex flex-col md:flex-row justify-between md:items-center gap-4">
                <div>
                    <div class="flex items-center gap-3 mb-2">
                        <span class="bg-blue-600 text-white text-xs font-bold px-2 py-1 rounded">@Model.CurrentProgramme.Code</span>
                        <span class="border border-slate-500 text-slate-300 text-xs font-bold px-2 py-1 rounded">Session @Model.SessionJoined</span>
                    </div>
                    <h2 class="text-xl font-bold">@Model.CurrentProgramme.Name</h2>
                </div>
                
                @if (Model.IsConfigured)
                {
                    <a href="/Admin/Academic/Structure/Manage?ProgId=@Model.ProgId&SessionJoined=@Model.SessionJoined" class="bg-blue-600 hover:bg-blue-500 text-white font-bold py-2 px-5 rounded-lg shadow-md transition-all flex items-center justify-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
                        Update Programme Structure
                    </a>
                }
                else
                {
                    <a href="/Admin/Academic/Structure/Manage?ProgId=@Model.ProgId&SessionJoined=@Model.SessionJoined" class="bg-green-600 hover:bg-green-500 text-white font-bold py-2 px-5 rounded-lg shadow-md transition-all flex items-center justify-center gap-2 animate-pulse">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                        Setup Programme Structure
                    </a>
                }
            </div>

            <div class="p-6">
                @if (!Model.IsConfigured)
                {
                    <div class="text-center py-12">
                        <i class="fa-solid fa-folder-open text-4xl text-slate-300 mb-3"></i>
                        <h3 class="text-lg font-bold text-slate-700">This has not been set.</h3>
                        <p class="text-slate-500 mt-1">Click the button above to begin mapping courses to this cohort.</p>
                    </div>
                }
                else
                {
                    <div class="space-y-10">
                        @foreach (var yearEntry in Model.OrganizedStructure)
                        {
                            int year = yearEntry.Key;
                            var semesters = yearEntry.Value;

                            <div class="relative">
                                <div class="absolute inset-0 flex items-center" aria-hidden="true">
                                    <div class="w-full border-t border-slate-200"></div>
                                </div>
                                <div class="relative flex justify-center">
                                    <span class="bg-white px-4 text-sm font-bold text-slate-500 uppercase tracking-widest bg-slate-50 border border-slate-200 rounded-full py-1">
                                        Year @year
                                    </span>
                                </div>
                            </div>

                            <div class="grid grid-cols-1 xl:grid-cols-3 gap-6 mt-6">
                                @foreach (var semEntry in semesters)
                                {
                                    int semester = semEntry.Key;
                                    var courses = semEntry.Value;
                                    int totalCredits = courses.Sum(c => c.Course?.CreditHours ?? 0);

                                    <div class="bg-slate-50 rounded-xl border border-slate-200 flex flex-col h-full shadow-sm">
                                        <div class="p-4 bg-slate-100 border-b border-slate-200 flex justify-between items-center rounded-t-xl">
                                            <span class="font-bold text-slate-700">Semester @semester</span>
                                            <span class="text-xs font-semibold px-2.5 py-1 rounded bg-white text-slate-600 border border-slate-200 shadow-sm">
                                                @totalCredits Credits
                                            </span>
                                        </div>

                                        <div class="p-4 flex-1 flex flex-col gap-2">
                                            @if (courses.Count > 0)
                                            {
                                                @foreach (var structure in courses)
                                                {
                                                    <div class="p-3 rounded-lg bg-white border border-slate-200 shadow-sm">
                                                        <div class="flex items-center gap-2 mb-1">
                                                            <span class="text-xs font-bold text-blue-700 bg-blue-50 px-1.5 py-0.5 rounded border border-blue-100">
                                                                @structure.Course?.Code
                                                            </span>
                                                            <span class="text-[10px] text-slate-400 font-medium bg-slate-100 px-1.5 py-0.5 rounded">@structure.Course?.CreditHours Cr</span>
                                                        </div>
                                                        <p class="text-sm text-slate-700 font-medium leading-tight">
                                                            @structure.Course?.Title
                                                        </p>
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <div class="flex-1 flex flex-col items-center justify-center text-slate-400 opacity-70 py-4">
                                                    <p class="text-xs italic">No courses mapped</p>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>