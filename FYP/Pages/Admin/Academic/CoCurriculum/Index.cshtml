@page
@model FYP.Pages.Admin.Academic.CoCurriculum.IndexModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Co-curriculum Management";
}

<div class="space-y-6">

    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold font-serif text-slate-800">Co-curriculum Settings</h1>
            <p class="text-sm text-slate-500 mt-1">Manage activities and set global registration dates.</p>
        </div>
        <a href="/Admin/Academic/CoCurriculum/Add" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2.5 px-6 rounded-xl shadow-md transition-all flex items-center">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
            Add Activity
        </a>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="p-4 bg-green-50 text-green-700 rounded-xl border border-green-200 flex items-center shadow-sm">
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            @Model.SuccessMessage
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="p-4 bg-red-50 text-red-700 rounded-xl border border-red-200 flex items-center shadow-sm">
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            @Model.ErrorMessage
        </div>
    }

    <div class="bg-indigo-50 rounded-xl border border-indigo-200 p-6 shadow-sm">
        <div class="flex items-center gap-2 mb-4">
            <i class="fa-solid fa-clock text-indigo-600"></i>
            <h3 class="font-bold text-indigo-900">Global Registration Window</h3>
        </div>
        <form method="post" asp-page-handler="SetDates" class="grid grid-cols-1 md:grid-cols-3 gap-4 items-end">
            <div>
                <label class="block text-xs font-bold text-indigo-800 uppercase tracking-wider mb-1">Start Date & Time</label>
                <input asp-for="GlobalStartDate" type="datetime-local" class="w-full px-4 py-2 border border-indigo-300 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none text-sm bg-white" />
            </div>
            <div>
                <label class="block text-xs font-bold text-indigo-800 uppercase tracking-wider mb-1">End Date & Time</label>
                <input asp-for="GlobalEndDate" type="datetime-local" class="w-full px-4 py-2 border border-indigo-300 rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none text-sm bg-white" />
            </div>
            <div>
                <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-4 rounded-lg shadow transition-colors text-sm h-[38px]">
                    Apply to All Activities
                </button>
            </div>
        </form>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead class="bg-slate-50 text-slate-500 border-b border-slate-200">
                    <tr>
                        <th class="px-6 py-4 font-semibold">Activity Info</th>
                        <th class="px-6 py-4 font-semibold">Schedule & Venue</th>
                        <th class="px-6 py-4 font-semibold">Capacity Status</th>
                        <th class="px-6 py-4 font-semibold text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (Model.Activities.Any())
                    {
                        @foreach (var item in Model.Activities)
                        {
                            <tr class="hover:bg-slate-50 transition-colors">
                                <td class="px-6 py-4">
                                    <p class="font-bold text-slate-800">@item.Name</p>
                                    <p class="text-xs text-slate-500 font-mono">@item.Code <span class="mx-1">•</span> @(item.Category ?? "General")</p>
                                </td>
                                <td class="px-6 py-4">
                                    <p class="text-slate-700 font-medium text-xs mb-1"><i class="fa-regular fa-clock mr-1 text-slate-400"></i>@(item.DayAndTimeRange ?? "TBA")</p>
                                    <p class="text-slate-500 text-xs"><i class="fa-solid fa-location-dot mr-1 text-slate-400"></i>@(item.Venue ?? "TBA")</p>
                                </td>
                                <td class="px-6 py-4">
                                    @if ((item.SeatAvailable ?? 0) <= 0)
                                    {
                                        <span class="inline-flex px-2 py-1 rounded text-xs font-bold bg-red-100 text-red-700">Full (0 / @item.MaxCapacity)</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex px-2 py-1 rounded text-xs font-bold bg-green-100 text-green-700">@item.SeatAvailable / @item.MaxCapacity Seats</span>
                                    }
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        <a href="/Admin/Academic/CoCurriculum/Manage?id=@item.Id" class="p-2 text-slate-500 hover:text-blue-600 hover:bg-blue-50 rounded-lg transition-all" title="Manage Roster & Details">
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                                        </a>
                                        <form method="post" asp-page-handler="Delete" onsubmit="return confirm('Delete this activity and drop all enrolled students?');" class="m-0 inline-block">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="p-2 text-slate-500 hover:text-red-600 hover:bg-red-50 rounded-lg transition-all" title="Delete">
                                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="px-6 py-12 text-center text-slate-500">
                                <i class="fa-solid fa-folder-open text-3xl mb-3 text-slate-300 block"></i>
                                No activities found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>