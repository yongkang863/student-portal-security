@page
@model FYP.Pages.Admin.Academic.CoCurriculum.ManageModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Manage Activity";
}

<link href="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/css/tom-select.css" rel="stylesheet">
<style>
    .ts-control { border-color: #cbd5e1 !important; border-radius: 0.5rem !important; padding: 0.5rem 0.75rem !important; font-size: 0.875rem !important; background-color: #fff !important; }
    .ts-control.focus { border-color: #3b82f6 !important; box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.5) !important; }
</style>

<div class="space-y-6 max-w-6xl mx-auto">

    <div class="flex justify-between items-end">
        <div>
            <h1 class="text-2xl font-bold font-serif text-slate-800">Manage Activity</h1>
            <p class="text-sm text-slate-500 mt-1">Update details and manage the student roster.</p>
        </div>
        <a href="/Admin/Academic/CoCurriculum/Index" class="text-sm font-medium text-slate-500 hover:text-blue-600 transition-colors">
            &larr; Back to Directory
        </a>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="p-4 bg-green-50 text-green-700 rounded-xl border border-green-200 flex items-center shadow-sm">
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            @Model.SuccessMessage
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="p-4 bg-red-50 text-red-700 rounded-xl border border-red-200 flex items-start shadow-sm">
            <svg class="w-5 h-5 mr-3 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <span class="text-sm font-medium">@Model.ErrorMessage</span>
        </div>
    }

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

        <div class="lg:col-span-1 space-y-6">
            <form method="post" asp-page-handler="UpdateDetails" class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
                <input type="hidden" asp-for="Id" />
                
                <div class="bg-slate-800 p-4 text-white">
                    <h3 class="font-bold">Activity Information</h3>
                </div>

                <div class="p-5 space-y-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Activity Code</label>
                        <input asp-for="UpdateInput.Code" maxlength="10" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none uppercase font-mono" />
                        <span asp-validation-for="UpdateInput.Code" class="text-[10px] text-red-500 block mt-1"></span>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Activity Name</label>
                        <input asp-for="UpdateInput.Name" maxlength="30" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none" />
                        <span asp-validation-for="UpdateInput.Name" class="text-[10px] text-red-500 block mt-1"></span>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Category</label>
                        <select asp-for="UpdateInput.Category" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none">
                            <option value="Sports & Recreation">Sports & Recreation</option>
                            <option value="Clubs & Societies">Clubs & Societies</option>
                            <option value="Uniformed Bodies">Uniformed Bodies</option>
                            <option value="Arts & Culture">Arts & Culture</option>
                        </select>
                        <span asp-validation-for="UpdateInput.Category" class="text-[10px] text-red-500 block mt-1"></span>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Schedule</label>
                        <input asp-for="UpdateInput.DayAndTimeRange" maxlength="40" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none" />
                        <span asp-validation-for="UpdateInput.DayAndTimeRange" class="text-[10px] text-red-500 block mt-1"></span>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Venue</label>
                        <input asp-for="UpdateInput.Venue" maxlength="30" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none" />
                        <span asp-validation-for="UpdateInput.Venue" class="text-[10px] text-red-500 block mt-1"></span>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Max Capacity</label>
                        <input asp-for="UpdateInput.MaxCapacity" type="number" class="w-full px-3 py-2 text-sm border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none" />
                        <span asp-validation-for="UpdateInput.MaxCapacity" class="text-[10px] text-red-500 block mt-1"></span>
                    </div>
                </div>

                <div class="px-5 py-3 bg-slate-50 border-t border-slate-200">
                    <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 rounded-lg shadow transition-all text-sm">Save Changes</button>
                </div>
            </form>
        </div>

        <div class="lg:col-span-2 space-y-6">
            
            <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
                <div class="p-5 border-b border-slate-200 bg-slate-50 flex items-center justify-between">
                    <div>
                        <h3 class="font-bold text-slate-800">Manual Enrollment</h3>
                        <p class="text-xs text-slate-500">Search for active students with no existing co-curriculum.</p>
                    </div>
                    <div class="text-right">
                        <span class="text-xs text-slate-500 uppercase tracking-widest font-bold">Seats</span>
                        <p class="text-lg font-bold text-blue-600 leading-none mt-0.5">@(Model.Activity.SeatAvailable) / @(Model.Activity.MaxCapacity)</p>
                    </div>
                </div>
                <div class="p-5">
                    <form method="post" asp-page-handler="EnrollStudent" class="flex flex-col sm:flex-row gap-3 items-start sm:items-center">
                        <input type="hidden" asp-for="Id" />
                        <div class="flex-1 w-full min-w-[300px]">
                            <select asp-for="NewStudentId" asp-items="Model.EligibleStudentsOptions" class="searchable-select w-full" required placeholder="Type ID or Name to search...">
                                <option value="">Search Student...</option>
                            </select>
                        </div>
                        <button type="submit" class="shrink-0 bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-5 rounded-lg shadow transition-all text-sm flex items-center gap-2" @(Model.Activity.SeatAvailable <= 0 ? "disabled" : "")>
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                            Enroll Student
                        </button>
                    </form>
                </div>
            </div>

            <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
                <div class="p-4 border-b border-slate-200 bg-slate-800 flex items-center justify-between">
                    <h3 class="font-bold text-white"><i class="fa-solid fa-users mr-2 text-blue-400"></i>Student Roster</h3>
                    
                    @if (Model.EnrolledStudents.Any())
                    {
                        <form method="post" asp-page-handler="RemoveAll" onsubmit="return confirm('WARNING: Are you absolutely sure you want to remove ALL students from this activity?');" class="m-0">
                            <input type="hidden" asp-for="Id" />
                            <button type="submit" class="bg-red-500 hover:bg-red-600 text-white text-xs font-bold py-1.5 px-3 rounded shadow transition-all flex items-center gap-1.5">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                Clear Roster
                            </button>
                        </form>
                    }
                </div>

                <div class="overflow-x-auto max-h-[500px] overflow-y-auto custom-scrollbar">
                    <table class="w-full text-left text-sm">
                        <thead class="bg-slate-50 text-slate-500 sticky top-0 border-b border-slate-200 z-10 shadow-sm">
                            <tr>
                                <th class="px-5 py-3 font-semibold">Student Info</th>
                                <th class="px-5 py-3 font-semibold">Programme</th>
                                <th class="px-5 py-3 font-semibold">Joined Date</th>
                                <th class="px-5 py-3 font-semibold text-right">Action</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            @if(Model.EnrolledStudents.Any())
                            {
                                @foreach (var student in Model.EnrolledStudents)
                                {
                                    <tr class="hover:bg-slate-50 transition-colors">
                                        <td class="px-5 py-3">
                                            <p class="font-bold text-slate-800">@student.FullName</p>
                                            <p class="text-xs text-slate-500 font-mono">@student.UserId</p>
                                        </td>
                                        <td class="px-5 py-3">
                                            <span class="inline-flex px-2 py-0.5 rounded text-xs font-bold bg-indigo-50 text-indigo-700 border border-indigo-100">@student.ProgrammeCode</span>
                                        </td>
                                        <td class="px-5 py-3 text-slate-500">
                                            @student.DateRegistered.ToString("dd MMM yyyy")
                                        </td>
                                        <td class="px-5 py-3 text-right">
                                            <form method="post" asp-page-handler="RemoveStudent" onsubmit="return confirm('Remove this student from the activity?');" class="m-0 inline-block">
                                                <input type="hidden" asp-for="Id" />
                                                <input type="hidden" name="enrollmentId" value="@student.EnrollmentId" />
                                                <button type="submit" class="p-1.5 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded transition-all" title="Remove Student">
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="px-6 py-12 text-center text-slate-500">
                                        <i class="fa-solid fa-users-slash text-3xl mb-3 text-slate-300 block"></i>
                                        No students enrolled yet.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.2.2/dist/js/tom-select.complete.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.searchable-select').forEach((el) => {
                new TomSelect(el, { 
                    create: false, 
                    sortField: { field: "text", direction: "asc" }, 
                    maxOptions: 100 
                });
            });
        });
    </script>
}