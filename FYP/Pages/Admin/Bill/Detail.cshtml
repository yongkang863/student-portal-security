@page
@model FYP.Pages.Admin.Bill.DetailsModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Bill Details";
}

<div class="max-w-7xl mx-auto space-y-6">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
            <div class="flex items-center gap-3 mb-1">
                <a href="/Admin/Bill/Index" class="text-slate-400 hover:text-blue-600 transition-colors">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                </a>
                <h1 class="text-2xl font-bold text-slate-800 tracking-tight">Batch Bill Details</h1>
            </div>
            <p class="text-sm text-slate-500 ml-9">Viewing students and managing late payments.</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 bg-green-50 text-green-700 rounded-xl border border-green-200 flex items-center">
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <div class="md:col-span-2 bg-white rounded-2xl shadow-sm border border-slate-200 p-6">
            <h2 class="text-lg font-bold text-slate-800 mb-4">Batch Overview</h2>
            <div class="space-y-4">
                <div class="flex justify-between border-b border-slate-100 pb-2">
                    <span class="text-slate-500">Bill Title</span>
                    <span class="font-bold text-slate-800">@Model.MainBill.Title</span>
                </div>
                <div class="flex justify-between border-b border-slate-100 pb-2">
                    <span class="text-slate-500">Amount</span>
                    <span class="font-bold text-blue-600">RM @Model.MainBill.Amount.ToString("0.00")</span>
                </div>
            </div>
        </div>

        <div class="md:col-span-2 bg-white rounded-2xl shadow-sm border border-slate-200 p-6 flex items-center justify-center">
            <div class="w-full grid grid-cols-3 gap-4 text-center">
                <div>
                    <p class="text-3xl font-black text-slate-800">@Model.TotalStudents</p>
                    <p class="text-xs text-slate-500 uppercase font-bold tracking-wider mt-1">Total</p>
                </div>
                <div>
                    <p class="text-3xl font-black text-green-600">@Model.TotalPaid</p>
                    <p class="text-xs text-slate-500 uppercase font-bold tracking-wider mt-1">Paid</p>
                </div>
                <div>
                    <p class="text-3xl font-black text-amber-500">@Model.TotalPending</p>
                    <p class="text-xs text-slate-500 uppercase font-bold tracking-wider mt-1">Unpaid</p>
                </div>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left">
                <thead class="text-xs text-slate-500 uppercase bg-slate-50 border-b border-slate-200">
                    <tr>
                        <th class="px-6 py-4 font-bold">#</th>
                        <th class="px-6 py-4 font-bold">Student ID</th>
                        <th class="px-6 py-4 font-bold">Name</th>
                        <th class="px-6 py-4 font-bold text-center">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @{
                        int counter = 1;
                    }
                    @foreach (var studentBill in Model.TargetedStudents)
                    {
                        var isOverdue = studentBill.DueDate < DateOnly.FromDateTime(DateTime.Now);
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-6 py-4 text-slate-500">@counter</td>
                            <td class="px-6 py-4 font-bold text-slate-700">@studentBill.User?.UserId</td>
                            <td class="px-6 py-4 font-medium text-slate-800">@studentBill.User?.FullName</td>
                            <td class="px-6 py-4 text-center">
                                @{
                                    string statusName = "Pending";
                                    string badgeClass = "bg-amber-100 text-amber-700 border-amber-200";

                                    if (studentBill.StatusId == 6)
                                    {
                                        statusName = "Paid";
                                        badgeClass = "bg-green-100 text-green-700 border-green-200";
                                    }
                                    else if (studentBill.StatusId == 7)
                                    {
                                        statusName = "Late Payment";
                                        badgeClass = "bg-red-100 text-red-700 border-red-200";
                                    }
                                    else if (isOverdue)
                                    {
                                        statusName = "Overdue";
                                        badgeClass = "bg-rose-100 text-rose-700 border-rose-300 animate-pulse";
                                    }
                                }

                                <div class="flex items-center justify-center gap-2">
                                    <span class="px-3 py-1 text-xs font-bold rounded-full border @badgeClass inline-block min-w-[100px]">
                                        @statusName
                                    </span>

                                    @if (isOverdue && studentBill.StatusId != 6 && studentBill.StatusId != 7)
                                    {
                                        <form method="post" asp-page-handler="ToggleStatus" class="inline">
                                            <input type="hidden" name="targetBillId" value="@studentBill.Id" />
                                            <input type="hidden" name="mainBillId" value="@Model.MainBill.Id" />
                                            <button type="submit" class="text-xs px-2 py-1 bg-rose-600 text-white hover:bg-rose-700 rounded border border-rose-700 transition-colors">
                                                Mark Late
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                        counter++;
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>