@page
@model FYP.Pages.Admin.Students.RegisterModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Register Student";
}

<div class="max-w-4xl mx-auto space-y-6">

    <div class="flex justify-between items-end">
        <div>
            <h1 class="text-2xl font-bold font-serif text-slate-800">Register New Student</h1>
            <p class="text-sm text-slate-500 mt-1">Create accounts and enroll students into academic programmes.</p>
        </div>
        <a href="/Admin/Students/Index" class="text-sm font-medium text-slate-500 hover:text-blue-600 hover:underline transition-colors">
            &larr; Back to Directory
        </a>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="p-4 bg-green-50 text-green-700 rounded-xl border border-green-200 flex items-center">
            <svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            @Model.SuccessMessage
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="p-4 bg-red-50 text-red-700 rounded-xl border border-red-200 flex items-start">
            <svg class="w-5 h-5 mr-3 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
            <div class="text-sm">
                @Html.Raw(Model.ErrorMessage)
            </div>
        </div>
    }

    @if (Model.PreviewList != null && Model.PreviewList.Count > 0)
    {
        <div class="bg-white rounded-xl shadow-lg border border-blue-200 overflow-hidden animate-fade-in">
            <div class="p-6 bg-blue-50 border-b border-blue-100 flex justify-between items-center">
                <div>
                    <h3 class="text-lg font-bold text-blue-900">Verify Data Import</h3>
                    <p class="text-sm text-blue-700">Please review the data below before creating student accounts.</p>
                </div>
                <span class="bg-blue-200 text-blue-800 text-xs font-bold px-3 py-1 rounded-full">@Model.PreviewList.Count records found</span>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead class="bg-white text-slate-500 border-b border-slate-200">
                        <tr>
                            <th class="px-6 py-3 font-semibold">Student ID</th>
                            <th class="px-6 py-3 font-semibold">Full Name</th>
                            <th class="px-6 py-3 font-semibold">IC Number</th>
                            <th class="px-6 py-3 font-semibold">Session</th>
                            <th class="px-6 py-3 font-semibold">Group</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var item in Model.PreviewList)
                        {
                            <tr class="hover:bg-slate-50">
                                <td class="px-6 py-3 font-mono text-slate-600">@item.UserId</td>
                                <td class="px-6 py-3 font-medium text-slate-800">@item.FullName</td>
                                <td class="px-6 py-3 text-slate-500">@item.IcNumber</td>
                                <td class="px-6 py-3 text-slate-500">@item.SessionJoined</td>
                                <td class="px-6 py-3 text-slate-500">@item.TutorialGroup</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="p-6 bg-slate-50 border-t border-slate-200 flex justify-end gap-3">
                <a href="/Admin/Students/Register" class="px-4 py-2 text-slate-600 hover:text-slate-800 font-medium">Cancel</a>

                <form method="post" asp-page-handler="Confirm">
                    <input type="hidden" asp-for="SerializedData" />
                    <button type="submit" class="bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-6 rounded-lg shadow-md flex items-center gap-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        Confirm & Create Accounts
                    </button>
                </form>
            </div>
        </div>
    }
    else
    {
        <div x-data="{ tab: 'manual' }" class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">

            <div class="flex border-b border-slate-200 bg-slate-50">
                <button @@click="tab = 'manual'"
                    :class="tab === 'manual' ? 'bg-white text-blue-600 border-b-2 border-blue-600' : 'text-slate-500 hover:text-slate-700'"
                    class="flex-1 py-4 font-semibold text-sm transition-all outline-none">
                    Manual Entry
                </button>
                <button @@click="tab = 'upload'"
                    :class="tab === 'upload' ? 'bg-white text-blue-600 border-b-2 border-blue-600' : 'text-slate-500 hover:text-slate-700'"
                    class="flex-1 py-4 font-semibold text-sm transition-all outline-none">
                    Upload Google Sheet (CSV)
                </button>
            </div>

            <div class="p-8">

                <form method="post" enctype="multipart/form-data" x-show="tab === 'manual'" class="space-y-6 animate-fade-in">
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        
                        <div>
                            <label class="block text-sm font-bold text-slate-700 mb-1">Student ID</label>
                            <input asp-for="Input.UserId" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none font-mono" placeholder="e.g. 00AAA00000" />
                            <span asp-validation-for="Input.UserId" class="text-xs text-red-500 mt-1 block"></span>
                        </div>

                        <div>
                            <label class="block text-sm font-bold text-slate-700 mb-1">Full Name</label>
                            <input asp-for="Input.FullName" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none" placeholder="Enter full name" />
                            <span asp-validation-for="Input.FullName" class="text-xs text-red-500 mt-1 block"></span>
                        </div>

                        <div>
                            <label class="block text-sm font-bold text-slate-700 mb-1">Email Address</label>
                            <input asp-for="Input.Email" type="email" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none" placeholder="student@example.com" />
                            <span asp-validation-for="Input.Email" class="text-xs text-red-500 mt-1 block"></span>
                        </div>

                        <div>
                            <label class="block text-sm font-bold text-slate-700 mb-1">IC Number (Default Password)</label>
                            <input asp-for="Input.IcNumber" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none" placeholder="xxxxxx-xx-xxxx" />
                            <span asp-validation-for="Input.IcNumber" class="text-xs text-red-500 mt-1 block"></span>
                        </div>
                        
                        <div class="md:col-span-2">
                            <label class="block text-sm font-bold text-slate-700 mb-1">Home Address</label>
                            <textarea asp-for="Input.Address" rows="2" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none" placeholder="Enter home address"></textarea>
                            <span asp-validation-for="Input.Address" class="text-xs text-red-500 mt-1 block"></span>
                        </div>
                    </div>

                    <div class="pt-6 border-t border-slate-100">
                        <h3 class="text-sm font-bold text-slate-400 uppercase tracking-wider mb-4">Academic Details</h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            
                            <div class="md:col-span-1">
                                <label class="block text-sm font-bold text-slate-700 mb-1">Department</label>
                                <select asp-for="Input.DepartmentId" asp-items="Model.DepartmentOptions" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none">
                                    <option value="">Select Department...</option>
                                </select>
                                <span asp-validation-for="Input.DepartmentId" class="text-xs text-red-500 mt-1 block"></span>
                            </div>

                            <div class="md:col-span-1">
                                <label class="block text-sm font-bold text-slate-700 mb-1">Enrolled Programme</label>
                                <select asp-for="Input.ProgrammeId" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none">
                                    <option value="">Select Programme...</option>
                                </select>
                                <span asp-validation-for="Input.ProgrammeId" class="text-xs text-red-500 mt-1 block"></span>
                            </div>

                            <div>
                                <label class="block text-sm font-bold text-slate-700 mb-1">Session Joined (YYYYMM)</label>
                                <input asp-for="Input.SessionJoined" type="number" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none" placeholder="e.g. 202401" />
                                <span asp-validation-for="Input.SessionJoined" class="text-xs text-red-500 mt-1 block"></span>
                            </div>

                            <div>
                                <label class="block text-sm font-bold text-slate-700 mb-1">Intake Year</label>
                                <input asp-for="Input.IntakeYear" type="number" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none" placeholder="e.g. 2024" />
                                <span asp-validation-for="Input.IntakeYear" class="text-xs text-red-500 mt-1 block"></span>
                            </div>

                            <div>
                                <label class="block text-sm font-bold text-slate-700 mb-1">Year Level</label>
                                <input asp-for="Input.YearLevel" type="number" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none" />
                                <span asp-validation-for="Input.YearLevel" class="text-xs text-red-500 mt-1 block"></span>
                            </div>

                            <div>
                                <label class="block text-sm font-bold text-slate-700 mb-1">Semester</label>
                                <input asp-for="Input.Semester" type="number" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none" />
                                <span asp-validation-for="Input.Semester" class="text-xs text-red-500 mt-1 block"></span>
                            </div>
                            
                            <div>
                                <label class="block text-sm font-bold text-slate-700 mb-1">Tutorial Group</label>
                                <input asp-for="Input.TutorialGroup" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none" placeholder="e.g. G1" />
                                <span asp-validation-for="Input.TutorialGroup" class="text-xs text-red-500 mt-1 block"></span>
                            </div>

                            <div>
                                <label class="block text-sm font-bold text-slate-700 mb-1">Study Status</label>
                                <select asp-for="Input.StudyStatus" asp-items="Model.StatusOptions" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none">
                                    <option value="">Select Status...</option>
                                </select>
                                <span asp-validation-for="Input.StudyStatus" class="text-xs text-red-500 mt-1 block"></span>
                            </div>
                        </div>
                    </div>

                    <div class="pt-6 border-t border-slate-100">
                        <h3 class="text-sm font-bold text-slate-400 uppercase tracking-wider mb-4">Contact & Banking (Optional)</h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <label class="block text-sm font-bold text-slate-700 mb-1">Contact Number</label>
                                <input asp-for="Input.ContactNo" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none" placeholder="e.g. 0123456789" />
                                <span asp-validation-for="Input.ContactNo" class="text-xs text-red-500 mt-1 block"></span>
                            </div>

                            <div>
                                <label class="block text-sm font-bold text-slate-700 mb-1">Emergency Contact</label>
                                <input asp-for="Input.EmergencyContact" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none" placeholder="e.g. 0123456789" />
                                <span asp-validation-for="Input.EmergencyContact" class="text-xs text-red-500 mt-1 block"></span>
                            </div>

                            <div>
                                <label class="block text-sm font-bold text-slate-700 mb-1">Bank</label>
                                <select asp-for="Input.BankId" asp-items="Model.BankOptions" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none">
                                    <option value="">Select Bank...</option>
                                </select>
                                <span asp-validation-for="Input.BankId" class="text-xs text-red-500 mt-1 block"></span>
                            </div>

                            <div>
                                <label class="block text-sm font-bold text-slate-700 mb-1">Account Number</label>
                                <input asp-for="Input.BankAccNo" oninput="this.value = this.value.replace(/[^0-9]/g, '');" maxlength="10" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none" placeholder="10 digits" />
                                <span asp-validation-for="Input.BankAccNo" class="text-xs text-red-500 mt-1 block"></span>
                            </div>
                        </div>
                    </div>

                    <div class="pt-6 border-t border-slate-100">
                        <div>
                            <label class="block text-sm font-bold text-slate-700 mb-1">Profile Picture (Optional)</label>
                            <input asp-for="Input.ProfilePicture" type="file" accept=".jpg,.jpeg,.png" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none bg-white file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" />
                            <p class="text-xs text-slate-500 mt-1">Max size: 2MB. Allowed formats: PNG, JPG, JPEG.</p>
                            <span asp-validation-for="Input.ProfilePicture" class="text-xs text-red-500 mt-1 block"></span>
                        </div>
                    </div>

                    <div class="pt-4 border-t border-slate-100 flex justify-end">
                        <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2.5 px-6 rounded-lg shadow-md transition-all">
                            Register Student
                        </button>
                    </div>
                </form>

                <form method="post" enctype="multipart/form-data" asp-page-handler="Upload" x-show="tab === 'upload'" style="display: none;">
                    <div class="text-center p-8 border-2 border-dashed border-slate-300 rounded-xl bg-slate-50 hover:bg-slate-100 transition-colors relative">
                        <svg class="mx-auto h-12 w-12 text-slate-400" stroke="currentColor" fill="none" viewBox="0 0 48 48">
                            <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>

                        <div class="mt-4 flex text-sm text-slate-600 justify-center">
                            <label class="relative cursor-pointer rounded-md bg-white font-medium text-blue-600 focus-within:outline-none focus-within:ring-2 focus-within:ring-blue-500 focus-within:ring-offset-2 hover:text-blue-500">
                                <span id="file-label">Upload a file</span>
                                <input asp-for="UploadFile" type="file" class="sr-only" accept=".csv" onchange="updateFileName(this)">
                                </label>
                                <p class="pl-1">or drag and drop</p>
                            </div>
                            <p class="text-xs text-slate-500 mt-2" id="file-name-display">CSV files only (Export from Google Sheets or Excel)</p>
                        </div>

                        <div class="mt-6 bg-blue-50 p-5 rounded-xl border border-blue-100">
                            <div class="flex flex-col lg:flex-row justify-between lg:items-start gap-5">
                                <div class="flex-1">
                                    <p class="font-bold text-blue-900 mb-2">Required CSV Format & Validations:</p>
                                
                                    <code class="bg-white px-3 py-2 rounded-lg border border-blue-200 block text-xs text-slate-700 break-all whitespace-normal leading-relaxed">
                                        StudentID,FullName,Email,ICNumber,HomeAddress,DepartmentID,ProgrammeID,SessionJoined,IntakeYear,YearLevel,Semester,TutorialGroup,StudyStatus,ContactNo,EmergencyContact
                                    </code>
                                
                                    <p class="mt-3 text-xs text-blue-800">
                                        All uploaded rows will pass through the same strict validations as the manual entry form (e.g., Session formatted as YYYYMM). If any row fails, the entire file is rejected to preserve data integrity.
                                    </p>
                                </div>
                            
                                <div class="shrink-0 pt-1">
                                    <a href="?handler=DownloadTemplate" class="inline-flex items-center justify-center gap-2 bg-white text-blue-700 border border-blue-200 hover:bg-blue-100 hover:border-blue-300 font-bold py-2.5 px-4 rounded-lg text-sm shadow-sm transition-all w-full">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
                                        Download Template
                                    </a>
                                </div>
                            </div>
                        </div>

                        <div class="mt-6 flex justify-end">
                            <button type="submit" class="bg-green-600 hover:bg-green-700 text-white font-bold py-2.5 px-6 rounded-lg shadow-md transition-all flex items-center">
                                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
                                Upload & Preview
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        }
    </div>

    @section Scripts {
        <script src="//unpkg.com/alpinejs" defer></script>
        <script>
            function updateFileName(input) {
            if (input.files && input.files.length > 0) {
            const fileName = input.files[0].name;
            document.getElementById('file-label').innerText = "Change file";
            document.getElementById('file-name-display').innerText = "Selected: " + fileName;
            document.getElementById('file-name-display').classList.add("text-blue-600", "font-bold");
            }
            }

            document.addEventListener('DOMContentLoaded', function() {
            const programmesStr = '@Html.Raw(Model.ProgrammesJson)';
            if(!programmesStr) return;

            const programmes = JSON.parse(programmesStr);
            const deptSelect = document.getElementById('Input_DepartmentId');
            const progSelect = document.getElementById('Input_ProgrammeId');
            
            const currentProgId = '@(Model.Input.ProgrammeId?.ToString() ?? "")';

            function updateProgrammes() {
            const deptId = deptSelect.value;
            progSelect.innerHTML = '<option value="">Select Programme...</option>';
                
            if (deptId) {
            const filtered = programmes.filter(p => p.departmentId == deptId);
            filtered.forEach(p => {
            const opt = document.createElement('option');
            opt.value = p.id;
            opt.text = p.name;
            if (p.id == currentProgId) {
            opt.selected = true;
            }
            progSelect.add(opt);
            });
            }
            }

            if(deptSelect) {
            deptSelect.addEventListener('change', updateProgrammes);
            updateProgrammes();
            }
            });
        </script>
    }