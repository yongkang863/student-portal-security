@page
@model FYP.Pages.Admin.BookingsModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Manage Bookings";
}

<div class="max-w-7xl mx-auto py-8">

    <div class="flex justify-between items-center mb-8 bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
        <div>
            <h2 class="text-2xl font-extrabold text-slate-800">Pending Bookings</h2>
            <p class="text-slate-500 text-sm mt-1">Review and manage student facility requests.</p>
        </div>
        <div class="p-3 bg-purple-50 text-purple-600 rounded-xl">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mb-6 p-4 bg-green-50 border border-green-200 text-green-700 rounded-xl flex items-center gap-3">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            <span class="font-semibold">@TempData["SuccessMessage"]</span>
        </div>
    }

    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
        @if (Model.PendingBookings.Any())
        {
            <div class="overflow-x-auto">
                <table class="w-full text-sm text-left">
                    <thead class="bg-slate-50 text-slate-500">
                        <tr>
                            <th class="px-6 py-4 font-semibold">Student Info</th>
                            <th class="px-6 py-4 font-semibold">Facility</th>
                            <th class="px-6 py-4 font-semibold">Date & Time</th>
                            <th class="px-6 py-4 font-semibold text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var booking in Model.PendingBookings)
                        {
                            <tr class="hover:bg-slate-50 transition-colors">
                                <td class="px-6 py-4">
                                    <div class="font-bold text-slate-800">@(booking.Student?.FullName ?? "Unknown")</div>
                                    <div class="text-xs text-slate-500 mt-0.5">ID: @booking.StudentId</div>
                                </td>

                                <td class="px-6 py-4">
                                    <span class="inline-block px-2 py-1 bg-purple-50 text-purple-700 text-[10px] font-bold uppercase tracking-wider rounded border border-purple-100">
                                        @(booking.Facility?.Name ?? "Unknown")
                                    </span>
                                </td>

                                <td class="px-6 py-4">
                                    <div class="font-medium text-slate-700">@booking.BookingDate</div>
                                    <div class="text-xs text-slate-500 mt-0.5">@booking.TimeSlot.ToString("hh:mm tt")</div>
                                </td>

                                <td class="px-6 py-4 text-right">
                                    <div class="flex justify-end gap-2">
                                        <form method="post" asp-page-handler="Approve" asp-route-id="@booking.Id">
                                            <button type="submit" class="px-4 py-2 bg-green-50 hover:bg-green-600 hover:text-white text-green-700 font-bold rounded-lg transition-colors border border-green-200 hover:border-green-600 flex items-center gap-1">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                                                Approve
                                            </button>
                                        </form>

                                        <button type="button" onclick="openRejectModal(@booking.Id)" class="px-4 py-2 bg-red-50 hover:bg-red-600 hover:text-white text-red-700 font-bold rounded-lg transition-colors border border-red-200 hover:border-red-600 flex items-center gap-1">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                                            Reject
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-12 text-center">
                <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-slate-50 text-slate-300 mb-4">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path></svg>
                </div>
                <h3 class="text-lg font-bold text-slate-700">All Caught Up!</h3>
                <p class="text-slate-500 mt-1">There are currently no pending facility booking requests.</p>
            </div>
        }
    </div>
</div>

<div id="rejectModal" class="fixed inset-0 bg-slate-900 bg-opacity-50 hidden items-center justify-center z-50">
    <div class="bg-white rounded-2xl shadow-xl w-full max-w-md mx-4 overflow-hidden">
        <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center">
            <h3 class="text-lg font-bold text-slate-800">Reject Booking</h3>
            <button onclick="closeRejectModal()" class="text-slate-400 hover:text-slate-600 transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>

        <form method="post" asp-page-handler="Reject">
            <div class="px-6 py-4">
                <input type="hidden" id="rejectBookingId" name="id" value="" />

                <label for="remark" class="block text-sm font-medium text-slate-700 mb-2">Reason for Rejection</label>
                <textarea id="remark" name="remark" rows="3" required class="w-full rounded-lg border-slate-300 border p-3 text-sm focus:ring-red-500 focus:border-red-500 outline-none transition-colors" placeholder="e.g., The facility is under maintenance on this date..."></textarea>
                <p class="text-xs text-slate-500 mt-2">This remark will be included in the email sent to the student.</p>
            </div>
            <div class="px-6 py-4 bg-slate-50 border-t border-slate-100 flex justify-end gap-3">
                <button type="button" onclick="closeRejectModal()" class="px-4 py-2 text-slate-600 font-medium hover:bg-slate-200 rounded-lg transition-colors">Cancel</button>
                <button type="submit" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white font-bold rounded-lg transition-colors">Confirm Rejection</button>
            </div>
        </form>
    </div>
</div>

<script>
    function openRejectModal(id) {
        document.getElementById('rejectBookingId').value = id;
        const modal = document.getElementById('rejectModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
    }

    function closeRejectModal() {
        const modal = document.getElementById('rejectModal');
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.getElementById('remark').value = '';
    }
</script>