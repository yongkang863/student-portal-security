@page
@model FYP.Pages.Admin.LeaveDetailModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Leave Request Details";
}

<div class="max-w-6xl mx-auto py-8">

    <div class="mb-8 flex items-center gap-4">
        <a href="/Admin/Leaves" class="flex items-center justify-center w-10 h-10 rounded-xl bg-white border border-slate-200 text-slate-500 hover:text-blue-600 hover:border-blue-200 hover:bg-blue-50 transition-all" title="Back to List">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        </a>
        <div>
            <h2 class="text-2xl font-extrabold text-slate-800">Review Application</h2>
            <p class="text-slate-500 text-sm mt-1">Detailed view of the student's absence request.</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mb-6 p-4 bg-green-50 border border-green-200 text-green-700 rounded-xl flex items-center gap-3">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            <span class="font-semibold">@TempData["SuccessMessage"]</span>
        </div>
    }

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

        <div class="md:col-span-1 space-y-6">
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 text-center flex flex-col items-center">

                <div class="w-24 h-24 rounded-full border-4 border-slate-100 shadow-inner overflow-hidden mb-4 bg-slate-50 flex items-center justify-center text-slate-300">
                    @if (!string.IsNullOrEmpty(Model.StudentPhotoBase64))
                    {
                        <img src="@Model.StudentPhotoBase64" alt="Student Profile" class="w-full h-full object-cover" />
                    }
                    else
                    {
                        <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                    }
                </div>

                <h3 class="text-lg font-extrabold text-slate-800">@(Model.LeaveRequest.Student?.FullName ?? "Unknown Student")</h3>
                <p class="text-sm text-slate-500 mb-1">Student ID: @(Model.LeaveRequest.Student?.UserId ?? "N/A")</p>
                <span class="inline-block px-3 py-1 bg-blue-50 text-blue-700 text-xs font-bold rounded-full border border-blue-100 mt-2">Active Student</span>
            </div>

            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6">
                <h4 class="text-sm font-bold text-slate-700 uppercase tracking-wider mb-4 border-b border-slate-100 pb-2">Dates Summary</h4>

                <div class="space-y-4">
                    <div class="flex items-center gap-3 p-3 bg-slate-50 rounded-xl">
                        <svg class="w-8 h-8 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                        <div>
                            <p class="text-[10px] text-slate-400 font-medium uppercase tracking-widest">Start Date</p>
                            <p class="text-base font-bold text-slate-700">@Model.LeaveRequest.StartDate.ToString("dd MMMM yyyy")</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-3 p-3 bg-slate-50 rounded-xl">
                        <svg class="w-8 h-8 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                        <div>
                            <p class="text-[10px] text-slate-400 font-medium uppercase tracking-widest">End Date</p>
                            <p class="text-base font-bold text-slate-700">@Model.LeaveRequest.EndDate.ToString("dd MMMM yyyy")</p>
                        </div>
                    </div>
                    <div class="text-center bg-blue-600 p-4 rounded-xl text-white shadow-lg shadow-blue-500/20">
                        <p class="text-xs font-bold uppercase tracking-wider opacity-70">Total Absence</p>
                        <p class="text-3xl font-extrabold my-1">@Model.LeaveRequest.LeaveTotal</p>
                        <p class="text-xs font-medium">Days (inclusive)</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="md:col-span-2 space-y-6 flex flex-col">

            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 flex-1">
                <div class="flex justify-between items-start mb-6">
                    <div>
                        <p class="text-xs font-bold text-slate-400 uppercase tracking-widest">Application Type</p>
                        <h3 class="text-xl font-bold text-slate-800 mt-1">@Model.LeaveRequest.LeaveType Leave</h3>
                    </div>
                    <span class="inline-block px-3 py-1.5 text-xs font-bold rounded-full shadow-inner @(Model.LeaveRequest.Status?.StatusName == "Pending" ? "bg-amber-100 text-amber-700 border border-amber-200" : "bg-slate-100 text-slate-600 border border-slate-200")">
                        @(Model.LeaveRequest.Status?.StatusName ?? "Unknown")
                    </span>
                </div>

                <div class="mb-8">
                    <p class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-3">Reason for Absence</p>
                    <div class="bg-slate-50 rounded-xl p-4 border border-slate-100 text-slate-700 text-sm leading-relaxed whitespace-pre-line">
                        @(string.IsNullOrEmpty(Model.LeaveRequest.Reason) ? "No reason provided." : Model.LeaveRequest.Reason)
                    </div>
                </div>

                <div>
                    <p class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-3">Supporting Document</p>
                    @if (!string.IsNullOrEmpty(Model.LeaveRequest.Document))
                    {
                        <div class="flex items-center gap-4 bg-slate-50 p-4 rounded-xl border border-slate-100">
                            <svg class="w-10 h-10 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                            <div class="flex-1">
                                <p class="text-sm font-semibold text-slate-800">Application Proof</p>
                                <p class="text-xs text-slate-400 mt-0.5">Medical Certificate / Official Letter</p>
                            </div>
                            <a href="@Model.LeaveRequest.Document" target="_blank" class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-lg transition-colors text-xs flex items-center gap-1 shadow-md shadow-blue-500/20">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                                View File
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="text-center bg-slate-50 p-6 rounded-xl border border-dashed border-slate-200">
                            <svg class="w-8 h-8 mx-auto text-slate-300 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                            <p class="text-sm text-slate-400 italic">No document uploaded with this request.</p>
                        </div>
                    }
                </div>
            </div>

            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6">
                <p class="text-xs font-bold text-slate-400 uppercase tracking-widest text-center mb-4">Process Application</p>
                <div class="flex justify-center gap-4">
                    <form method="post" asp-page="/Admin/LeaveDetail" asp-page-handler="Approve" asp-route-id="@Model.LeaveRequest.Id" class="inline flex-1">
                        <button type="submit" class="w-full flex justify-center py-3.5 px-6 bg-green-50 hover:bg-green-600 hover:text-white text-green-700 font-bold rounded-xl transition-colors border border-green-200 hover:border-green-600 flex items-center gap-2 shadow-sm">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                            Approve Leave
                        </button>
                    </form>

                    <form method="post" asp-page="/Admin/LeaveDetail" asp-page-handler="Reject" asp-route-id="@Model.LeaveRequest.Id" class="inline flex-1">
                        <button type="submit" class="w-full flex justify-center py-3.5 px-6 bg-red-50 hover:bg-red-600 hover:text-white text-red-700 font-bold rounded-xl transition-colors border border-red-200 hover:border-red-600 flex items-center gap-2 shadow-sm">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                            Reject Leave
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>