@page
@model FYP.Pages.Admin.Staff.EditModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Edit Staff Profile";
}

<div class="max-w-3xl mx-auto">

    <div class="mb-6 flex justify-between items-end">
        <div>
            <h1 class="text-2xl font-bold font-serif text-slate-800">Edit Profile</h1>
            <p class="text-sm text-slate-500">Update staff details and permissions.</p>
        </div>
        <a href="/Admin/Staff/Index" class="text-sm font-medium text-slate-500 hover:text-blue-600 hover:underline transition-colors">
            &larr; Back to Directory
        </a>
    </div>

    <form method="post" enctype="multipart/form-data" class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">

        <div class="p-8 space-y-6">

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-bold text-slate-700 mb-1">Staff ID</label>
                    <input asp-for="Input.UserId" readonly class="w-full px-4 py-2 border border-slate-300 rounded-lg bg-slate-100 text-slate-500 font-mono focus:outline-none" />
                    <span asp-validation-for="Input.UserId" class="text-xs text-red-500 mt-1 block"></span>
                </div>

                <div>
                    <label class="block text-sm font-bold text-slate-700 mb-1">Assign Role</label>
                    <select asp-for="Input.RoleId" asp-items="Model.RoleOptions" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none">
                        <option value="">Select Role...</option>
                    </select>
                    <span asp-validation-for="Input.RoleId" class="text-xs text-red-500 mt-1 block"></span>
                </div>

                <div>
                    <label class="block text-sm font-bold text-slate-700 mb-1">Full Name</label>
                    <input asp-for="Input.FullName" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none" placeholder="Enter full name (Alphabets only)" />
                    <span asp-validation-for="Input.FullName" class="text-xs text-red-500 mt-1 block"></span>
                </div>

                <div>
                    <label class="block text-sm font-bold text-slate-700 mb-1">Email Address</label>
                    <input asp-for="Input.Email" type="email" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none" placeholder="staff@gmail.com or rocket.com" />
                    <span asp-validation-for="Input.Email" class="text-xs text-red-500 mt-1 block"></span>
                </div>

                <div>
                    <label class="block text-sm font-bold text-slate-700 mb-1">IC Number</label>
                    <input asp-for="Input.IcNumber" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none" placeholder="xxxxxx-xx-xxxx" />
                    <span asp-validation-for="Input.IcNumber" class="text-xs text-red-500 mt-1 block"></span>
                </div>

                <div>
                    <label class="block text-sm font-bold text-slate-700 mb-1">Department</label>
                    <select asp-for="Input.DepartmentId" asp-items="Model.DepartmentOptions" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none">
                        <option value="">Select Department...</option>
                    </select>
                    <span asp-validation-for="Input.DepartmentId" class="text-xs text-red-500 mt-1 block"></span>
                </div>
            </div>

            <div class="pt-6 border-t border-slate-100">
                <h3 class="text-sm font-bold text-slate-400 uppercase tracking-wider mb-4">Contact & Banking</h3>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-1">Contact Number</label>
                        <input asp-for="Input.ContactNo" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none" placeholder="0000000000" />
                        <span asp-validation-for="Input.ContactNo" class="text-xs text-red-500 mt-1 block"></span>
                    </div>

                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-1">Emergency Contact</label>
                        <input asp-for="Input.EmergencyContact" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none" placeholder="0000000000" />
                        <span asp-validation-for="Input.EmergencyContact" class="text-xs text-red-500 mt-1 block"></span>
                    </div>

                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-1">Bank</label>
                        <select asp-for="Input.BankId" asp-items="Model.BankOptions" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none">
                            <option value="">Select Bank...</option>
                        </select>
                        <span asp-validation-for="Input.BankId" class="text-xs text-red-500 mt-1 block"></span>
                    </div>

                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-1">Account Number</label>
                        <input asp-for="Input.BankAccNo" oninput="this.value = this.value.replace(/[^0-9]/g, '');" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none" placeholder="Numbers only" />
                        <span asp-validation-for="Input.BankAccNo" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                </div>
            </div>

            <div class="pt-6 border-t border-slate-100">
                <h3 class="text-sm font-bold text-slate-400 uppercase tracking-wider mb-4">Academic & Profile</h3>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div x-data="courseSelector()" class="md:col-span-1">
                        <label class="block text-sm font-bold text-slate-700 mb-1">Teaching Courses</label>

                        <select @@change="addCourse($event)" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none mb-2">
                            <option value="">Select a course to add...</option>
                            @foreach (var c in Model.CourseOptions)
                            {
                                <option value="@c.Value">@c.Text</option>
                            }
                        </select>

                        <div class="flex flex-wrap gap-2">
                            <template x-for="course in selectedCourses" :key="course.id">
                                <span class="inline-flex items-center px-3 py-1 bg-blue-100 text-blue-800 text-xs font-semibold rounded-full border border-blue-200 shadow-sm">
                                    <span x-text="course.text"></span>
                                    <button type="button" @@click="removeCourse(course.id)" class="ml-2 text-red-500 hover:text-red-700 focus:outline-none">
                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12"></path></svg>
                                    </button>
                                    <input type="hidden" name="Input.CourseIds" :value="course.id" />
                                </span>
                            </template>
                        </div>
                        <span asp-validation-for="Input.CourseIds" class="text-xs text-red-500 mt-1 block"></span>
                    </div>

                    <div class="flex flex-col justify-center mt-6">
                        <div class="flex items-center">
                            <input asp-for="Input.IsAdvisor" type="checkbox" class="w-5 h-5 text-blue-600 bg-slate-100 border-slate-300 rounded focus:ring-blue-500 focus:ring-2">
                            <label for="Input_IsAdvisor" class="ml-2 text-sm font-bold text-slate-700">Assign as Advisor</label>
                        </div>
                    </div>

                    <div class="md:col-span-2">
                        <label class="block text-sm font-bold text-slate-700 mb-1">Update Profile Picture</label>
                        <input asp-for="Input.ProfilePicture" type="file" accept=".jpg,.jpeg,.png" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none bg-white file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" />
                        <p class="text-xs text-slate-500 mt-1">Leave blank to keep current picture. Recommended: Square image (150x150 pixels). Max size: 2MB. Allowed formats: PNG, JPG, JPEG.</p>
                        <span asp-validation-for="Input.ProfilePicture" class="text-xs text-red-500 mt-1 block"></span>
                    </div>
                </div>
            </div>

            <div class="mt-8 pt-8 border-t border-slate-100">
                <h3 class="text-md font-bold text-slate-800 mb-4">Security</h3>
                <div>
                    <label class="block text-sm font-bold text-slate-700 mb-1">Reset Password</label>
                    <input asp-for="Input.NewPassword" type="password" placeholder="Leave blank to keep current password" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 outline-none" />
                    <p class="text-xs text-slate-400 mt-1">Only fill this if the user needs a password reset.</p>
                </div>
            </div>

        </div>

        <div class="px-8 py-4 bg-slate-50 border-t border-slate-200 flex justify-end gap-3">
            <a href="/Admin/Staff/Index" class="px-4 py-2 text-slate-600 font-bold hover:bg-slate-200 rounded-lg transition-colors">Cancel</a>
            <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-6 rounded-lg shadow-md transition-all flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                Save Changes
            </button>
        </div>

    </form>
</div>

<script src="//unpkg.com/alpinejs" defer></script>
<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('courseSelector', () => ({
          
            selectedCourses: @Html.Raw(ViewData["ExistingCoursesJson"] ?? "[]"),

            addCourse(e) {
                const select = e.target;
                const id = select.value;
                const text = select.options[select.selectedIndex].text;

                if (id !== "" && !this.selectedCourses.some(c => c.id === id)) {
                    this.selectedCourses.push({ id, text });
                }

                select.value = "";
            },

            removeCourse(id) {
                this.selectedCourses = this.selectedCourses.filter(c => c.id !== id);
            }
        }))
    })
</script>